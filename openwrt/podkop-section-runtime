#!/bin/sh
# Multi-section workers. Bootstrap is structural; scoped apply never touches frontend.
set -eu
umask 077
ROOT="${PODKOP_SECTION_ROOT:-/etc/podkop/section-runtime}"
SINGLE_HELPER="${PODKOP_SINGLE_MANAGER:-$(dirname "$0")/podkop-single-runtime}"
if [ "${1:-}" = single-migrate ]; then exec "$SINGLE_HELPER" "$@"; fi
if [ "${PODKOP_SECTION_MODE:-$(cat "$ROOT/runtime-mode" 2>/dev/null || true)}" = single ] ||
   { [ "${PODKOP_SECTION_MODE:-}" != split ] && jq -e '.mode=="single"' "$ROOT/metadata.json" >/dev/null 2>&1; } ||
   { [ "${1:-}" = bootstrap ] && [ ! -f "$ROOT/metadata.json" ] && [ "${PODKOP_SECTION_MODE:-}" != split ]; }; then
    exec "$SINGLE_HELPER" "$@"
fi
LOCK_PATH="${PODKOP_SECTION_LOCK:-}"
FRONTEND="${PODKOP_SECTION_FRONTEND_CONFIG:-/etc/sing-box/config.json}"
SING_BOX="${PODKOP_SECTION_SING_BOX:-/usr/bin/sing-box}"
INIT="${PODKOP_SECTION_INIT:-/etc/init.d/podkop-section-worker}"
WORK=""
PHASE=""
SWAPPED=0
COMMITTED=0
TARGET=""
error() { printf 'section_runtime: %s\n' "$1" >&2; return 1; }
finish() {
    set +e
    result="$1"
    trap - EXIT HUP INT TERM
    if [ "$SWAPPED" = 1 ] && [ "$COMMITTED" != 1 ]; then
        if [ "$PHASE" = bootstrap ]; then
            for file in workers frontend.json logical.json metadata.json; do
                rm -rf "$ROOT/$file"
                [ ! -e "$WORK/before/$file" ] || mv "$WORK/before/$file" "$ROOT/$file" || result=1
            done
        elif [ "$PHASE" = apply ]; then
            cp -p "$WORK/before-worker.json" "$ROOT/workers/$TARGET/worker.json" || result=1
            cp -p "$WORK/before-logical.json" "$ROOT/logical.json" || result=1
            if ! "$INIT" reload 9>&- >/dev/null 2>&1 || ! wait_ready "$TARGET" || ! peers_unchanged; then
                error rollback_not_ready
                result=1
            fi
        fi
    fi
    [ -z "$WORK" ] || rm -rf "$WORK"
    exit "$result"
}
trap 'finish $?' EXIT
trap 'exit 1' HUP INT TERM

split_one() (
    logical="$1" section="$2" port="$3" api="$4" output="$5"
    case "$section" in ''|*[!a-zA-Z0-9_]*) error invalid_section; return 1;; esac
    case "$port:$api" in *[!0-9:]*|:*) error invalid_ports; return 1;; esac
    [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] && [ "$api" -ge 1024 ] && [ "$api" -le 65535 ] && [ "$port" != "$api" ] || { error invalid_ports; return 1; }
    [ ! -e "$output" ] || { error output_exists; return 1; }
    staged="$(mktemp -d "${output}.tmp.XXXXXX")" || return 1
    if ! jq -e --arg s "$section" --argjson port "$port" --argjson api "$api" '
      def require($condition;$label): if $condition then . else error("section_graph/"+$label) end;
      def resolver_tag: if type=="string" then . elif type=="object" then .server // "" else "" end;
      def member_name:
        startswith($s+"-") and endswith("-out") and
        (.[(($s|length)+1):-4] as $number |
          ($number|length)>0 and all($number|explode[]; .>=48 and .<=57));
      def acyclic($edges;$node;$seen):
        if ($seen|index($node))!=null then false
        else all($edges[$node][]?; acyclic($edges;.;$seen+[$node])) end;
      . as $source |
      require(type=="object" and (.outbounds|type)=="array" and (.dns.servers|type)=="array";"schema") |
      [.outbounds[] | select(.tag | startswith($s+"-"))] as $selected |
      ($selected|map(.tag)) as $tags |
      [.outbounds[]|select(.type=="direct")|.tag] as $direct_tags |
      [.dns.servers[]|select(.type!="fakeip" and .address!="fakeip")] as $dns |
      ($dns|map(.tag)) as $dns_tags |
      ($selected|map({key:.tag,value:((.outbounds//[])+[.detour?|select(.!=null)])})|from_entries) as $out_edges |
      ($dns|map({key:.tag,value:[(.domain_resolver?,.address_resolver?)|select(.!=null)|resolver_tag]})|from_entries) as $dns_edges |
      require(($selected|length)>0 and ($tags|unique|length)==($tags|length);"selected_tags") |
      require(all($tags[]; .==($s+"-out") or .==($s+"-urltest-out") or member_name);"supported_names") |
      require(([.outbounds[].tag]|unique|length)==(.outbounds|length);"unique_tags") |
      require(($selected|map(select(.tag==($s+"-out") and (.type=="selector" or .type=="urltest")))|length)==1;"section_group") |
      require(all($selected[]; .tag!=($s+"-urltest-out") or .type=="urltest");"urltest_type") |
      require(all($tags[]; acyclic($out_edges;.;[]));"outbound_cycle") |
      require(all($dns_tags[]; acyclic($dns_edges;.;[]));"dns_cycle") |
      require(all($selected[]; .type as $t | ["selector","urltest","direct","socks","http","shadowsocks","vmess","vless","trojan","hysteria","hysteria2","tuic","ssh"]|index($t)!=null);"transport_type") |
      require(all($selected[]; if .type=="selector" or .type=="urltest" then (.outbounds|type)=="array" and (.outbounds|length)>0 and all(.outbounds[]; . as $t | $tags|index($t)!=null) and (.default==null or (.default as $t | .outbounds|index($t)!=null)) else .outbounds==null end);"group_members") |
      require(all($selected[]; .detour==null or (.detour as $t | $tags|index($t)!=null));"outbound_detour") |
      require(all($selected[]|..|objects|(.domain_resolver?,.address_resolver?)|select(.!=null)|resolver_tag; . as $t | $dns_tags|index($t)!=null);"outbound_dns") |
      require(($dns|length)>0 and ($dns_tags|unique|length)==($dns_tags|length);"dns_servers") |
      require(all($dns[]; .detour==null or (.detour as $t | ($tags+$direct_tags)|index($t)!=null));"dns_detour") |
      require(all($dns[]|..|objects|(.domain_resolver?,.address_resolver?)|select(.!=null)|resolver_tag; . as $t | $dns_tags|index($t)!=null);"dns_resolver") |
      require(.dns.final==null or (.dns.final as $t | $dns_tags|index($t)!=null);"dns_final") |
      require(.route.default_domain_resolver==null or (.route.default_domain_resolver|resolver_tag as $t | $dns_tags|index($t)!=null);"route_dns") |
      require(all((.route,.dns)|..|objects|(.outbound?,.detour?)|select(.!=null); . as $t | ($tags|index($t))==null or $t==($s+"-out"));"frontend_dependency") |
      require(all(.outbounds[]|select((.tag as $t|$tags|index($t))==null)|(.detour?,.outbounds[]?)|select(.!=null); . as $t | ($tags|index($t))==null or $t==($s+"-out"));"frontend_outbound_dependency") |
      {frontend: ($source|.outbounds |= (map(select((.tag as $t | $tags|index($t))==null)) + [{type:"socks",tag:($s+"-out"),server:"127.0.0.1",server_port:$port,version:"5",routing_mark:2097152}])),
       worker: {log:{level:"warn"},dns:($source.dns|.servers=$dns|del(.rules,.fakeip,.cache_capacity)),
         inbounds:[{type:"mixed",tag:"section-in",listen:"127.0.0.1",listen_port:$port}],
         outbounds:($selected + [$source.outbounds[]|select(.type=="direct" and (.tag as $t | $tags|index($t))==null)]|map(if .type=="selector" or .type=="urltest" then . else .routing_mark=2097152 end)),
         route:({final:($s+"-out"),auto_detect_interface:true,default_mark:2097152} + (if $source.route.default_domain_resolver!=null then {default_domain_resolver:$source.route.default_domain_resolver} else {} end)),
         experimental:((if $source.experimental|has("utls_fallback") then {utls_fallback:$source.experimental.utls_fallback} else {} end) +
           {clash_api:{external_controller:("127.0.0.1:"+($api|tostring))}})}}
    ' "$logical" > "$staged/split.json" 2>"$staged/error"; then
        reason="$(sed -n 's/.*\(section_graph\/[a-z_]*\).*/\1/p' "$staged/error" | head -n 1)"
        rm -rf "$staged"
        error "${reason:-unsupported_graph}"
        return 1
    fi
    jq '.frontend' "$staged/split.json" > "$staged/frontend.json"
    jq '.worker' "$staged/split.json" > "$staged/worker.json"
    cp "$logical" "$staged/logical.json"
    jq -n --arg s "$section" --argjson p "$port" --argjson a "$api" '{section:$s,port:$p,api_port:$a}' > "$staged/metadata.json"
    rm "$staged/split.json"
    rm "$staged/error"
    chmod 600 "$staged"/*.json
    mv "$staged" "$output"
)

resource_floor() (
    available="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
    case "$available" in ''|*[!0-9]*) error memory_unavailable; return 1;; esac
    [ "$available" -ge 28672 ] || { error memory_floor; return 1; }
)
valid_section() { case "$1" in ''|*[!A-Za-z0-9_]*) return 1;; esac; }
resource_count_floor() (
    count="$(jq -er '.sections|length' "$1")" || return 1
    available="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
    [ "$available" -ge "$((28672 + count * 16384))" ] || { error worker_count_memory_floor; return 1; }
)
lock_root() {
    command -v flock >/dev/null 2>&1 || { error lock_unavailable; return 1; }
    if [ -z "$LOCK_PATH" ]; then
        key="$(printf '%s' "$ROOT" | sha256sum | cut -c 1-16)"
        LOCK_PATH="/var/run/podkop-section-runtime-$key.lock"
    fi
    exec 9>> "$LOCK_PATH"
    flock -n 9 || { error busy; return 1; }
    mkdir -p "$ROOT"; chmod 700 "$ROOT"
    WORK="$(mktemp -d "$ROOT/.candidate.XXXXXX")"
}
canonical() { jq -cS '.outbounds |= sort_by(.tag)' "$1"; }
same_graph() {
    canonical "$1" > "$WORK/compare-a" &&
    canonical "$2" > "$WORK/compare-b" &&
    cmp -s "$WORK/compare-a" "$WORK/compare-b"
}
validate_registry() {
    jq -e '
        def valid_name: type=="string" and length>0 and all(explode[]; (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122) or .==95);
        def entry: (.section|valid_name) and (.port|type=="number") and (.api_port|type=="number")
          and .port>=1024 and .port<=65535 and .api_port>=1024 and .api_port<=65535
          and (.port|floor)==.port and (.api_port|floor)==.api_port;
        .version==2 and (.sections|type=="array") and (.allocations|type=="array") and
        (.sections|length)>0 and all(.allocations[];entry) and all(.sections[];entry) and
        ([.allocations[].section]|unique|length)==(.allocations|length) and
        ([.sections[].section]|unique|length)==(.sections|length) and
        ([.allocations[]|.port,.api_port]|unique|length)==((.allocations|length)*2)
    ' "$1" >/dev/null 2>&1 || { error invalid_registry; return 1; }
    jq -e '.allocations as $all | all(.sections[]; . as $s | any($all[]; .==$s))' "$1" >/dev/null || { error invalid_registry; return 1; }
}
make_registry() {
    names="$1" output="$2"
    printf '%s' "$names" | jq -e 'type=="array" and length>0 and length<=32 and all(.[];type=="string") and (unique|length)==length' >/dev/null || { error invalid_sections; return 1; }
    printf '%s' "$names" | jq -r '.[]' > "$WORK/names"
    while IFS= read -r name; do valid_section "$name" || { error invalid_section; return 1; }; done < "$WORK/names"
    if [ -f "$ROOT/metadata.json" ] && jq -e '.version==2' "$ROOT/metadata.json" >/dev/null 2>&1; then
        validate_registry "$ROOT/metadata.json" || return 1
        jq '.allocations' "$ROOT/metadata.json" > "$WORK/allocations.json"
    else
        printf '[]\n' > "$WORK/allocations.json"
    fi
    # Reserved first slots stay stable regardless of input enumeration order.
    for preferred in main Main GeoBlock GEOBLOCK; do
        if grep -Fxq "$preferred" "$WORK/names"; then
            printf '%s\n' "$preferred"
        fi
    done > "$WORK/sorted-names"
    LC_ALL=C sort "$WORK/names" | while IFS= read -r name; do
        case "$name" in main|Main|GeoBlock|GEOBLOCK) ;; *) printf '%s\n' "$name";; esac
    done >> "$WORK/sorted-names"
    while IFS= read -r name; do
        if jq -e --arg s "$name" 'any(.[];.section==$s)' "$WORK/allocations.json" >/dev/null; then continue; fi
        case "$name" in main|Main) port=19160;; *) port=19170;; esac
        while jq -e --argjson p "$port" 'any(.[];.port==$p or .api_port==$p or .port==($p+3) or .api_port==($p+3))' "$WORK/allocations.json" >/dev/null; do port=$((port+10)); done
        [ "$port" -le 65532 ] || { error ports_exhausted; return 1; }
        jq --arg s "$name" --argjson p "$port" '.+[{section:$s,port:$p,api_port:($p+3)}]' "$WORK/allocations.json" > "$WORK/next-allocations.json"
        mv "$WORK/next-allocations.json" "$WORK/allocations.json"
    done < "$WORK/sorted-names"
    jq -n --argjson names "$names" --slurpfile alloc "$WORK/allocations.json" '
        {version:2,allocations:$alloc[0],sections:[$names[] as $name | $alloc[0][]|select(.section==$name)]}
    ' > "$output"
    validate_registry "$output"
}
prepare_all() {
    logical="$1" registry="$2" output="$3"
    mkdir -p "$output/workers"
    cp "$logical" "$output/logical.json"
    cp "$logical" "$output/frontend.json"
    cp "$registry" "$output/metadata.json"
    jq -r '.sections[]|[.section,.port,.api_port]|@tsv' "$registry" > "$WORK/entries"
    while IFS="$(printf '\t')" read -r name port api; do
        split_one "$logical" "$name" "$port" "$api" "$output/split-$name" || return 1
        mkdir "$output/workers/$name"
        mv "$output/split-$name/worker.json" "$output/workers/$name/worker.json"
        mv "$output/split-$name/metadata.json" "$output/workers/$name/metadata.json"
        jq --arg s "$name" --argjson p "$port" '
            .outbounds |= (map(select((.tag|startswith($s+"-"))|not)) +
              [{type:"socks",tag:($s+"-out"),server:"127.0.0.1",server_port:$p,version:"5",routing_mark:2097152}])
        ' "$output/frontend.json" > "$output/next-frontend.json"
        mv "$output/next-frontend.json" "$output/frontend.json"
        rm -rf "$output/split-$name"
    done < "$WORK/entries"
    chmod 600 "$output"/*.json "$output"/workers/*/*.json
}
check_all() {
    "$SING_BOX" check -c "$1/frontend.json" 9>&- >/dev/null 2>&1 || { error frontend_invalid; return 1; }
    for worker in "$1"/workers/*/worker.json; do
        "$SING_BOX" check -c "$worker" 9>&- >/dev/null 2>&1 || { error worker_invalid; return 1; }
    done
}
prepare_preview() {
    [ ! -e "$3" ] || { error output_exists; return 1; }
    WORK="$(mktemp -d /tmp/podkop-section-prepare.XXXXXX)" || return 1
    make_registry "$2" "$WORK/registry.json" || return 1
    prepare_all "$1" "$WORK/registry.json" "$WORK/prepared" || return 1
    mv "$WORK/prepared" "$3"
}
process_identity() (
    pid="$1" cfg="$2"
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ "$pid" -gt 1 ] && [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | awk -v bin="$SING_BOX" -v cfg="$cfg" '
        NR==1 && $0!=bin {bad=1;exit}
        previous=="-c" && $0==cfg {found=1}
        {previous=$0}
        END {exit (bad || !found)}' || return 1
    start="$(awk '{print $22}' "/proc/$pid/stat")" || return 1
    case "$start" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s %s\n' "$pid" "$start"
)
service_identity() (
    section="$1"
    valid_section "$section" || return 1
    pid="$(ubus call service list '{"name":"podkop-section-worker"}' 2>/dev/null |
      jq -er --arg s "$section" '."podkop-section-worker".instances[$s]|select(.running==true)|.pid|select(type=="number" and .>1 and floor==.)')" || return 1
    process_identity "$pid" "$ROOT/workers/$section/worker.json"
)
frontend_identity() (
    pid="$(ubus call service list '{"name":"sing-box"}' 2>/dev/null |
      jq -er '[."sing-box".instances[]?|select(.running==true)|.pid]|select(length==1)|.[0]')" || return 1
    process_identity "$pid" "$FRONTEND"
)
owns_listener() (
    pid="$1" port="$2"
    sockets="$(awk -v addr="0100007F:$(printf '%04X' "$port")" '$2==addr && $4=="0A" {print $10}' "/proc/$pid/net/tcp" 2>/dev/null)"
    [ -n "$sockets" ] || return 1
    for inode in $sockets; do
        for fd in /proc/"$pid"/fd/*; do
            [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$inode]" ] && return 0
        done
    done
    return 1
)
ready_identity() (
    section="$1"
    identity="$(service_identity "$section")" || return 1
    pid="${identity%% *}"
    ports="$(jq -er --arg s "$section" '.sections[]|select(.section==$s)|[.port,.api_port]|@tsv' "$ROOT/metadata.json")" || return 1
    [ -n "$ports" ] || return 1
    for port in $ports; do owns_listener "$pid" "$port" || return 1; done
    printf '%s\n' "$identity"
)
wait_ready() (
    target="${1:-}" previous="${2:-}" attempts=0
    validate_registry "$ROOT/metadata.json" >/dev/null 2>&1 || return 1
    if [ -n "$target" ]; then
        valid_section "$target" && jq -e --arg s "$target" 'any(.sections[];.section==$s)' "$ROOT/metadata.json" >/dev/null || return 1
    fi
    while [ "$attempts" -lt 8 ]; do
        good=1
        jq -r '.sections[].section' "$ROOT/metadata.json" > "$WORK/wait-names" || return 1
        while IFS= read -r section; do
            [ -z "$target" ] || [ "$target" = "$section" ] || continue
            identity="$(ready_identity "$section")" || identity=""
            [ -n "$identity" ] && { [ -z "$previous" ] || [ "$identity" != "$previous" ]; } || good=0
        done < "$WORK/wait-names"
        [ "$good" = 1 ] && return 0
        attempts=$((attempts+1)); sleep 1
    done
    return 1
)
peers_capture() {
    frontend_identity > "$WORK/frontend.identity" || { error frontend_not_ready; return 1; }
    jq -r '.sections[].section' "$ROOT/metadata.json" > "$WORK/peer-names"
    while IFS= read -r section; do
        [ "$section" != "$TARGET" ] || continue
        ready_identity "$section" > "$WORK/identity-$section" || { error peer_not_ready; return 1; }
    done < "$WORK/peer-names"
}
peers_unchanged() {
    frontend_identity > "$WORK/frontend.after" || return 1
    cmp -s "$WORK/frontend.identity" "$WORK/frontend.after" || return 1
    while IFS= read -r section; do
        [ "$section" != "$TARGET" ] || continue
        ready_identity "$section" > "$WORK/after-$section" || return 1
        cmp -s "$WORK/identity-$section" "$WORK/after-$section" || return 1
    done < "$WORK/peer-names"
}
bootstrap() {
    resource_floor || return 1
    lock_root || return 1
    make_registry "$2" "$WORK/registry.json" || return 1
    resource_count_floor "$WORK/registry.json" || return 1
    prepare_all "$1" "$WORK/registry.json" "$WORK/prepared" || return 1
    check_all "$WORK/prepared" || return 1
    mkdir "$WORK/before"
    for file in workers frontend.json logical.json metadata.json; do
        [ ! -e "$ROOT/$file" ] || cp -a "$ROOT/$file" "$WORK/before/$file" || return 1
    done
    PHASE=bootstrap; SWAPPED=1
    for file in workers frontend.json logical.json metadata.json; do
        rm -rf "$ROOT/$file"
        mv "$WORK/prepared/$file" "$ROOT/$file" || return 1
    done
    COMMITTED=1
}
apply() {
    TARGET="$2"
    valid_section "$TARGET" || { error invalid_section; return 1; }
    resource_floor || return 1
    lock_root || return 1
    validate_registry "$ROOT/metadata.json" || return 1
    resource_count_floor "$ROOT/metadata.json" || return 1
    jq -e --arg s "$TARGET" 'any(.sections[];.section==$s)' "$ROOT/metadata.json" >/dev/null || { error unregistered_section; return 1; }
    prepare_all "$1" "$ROOT/metadata.json" "$WORK/prepared" || return 1
    same_graph "$WORK/prepared/frontend.json" "$FRONTEND" &&
    same_graph "$ROOT/frontend.json" "$FRONTEND" || { error frontend_changed; return 1; }
    for candidate in "$WORK/prepared"/workers/*/worker.json; do
        section="$(basename "$(dirname "$candidate")")"
        [ "$section" != "$TARGET" ] || continue
        same_graph "$candidate" "$ROOT/workers/$section/worker.json" || { error peer_worker_changed; return 1; }
    done
    check_all "$WORK/prepared" || return 1
    peers_capture || return 1
    previous="$(ready_identity "$TARGET")" || { error worker_not_ready; return 1; }
    if same_graph "$WORK/prepared/workers/$TARGET/worker.json" "$ROOT/workers/$TARGET/worker.json"; then
        peers_unchanged || { error peer_identity_changed; return 1; }
        mv "$WORK/prepared/logical.json" "$ROOT/logical.json" || return 1
        return 0
    fi
    cp -p "$ROOT/workers/$TARGET/worker.json" "$WORK/before-worker.json"
    cp -p "$ROOT/logical.json" "$WORK/before-logical.json"
    PHASE=apply; SWAPPED=1
    mv "$WORK/prepared/workers/$TARGET/worker.json" "$ROOT/workers/$TARGET/worker.json" || return 1
    if "$INIT" reload 9>&- >/dev/null 2>&1 && wait_ready "$TARGET" "$previous" && peers_unchanged && resource_floor; then
        mv "$WORK/prepared/logical.json" "$ROOT/logical.json" || return 1
        COMMITTED=1
        return 0
    fi
    error worker_apply_failed
}
status() (
    if ! validate_registry "$ROOT/metadata.json" >/dev/null 2>&1; then printf '{"ready":false,"sections":[],"registryVersion":2}\n'; return; fi
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    jq -r '.sections[].section' "$ROOT/metadata.json" | while IFS= read -r section; do
        identity="$(ready_identity "$section")" || identity="0 0"
        pid="${identity%% *}" start="${identity#* }"
        jq -cn --arg s "$section" --argjson p "$pid" --argjson t "$start" '{section:$s,ready:($p>1),pid:$p,starttime:$t}'
    done > "$tmp"
    jq -sc '{ready:(length>0 and all(.[];.ready)),sections:.,registryVersion:2}' "$tmp"
)
case "${1:-}" in
    preflight) [ "$#" = 1 ] || exit 1; resource_floor && resource_count_floor "$ROOT/metadata.json";;
    prepare) [ "$#" = 4 ] || exit 1; prepare_preview "$2" "$3" "$4";;
    split-one) [ "$#" = 6 ] || exit 1; split_one "$2" "$3" "$4" "$5" "$6";;
    bootstrap) [ "$#" = 3 ] || exit 1; bootstrap "$2" "$3";;
    apply) [ "$#" = 3 ] || exit 1; apply "$2" "$3";;
    status) [ "$#" = 1 ] || exit 1; status;;
    wait-ready) [ "$#" -le 2 ] || exit 1; WORK="$(mktemp -d /tmp/podkop-section-wait.XXXXXX)"; wait_ready "${2:-}";;
    *) error invalid_command; exit 1;;
esac


