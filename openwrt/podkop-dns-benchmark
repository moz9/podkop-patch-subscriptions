#!/bin/sh
# Standalone PE DNS measurement. No UCI writes or service reload in probes.
set -eu
DB_SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
PODKOP_DNS_OPTIMIZER_LIBRARY_ONLY=1
export PODKOP_DNS_OPTIMIZER_LIBRARY_ONLY
# shellcheck disable=SC1090
. "${PODKOP_DNS_BENCHMARK_OPTIMIZER:-/usr/bin/podkop-dns-optimizer}"
DB_DIR="${PODKOP_DNS_BENCHMARK_STATE_DIR:-/tmp/podkop-dns-benchmark}"
DB_PERSIST="${PODKOP_DNS_BENCHMARK_PERSIST_DIR:-/etc/podkop/dns-benchmark}"
DB_STATUS="$DB_DIR/status.json"
DB_REPORT="$DB_PERSIST/report.json"
DB_PROOF="$DB_PERSIST/pair-proof.json"
DB_RESERVE_PROOF="$DB_PERSIST/reserve-proof.json"
DB_LOCK="$DB_DIR/lock"
DB_DNS_PORT=19553
DB_PROXY_PORT=19554
DB_WORKERS_DIR="${PODKOP_DNS_BENCHMARK_WORKERS_DIR:-/etc/podkop/section-runtime/workers}"
DB_SECTION_ROOT="${PODKOP_SECTION_ROOT:-/etc/podkop/section-runtime}"
DB_BIN="${PODKOP_DNS_BENCHMARK_BIN:-sing-box}"

db_worker_configs() {
    local worker
    # A single-process migration retains split files solely for rollback.
    [ "$(cat "$DB_SECTION_ROOT/runtime-mode" 2>/dev/null || true)" != single ] || return 0
    for worker in "$DB_WORKERS_DIR"/*/worker.json; do
        [ -s "$worker" ] || continue
        [ ! -L "$worker" ] || return 1
        case "$worker" in *' '*|*'|'*) return 1;; esac
        printf '%s\n' "$worker"
    done
}
db_child_pid=''
db_section_pids=''
db_phase=''
db_selection_complete=false
db_recommendation='null'
db_tested_sections='[]'
db_section_results='[]'
db_https_ms=0
db_https_count=0
db_https_attempted=false
db_worker_pid=0
db_work=''
db_results='[]'
db_bootstrap_results='[]'
db_available_results='null'
db_available_bootstrap_results='null'
db_pair_json='null'
db_pair_results='[]'
db_individual_complete=false
db_child_error='child_failed'
db_mutation_pending=0
db_apply_pid=''
db_apply_launching=0
db_apply_signal=0
db_action=benchmark
db_report_id=''
db_deadline=0
db_probe_deadline=0
db_measurement_profile=full
db_sample_cache_dir=''
db_started_at=0
db_candidates_total=0
db_pairs_tested=0
db_confirmation_runs=0
db_target_pairs=0
db_comparison_complete=false
db_exhaustive_selected=false
db_parallelism=1
db_pool_pids=''
db_section_port_base=19600
db_cancel_file="$DB_DIR/cancel"
db_prefilter='{"excluded":0,"duplicates":0,"deferred":0}'
DB_PREPARED_DIR=''
db_endpoint_coverage='{"main":{"selected":0,"tested":0},"bootstrap":{"selected":0,"tested":0}}'
db_shortlisted_pairs=0
db_full_verification_complete=false
db_full_verification_attempts=0
db_full_verification_results='[]'
db_current_primary_provider=''
db_current_bootstrap_provider=''
db_recommendation_bootstrap_test='null'
db_bootstrap_test='null'
db_production_file=''
db_resource_watch_pid=''
db_resource_error_file=''
db_resource_owned_file=''
db_check_pid=''
db_check_start=''

db_is_verified() { [ "$db_action" = recommend_verified ] || [ "$db_action" = recommend_reserve ]; }
db_is_recommend() { [ "$db_action" = recommend ] || [ "$db_action" = recommend_full ] || db_is_verified; }
db_is_staged() { [ "$db_action" = recommend ] || db_is_verified; }

# Use catalog provider identity, never an IP prefix or a guessed hostname.
db_provider_family() {
    local name
    name="$(printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z' | sed 's/.*(//;s/).*//;s/ dns.*//;s/ secondary.*//;s/ secure.*//;s/ unfiltered.*//;s/ primary.*//' | tr -d ' ')"
    case "$name" in cloudflare*) echo cloudflare;; google*) echo google;; controld*) echo controld;; adguard*) echo adguard;; yandex*) echo yandex;; *) printf '%s\n' "$name";; esac
}
db_endpoint_provider() {
    local kind="$1" protocol="$2" server="$3" label catalog
    catalog="${PODKOP_DNS_CATALOG_DIR:-/usr/share/podkop}/dns-$kind.json"
    [ -s "$catalog" ] || return 1
    label="$(jq -er --arg p "$protocol" --arg s "$server" '[.servers[]|select((.protocols|index($p)) and (.value==$s or ((.aliases//[])|index($s))))][0].label//empty' "$catalog")" || return 1
    db_provider_family "$label"
}
db_reserve_filter() {
    local configured slot prefix='' protocol server bootstrap bp
    slot="$(configured_active_slot)"; configured="$(read_configured_pair "$slot" || true)"
    IFS='|' read -r protocol server bootstrap <<EOF
$configured
EOF
    [ "$slot" != secondary ] || prefix=secondary_
    bp="$(uci -q get "podkop.settings.${prefix}bootstrap_dns_type" 2>/dev/null || true)"; bp="${bp:-udp}"
    db_current_primary_provider="$(db_endpoint_provider main "$protocol" "$server")" || { db_child_error=current_provider_unknown; return 1; }
    db_current_bootstrap_provider="$(db_endpoint_provider bootstrap "$bp" "$bootstrap")" || { db_child_error=current_provider_unknown; return 1; }
    jq --arg main "$db_current_primary_provider" --arg boot "$db_current_bootstrap_provider" 'map(select(.mainFamily!=$main and .mainFamily!=$boot and .bootstrapFamily!=$main and .bootstrapFamily!=$boot and .bootstrapFamily!=.mainFamily))' "$db_work/all-pairs.json" > "$db_work/reserve-pairs.json" || return 1
    mv "$db_work/reserve-pairs.json" "$db_work/all-pairs.json"
    [ "$(jq length "$db_work/all-pairs.json")" -gt 0 ] || { db_child_error=independent_reserve_unavailable; return 1; }
}

db_prepare() { mkdir -p "$DB_DIR" "$DB_PERSIST"; chmod 700 "$DB_DIR" "$DB_PERSIST"; }
db_reply() { jq -cn --arg error "${1:-}" '{success:($error==""),error:(if $error=="" then null else $error end)}'; }
db_engine_identity() (
    local engine binary_hash version_hash version_file until
    engine="$(command -v "$DB_BIN" 2>/dev/null)" || return 1
    [ -f "$engine" ] && [ -r "$engine" ] && [ -x "$engine" ] || return 1
    binary_hash="$(sha256sum < "$engine")" || return 1
    binary_hash="${binary_hash%% *}"
    case "$binary_hash" in ''|*[!a-f0-9]*) return 1;; esac
    [ "${#binary_hash}" = 64 ] || return 1
    if [ "${1:-full}" = ordering ]; then
        printf 'endpoint-ordering-engine-sha256=%s\n' "$binary_hash"
        return 0
    fi
    db_resource_admit || return 1
    version_file="$(mktemp "$DB_DIR/engine-version.XXXXXX")" || return 1
    # Hash the entire output file, including trailing newlines and build tags.
    # Never reuse a cached identity: replacement at the same path invalidates
    # already measured primary/reserve results. Keep Go private and bounded.
    until=$(( $(date +%s)+5 ))
    if [ "$db_probe_deadline" -eq 0 ] || [ "$until" -lt "$db_probe_deadline" ]; then db_probe_deadline="$until"; fi
    if ! (db_private_oom_priority || exit 125; unset SING_BOX_DNS_FALLBACK SING_BOX_RULESET_RECOVERED_HOOK; db_bounded_command nice -n 19 "$engine" version) > "$version_file" 2>/dev/null ||
       [ ! -s "$version_file" ] || [ "$(wc -c < "$version_file")" -gt 65536 ] ||
       ! LC_ALL=C grep -q '[^[:space:]]' "$version_file"; then
        rm -f "$version_file"; return 1
    fi
    version_hash="$(sha256sum < "$version_file")" || { rm -f "$version_file"; return 1; }
    rm -f "$version_file"
    version_hash="${version_hash%% *}"
    case "$version_hash" in ''|*[!a-f0-9]*) return 1;; esac
    [ "${#version_hash}" = 64 ] || return 1
    printf 'engine-sha256=%s\nengine-version-sha256=%s\n' "$binary_hash" "$version_hash"
)
db_fingerprint() {
    local path exported choices runtime hashes
    exported="$(uci export podkop 2>/dev/null)" || return 1
    path="$(uci -q get podkop.settings.config_path 2>/dev/null || true)"
    [ -n "$path" ] || path=/etc/sing-box/config.json
    hashes="$(mktemp "$DB_DIR/fingerprint-hashes.XXXXXX")"
    db_engine_identity "${1:-full}" > "$hashes" || { rm -f "$hashes"; return 1; }
    for runtime in "$path" $(db_worker_configs); do
      if db_is_recommend; then db_runtime_safe || { rm -f "$hashes"; return 1; }; fi
      [ -s "$runtime" ] || continue
      sha256sum "$runtime" >> "$hashes"
      # Include inspectable local destination datasets, not only their paths.
      jq -r '(.route.rule_set//[])[]|select(.type=="local")|.path' "$runtime" | while IFS= read -r dataset; do
          [ -s "$dataset" ] && sha256sum "$dataset" || exit 1
      done >> "$hashes" || { rm -f "$hashes"; return 1; }
      if jq -e '.outbounds|any(.type=="selector" or .type=="urltest")' "$runtime" >/dev/null; then
        choices="$(mktemp "$DB_DIR/fingerprint.XXXXXX")"
        db_snapshot_choices "$runtime" "$choices" || { rm -f "$choices" "$hashes"; return 1; }
        jq -cS --slurpfile runtime "$runtime" '[ $runtime[0].outbounds[]|select(.type=="selector" or .type=="urltest")|.tag ] as $tags | [.proxies|to_entries[]|select(.key as $tag|$tags|index($tag))|{tag:.key,now:.value.now}]|sort_by(.tag)' "$choices" | sha256sum >> "$hashes"
        rm -f "$choices"
      fi
    done
    { printf '%s\n' "$exported"; cat "$hashes"; } | sha256sum | awk '{print $1}'
    rm -f "$hashes"
}
db_reload_busy() {
    [ ! -d /tmp/podkop-dns-failover/switch.lock ] || return 0
    ps w | grep -E '[/]usr/bin/podkop (start|restart|reload)|[/]etc/init.d/podkop (start|restart|reload)' | grep -v grep >/dev/null
}
db_busy() {
    local holder
    if [ -d "$PODKOP_MUTATION_LOCK_DIR" ]; then
        holder="$(awk 'NR==1 {print $1}' "$PODKOP_MUTATION_LOCK_DIR/owner" 2>/dev/null || true)"
        [ -n "$holder" ] && ! podkop_mutation_lock_pid_alive "$holder" || return 0
    fi
    podkop_mutation_legacy_lock_busy && return 0
    db_reload_busy && return 0
    return 1
}
db_backup_available() {
    local base="${PODKOP_DNS_APPLY_BACKUP_DIR:-/etc/podkop/dns-apply}"
    if [ -s "$base/latest" ] || [ -s "$base/pending" ]; then echo true; else echo false; fi
}

db_state() {
    local state="$1" message="$3" done="$5" total="$6" error="${7:-}" backup=false
    local action="$2" pairs_file="$DB_STATUS.pairs.$$" verified_file="$DB_STATUS.verified.$$"
    if db_is_recommend; then action="$db_action"; fi
    if { [ "$state" = running ] || [ "$state" = done ]; } && [ -f "$DB_DIR/cancel" ]; then return 1; fi
    backup="$(db_backup_available)"
    # Complete comparisons can exceed the kernel's per-argument exec limit.
    # Pass the private array as a file while keeping status publication atomic.
    printf '%s\n' "$db_pair_results" > "$pairs_file"
    printf '%s\n' "$db_full_verification_results" > "$verified_file"
    if ! jq -cn --arg state "$state" --arg action "$action" --arg message "$message" --arg error "$error" \
      --arg reportId "$db_report_id" --argjson progress "$4" --argjson completed "$done" --argjson total "$total" \
      --argjson results "$db_results" --argjson bootstrapResults "$db_bootstrap_results" --argjson pairResult "$db_pair_json" --slurpfile pairResults "$pairs_file" \
      --argjson availableResults "$db_available_results" --argjson availableBootstrapResults "$db_available_bootstrap_results" \
      --argjson pid "$db_worker_pid" --argjson backupAvailable "$backup" --argjson individualComplete "$db_individual_complete" \
      --arg phase "$db_phase" --argjson selectionComplete "$db_selection_complete" --argjson recommendation "$db_recommendation" --argjson testedSections "$db_tested_sections" \
      --argjson fullComplete "$db_full_verification_complete" --argjson fullAttempts "$db_full_verification_attempts" --slurpfile fullResults "$verified_file" \
      '{state:$state,action:$action,message:$message,error:(if $error=="" then null else $error end),reportId:$reportId,progress:$progress,completed:$completed,total:$total,results:$results,bootstrapResults:$bootstrapResults,availableResults:$availableResults,availableBootstrapResults:$availableBootstrapResults,pairResult:$pairResult,pairResults:$pairResults[0],individualComplete:$individualComplete,pid:$pid,backupAvailable:$backupAvailable,phase:$phase,selectionComplete:$selectionComplete,recommendation:$recommendation,testedSections:$testedSections,fullVerificationComplete:($state=="done" and $fullComplete),fullVerificationAttempts:$fullAttempts,fullVerificationResults:$fullResults[0]} + (if $action=="benchmark" then {budgetSeconds:60,measurementProfile:"native_endpoints",httpsTested:false} else {} end)' \
      > "$DB_STATUS.tmp.$$"; then
        rm -f "$pairs_file" "$verified_file" "$DB_STATUS.tmp.$$"
        return 1
    fi
    rm -f "$pairs_file" "$verified_file"
    if db_is_recommend; then
        jq --argjson candidates "$db_candidates_total" --argjson tested "$db_pairs_tested" --argjson confirmations "$db_confirmation_runs" \
          --argjson elapsed "$(( $(date +%s)-db_started_at ))" --argjson prefilter "$db_prefilter" \
          --argjson target "$db_target_pairs" --argjson compared "$db_comparison_complete" --argjson exhaustive "$db_exhaustive_selected" --argjson parallelism "$db_parallelism" \
          '.selectionMode="all_selected"|.measurementProfile="minute_sample"|.fullCompatibilityVerified=false|.sampleScope={dnsRepeats:1,baseDnsGroups:["google_play","chatgpt"],baseHttpsGroups:["google_play","chatgpt"],domainsPerSection:1,httpsPerSection:1,nxdomain:true,allActiveSections:true}|.minimumSuccessfulPairs=2|.successfulPairs=([.pairResults[]|select(.success and .stats.reliable and .rechecked!=false)]|length)|.successfulEligiblePairs=([.pairResults[]|select(.automaticEligible==true and .success and .stats.reliable and .rechecked!=false)]|length)|.stableEligiblePairs=([.pairResults[]|select(.automaticEligible==true and .rechecked==true)]|length)|.searchComplete=false|.exhaustiveSelected=$exhaustive|.parallelism=$parallelism|.maxParallelism=2|.candidatesTotal=$candidates|.pairsTested=$tested|.targetPairs=$target|.comparisonComplete=$compared|.budgetSeconds=7200|.elapsedSeconds=$elapsed|.confirmationChecks=$confirmations|.prefilter=$prefilter' \
          "$DB_STATUS.tmp.$$" > "$DB_STATUS.fast.$$"
        mv "$DB_STATUS.fast.$$" "$DB_STATUS.tmp.$$"
        jq --arg action "$db_action" --arg stage "$db_phase" --argjson coverage "$db_endpoint_coverage" --argjson shortlisted "$db_shortlisted_pairs" \
          'if $action!="recommend_full" then .selectionMode="two_stage"|.recommendationMode="two_stage"|.recommendationScope="measured_shortlist"|.shortlistLimit=8|.shortlistedPairs=$shortlisted|.endpointCoverage=$coverage else .recommendationMode="full"|.recommendationScope="all_selected"|.shortlistLimit=null|.shortlistedPairs=.targetPairs|.endpointCoverage=$coverage end|.stage=$stage|.httpsTestedPairs=([.pairResults[]|select(.httpsTested==true)]|length)|.untestedHttpsPairs=([0,(.candidatesTotal-.httpsTestedPairs)]|max)' \
          "$DB_STATUS.tmp.$$" > "$DB_STATUS.fast.$$"
        mv "$DB_STATUS.fast.$$" "$DB_STATUS.tmp.$$"
        if db_is_verified; then
            jq --arg profile "$db_measurement_profile" '.recommendationMode="verified"|.recommendationScope="fully_verified_shortlist"|.measurementProfile=$profile|
              if .state!="done" or .fullVerificationComplete!=true then .recommendation=null|.pairResult=null|.selectionComplete=false else . end' "$DB_STATUS.tmp.$$" > "$DB_STATUS.fast.$$"
            mv "$DB_STATUS.fast.$$" "$DB_STATUS.tmp.$$"
        fi
    fi
    jq --argjson bootstrapTest "$db_bootstrap_test" --argjson reserve "$(if [ "$db_action" = recommend_reserve ]; then echo true; else echo false; fi)" --arg main "$db_current_primary_provider" --arg boot "$db_current_bootstrap_provider" --argjson checked "$db_recommendation_bootstrap_test" '.bootstrapTest=$bootstrapTest|.reserve=$reserve|if $reserve then .recommendationMode="reserve"|.currentPrimaryProvider=$main|.currentBootstrapProvider=$boot|.excludedProvider=$main|.recommendationBootstrapTest=$checked else . end' "$DB_STATUS.tmp.$$" > "$DB_STATUS.extra.$$" || return 1
    mv "$DB_STATUS.extra.$$" "$DB_STATUS.tmp.$$"
    if [ "$state" = done ] && [ -f "$DB_DIR/cancel" ]; then rm -f "$DB_STATUS.tmp.$$"; return 1; fi
    mv "$DB_STATUS.tmp.$$" "$DB_STATUS"
}
db_status() {
    local pid state report_id snapshot
    db_prepare
    if [ ! -s "$DB_STATUS" ] && [ -s "$DB_REPORT" ]; then cp "$DB_REPORT" "$DB_STATUS"; fi
    if [ ! -s "$DB_STATUS" ]; then db_state idle benchmark idle 0 0 0 ''; fi
    # Read one generation: separate state/PID reads can straddle publication.
    snapshot="$(jq -r '[.state,((.pid//0)|tostring),(.reportId//"")]|join("|")' "$DB_STATUS")"
    IFS='|' read -r state pid report_id <<EOF
$snapshot
EOF
    # A late worker rename must not hide an already requested cancellation.
    if { [ "$state" = running ] || [ "$state" = done ]; } && [ -f "$DB_DIR/cancel" ]; then
        jq '.state="cancelled" | .message="cancelled" | .error="cancelled" | .selectionComplete=false | .fullVerificationComplete=false | .exhaustiveSelected=false | .comparisonComplete=false | .recommendation=null | (if .action=="recommend_verified" then .pairResult=null elif .pairResult!=null then .pairResult.success=false | .pairResult.error="cancelled" else . end)' "$DB_STATUS" > "$DB_STATUS.cancel.$$"
        mv "$DB_STATUS.cancel.$$" "$DB_STATUS"
        state=cancelled
    fi
    if [ "$state" = running ] && [ "$pid" != 0 ] && ! pid_alive "$pid"; then
        # The worker may have published done and exited after our snapshot.
        # Recheck the current state and generation before reporting a stop.
        # Recovery is a read-only projection: even a later publication cannot
        # be overwritten by a stale temporary file rename from this reader.
        jq --argjson pid "$pid" --arg reportId "$report_id" --argjson backupAvailable "$(db_backup_available)" '
          if .state=="running" and (.pid//0)==$pid and (.reportId//"")==$reportId then
            .state="error" | .error="worker_stopped" | .message="worker_stopped" |
            .selectionComplete=false | .fullVerificationComplete=false | .recommendation=null |
            (if .action=="recommend_verified" or .action=="recommend_reserve" then .pairResult=null else . end)
          else . end | .backupAvailable=$backupAvailable' "$DB_STATUS"
        return
    fi
    jq --argjson backupAvailable "$(db_backup_available)" '.backupAvailable=$backupAvailable' "$DB_STATUS"
}
db_validate_pair() {
    local protocol="$1" id="$2" server="$3" bootstrap="$4" bp="${5:-udp}" host line endpoint file
    case "$protocol:$bp" in *doq*|*h3*) return 1;; esac
    case "$protocol" in udp|tcp|doh|dot) :;; *) return 1;; esac
    case "$bp" in udp|tcp|doh|dot) :;; *) return 1;; esac
    case "$id" in ''|*[!A-Za-z0-9_-]*) return 1;; esac
    case "$server" in ''|*[!A-Za-z0-9.:/_-]*) return 1;; esac
    endpoint="$(dns_catalog_endpoint "$protocol" "$server" main)" || return 1
    host="$(printf '%s' "$endpoint" | jq -r '.host')"
    if [ "$protocol" = udp ] || [ "$protocol" = tcp ]; then is_ipv4 "$host" || return 1; fi
    endpoint="$(dns_catalog_endpoint "$bp" "$bootstrap" bootstrap)" || return 1
    is_ipv4 "$(printf '%s' "$endpoint" | jq -r '.host')" || return 1
    line="$(lookup_main_candidate "$protocol" "$id" || true)"
    [ -n "$line" ] || return 1
    [ "$(dns_catalog_endpoint "$protocol" "$(printf '%s' "$line" | cut -d '|' -f3)" main | jq -cS .)" = "$(dns_catalog_endpoint "$protocol" "$server" main | jq -cS .)" ] || return 1
    candidate_is_primary_eligible "$id" "$(printf '%s' "$line" | cut -d '|' -f2)" "$server" || return 1
    file="$(mktemp "$DB_DIR/allowed.XXXXXX")"
    write_bootstrap_candidates "$file" "$bp" || { rm -f "$file"; return 1; }
    awk -F '|' -v server="$bootstrap" '$3==server {found=1} END {exit !found}' "$file"
    local result=$?
    rm -f "$file"; return "$result"
}
db_pair_object() { jq -cn --arg protocol "$1" --arg id "$2" --arg dnsServer "$3" --arg bootstrapDnsServer "$4" --arg bootstrapProtocol "${6:-udp}" --argjson success "$5" '{protocol:$protocol,id:$id,dnsServer:$dnsServer,bootstrapDnsServer:$bootstrapDnsServer,bootstrapProtocol:$bootstrapProtocol,success:$success}'; }
db_write_proof() {
    local fingerprint
    fingerprint="${2:-}"
    [ -n "$fingerprint" ] || fingerprint="$(db_fingerprint)" || return 1
    jq -cn --argjson pair "$1" --arg reportId "$db_report_id" --arg fingerprint "$fingerprint" --argjson testedAt "$(date +%s)" \
      '{pair:$pair,reportId:$reportId,fingerprint:$fingerprint,testedAt:$testedAt}' > "$DB_PROOF.tmp.$$" || return 1
    mv "$DB_PROOF.tmp.$$" "$DB_PROOF"
}
db_proof_valid() {
    local fingerprint
    [ ! -f "$DB_DIR/cancel" ] || return 1
    [ -s "$DB_PROOF" ] && [ -s "$DB_REPORT" ] || return 1
    fingerprint="$(db_fingerprint)" || return 1
    # Waiting or minimizing the browser does not invalidate a completed test.
    # Bind admission to the exact result and current configuration instead;
    # the apply helper still checks runtime safety and validates the change.
    jq -e --arg protocol "$1" --arg id "$2" --arg server "$3" --arg bootstrap "$4" --arg bp "${5:-udp}" --arg fingerprint "$fingerprint" \
      --argjson now "$(date +%s)" --slurpfile report "$DB_REPORT" \
      '.pair.success==true and .pair.protocol==$protocol and .pair.id==$id and .pair.dnsServer==$server and .pair.bootstrapDnsServer==$bootstrap and (.pair.bootstrapProtocol//"udp")==$bp and .fingerprint==$fingerprint and (.testedAt|type)=="number" and .testedAt>0 and (.testedAt|floor==.) and .testedAt<= $now and .reportId==$report[0].reportId and $report[0].state=="done" and $report[0].pairResult.success==true and
      ($report[0].action=="pair_test" or
       ($report[0].action=="recommend_verified" and $report[0].state=="done" and $report[0].selectionComplete==true and $report[0].fullVerificationComplete==true and $report[0].measurementProfile=="full" and .pair.measurementProfile=="full" and .pair.stats.reliable==true and .pair.automaticEligible==true and .pair.rechecked==true and .pair==$report[0].pairResult and .pair==$report[0].recommendation and (.pair as $pair|any($report[0].fullVerificationResults[]; .==$pair))))' "$DB_PROOF" >/dev/null
}
db_write_reserve_proof() {
    jq -cn --argjson pair "$db_pair_json" --arg reportId "$db_report_id" --arg fingerprint "$1" --argjson testedAt "$(date +%s)" \
      '{pair:$pair,reportId:$reportId,fingerprint:$fingerprint,testedAt:$testedAt}' > "$DB_RESERVE_PROOF.tmp.$$" || return 1
    mv "$DB_RESERVE_PROOF.tmp.$$" "$DB_RESERVE_PROOF"
}
db_reserve_proof_valid() {
    local fingerprint main boot
    [ ! -f "$DB_DIR/cancel" ] && [ -s "$DB_RESERVE_PROOF" ] && [ -s "$DB_REPORT" ] || return 1
    db_validate_pair "$@" || return 1
    fingerprint="$(db_fingerprint)" || return 1
    main="$(db_endpoint_provider main "$1" "$3")" && boot="$(db_endpoint_provider bootstrap "${5:-udp}" "$4")" || return 1
    jq -e --arg p "$1" --arg id "$2" --arg server "$3" --arg bootstrap "$4" --arg bp "${5:-udp}" --arg fingerprint "$fingerprint" \
      --arg main "$main" --arg boot "$boot" --argjson now "$(date +%s)" --slurpfile report "$DB_REPORT" '
      .pair as $pair | $report[0] as $r |
      .fingerprint==$fingerprint and .reportId==$r.reportId and
      (.testedAt|type)=="number" and .testedAt>0 and (.testedAt|floor==.) and .testedAt<=$now and
      $r.action=="recommend_reserve" and $r.state=="done" and $r.reserve==true and $r.selectionComplete==true and
      $r.fullVerificationComplete==true and $r.measurementProfile=="full" and
      $pair.protocol==$p and $pair.id==$id and $pair.dnsServer==$server and $pair.bootstrapDnsServer==$bootstrap and $pair.bootstrapProtocol==$bp and
      $pair.success==true and $pair.stats.reliable==true and $pair.rechecked==true and $pair.automaticEligible==true and
      $pair.measurementProfile=="full" and $pair==$r.recommendation and $pair==$r.pairResult and any($r.fullVerificationResults[]; .==$pair) and
      $pair.bootstrapTest.success==true and $pair.bootstrapTest.protocol==$bp and $pair.bootstrapTest.server==$bootstrap and
      $pair.bootstrapTest==$r.recommendationBootstrapTest and $main!=$boot and
      $pair.mainFamily==$main and $pair.bootstrapFamily==$boot and
      $main!=$r.currentPrimaryProvider and $main!=$r.currentBootstrapProvider and
      $boot!=$r.currentPrimaryProvider and $boot!=$r.currentBootstrapProvider' "$DB_RESERVE_PROOF" >/dev/null
}
db_make_config() {
    local protocol="$1" server="$2" bootstrap="$3" out="$4" bp="${5:-udp}" kind="${6:-main}" main boot
    main="$(dns_catalog_endpoint "$protocol" "$server" "$kind")" || return 1
    boot="$(dns_catalog_endpoint "$bp" "$bootstrap" bootstrap)" || return 1
    printf '%s' "$main" | jq -e '.port|type=="number" and .>=1 and .<=65535 and floor==.' >/dev/null || return 1
    printf '%s' "$boot" | jq -e '.port|type=="number" and .>=1 and .<=65535 and floor==.' >/dev/null || return 1
    is_ipv4 "$(printf '%s' "$boot" | jq -r '.host')" || return 1
    jq -cn --arg protocol "$protocol" --arg bp "$bp" --argjson main "$main" --argjson boot "$boot" \
      --argjson dnsPort "$DB_DNS_PORT" --argjson proxyPort "$DB_PROXY_PORT" \
      'def server($protocol;$endpoint;$tag): {type:({udp:"udp",tcp:"tcp",doh:"https",dot:"tls"}[$protocol]),tag:$tag,server:$endpoint.host,server_port:$endpoint.port} + (if $protocol=="doh" then {path:($endpoint.path//"/dns-query")} else {} end) + (if $endpoint.server_name then {tls:{enabled:true,server_name:$endpoint.server_name}} else {} end);
      {log:{level:"error"},dns:{disable_cache:true,servers:[server($bp;$boot;"bootstrap"),
      (server($protocol;$main;"main")+{domain_resolver:"bootstrap"})],final:"main",strategy:"ipv4_only"},
      inbounds:[{type:"direct",tag:"dns-in",listen:"127.0.0.1",listen_port:$dnsPort,network:"udp"},{type:"mixed",tag:"http-in",listen:"127.0.0.1",listen_port:$proxyPort}],
      outbounds:[{type:"direct",tag:"direct",domain_resolver:"main"}],route:{default_mark:2097152,default_domain_resolver:"main",rules:[{inbound:["dns-in"],action:"hijack-dns"}],final:"direct"}}' > "$out"
    chmod 600 "$out"
}

db_runtime_path() {
    local path
    path="$(uci -q get podkop.settings.config_path 2>/dev/null || true)"
    printf '%s\n' "${path:-/etc/sing-box/config.json}"
}

# Secret remains in a mode-600 file, never in curl arguments or logs.
db_snapshot_choices() {
    local runtime="$1" out="$2" controller host port headers
    if ! jq -e '.outbounds|any(.type=="selector" or .type=="urltest")' "$runtime" >/dev/null; then printf '{"proxies":{}}\n' > "$out"; return 0; fi
    controller="$(jq -r '.experimental.clash_api.external_controller//empty' "$runtime")"
    host="${controller%:*}"; port="${controller##*:}"
    case "$port" in ''|*[!0-9]*) return 1;; esac
    case "$host" in 0.0.0.0) host=127.0.0.1;; 127.0.0.1|localhost) :;; *)
      is_ipv4 "$host" && ip -o -4 addr show | awk -v host="$host" '{split($4,a,"/");if(a[1]==host)found=1} END{exit !found}' || return 1;; esac
    headers="$(mktemp "$DB_DIR/auth.XXXXXX")"; chmod 600 "$headers"
    jq -r 'if (.experimental.clash_api.secret//"")=="" then empty else "Authorization: Bearer "+.experimental.clash_api.secret end' "$runtime" > "$headers"
    local result=0
    (unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy NO_PROXY no_proxy; db_bounded_command curl -fsS --noproxy '*' --connect-timeout 2 --max-time 5 --max-filesize 524288 --header "@$headers" -o "$out" "http://$host:$port/proxies" 2>/dev/null) || result=1
    rm -f "$headers"
    [ "$result" = 0 ] && jq -e '.proxies|type=="object"' "$out" >/dev/null
}

db_inline_runtime() {
    local runtime="$1" expanded="$2" source tag format previous_error="$db_child_error"
    db_resource_admit || return 1
    db_source_admit "$runtime" || return 1
    cp "$runtime" "$expanded" || return 1
    db_child_error=unsupported_ruleset_routing
    # Source JSON is inspectable. Inline a private snapshot so the same client
    # predicate checks apply to it and children never read mutable live files.
    jq -r '(.route.rule_set//[])[]|select(.type=="local")|[.tag,.format,.path]|join("|")' "$runtime" > "$expanded.list"
    while IFS='|' read -r tag format source; do
        db_resource_admit || return 1
        [ "$format" = source ] && [ -s "$source" ] || { rm -f "$expanded" "$expanded.list"; return 1; }
        db_source_admit "$source" || return 1
        jq -e '.rules|type=="array"' "$source" >/dev/null || return 1
        jq --arg tag "$tag" --slurpfile source "$source" '.route.rule_set|=map(if .tag==$tag then {type:"inline",tag:$tag,rules:$source[0].rules} else . end)' "$expanded" > "$expanded.tmp" || return 1
        mv "$expanded.tmp" "$expanded"
    done < "$expanded.list"
    rm -f "$expanded.list"
    db_child_error="$previous_error"
}

db_prepare_runtime_cache() {
    local fingerprint="$1" runtime key prepared main port
    DB_PREPARED_DIR="$db_work/prepared-$fingerprint"
    mkdir -p "$DB_PREPARED_DIR" || return 1
    main="$(db_runtime_path)"
    # Leave the existing runtime-unavailable failure to the pair path.
    if [ ! -s "$main" ]; then DB_PREPARED_DIR=''; return 0; fi
    for runtime in "$main" $(db_worker_configs); do
        [ -s "$runtime" ] || continue
        db_runtime_safe || return 1
        if [ "$runtime" != "$main" ]; then
            # An installed but unreferenced section is not cloned by a pair;
            # do not let its unsupported local rules reject a recommendation.
            port="$(jq -r '.inbounds[0].listen_port//empty' "$runtime")"
            case "$port" in ''|*[!0-9]*) continue;; esac
            jq -e --argjson port "$port" '
              ([.route.final, (.route.rules//[]|map(select(.inbound!="main-mixed-in"))|..|objects|.outbound? // empty),
                (.outbounds[]|.detour? // empty), (.outbounds[]|.outbounds[]?)]|map(select(.!=null))) as $refs |
              .outbounds|any(. as $o|.type=="socks" and .server=="127.0.0.1" and
                .server_port==$port and ($refs|index($o.tag))!=null)
            ' "$main" >/dev/null || continue
        fi
        key="$(printf '%s' "$runtime" | sha256sum | awk '{print $1}')"
        prepared="$DB_PREPARED_DIR/$key.json"
        db_inline_runtime "$runtime" "$prepared.tmp" || return 1
        mv "$prepared.tmp" "$prepared" || return 1
        chmod 600 "$prepared"
    done
}

db_clone_runtime() {
    local runtime="$6" expanded="$4.source" key result
    if db_is_recommend && [ -n "$DB_PREPARED_DIR" ]; then
        key="$(printf '%s' "$runtime" | sha256sum | awk '{print $1}')"
        if [ -s "$DB_PREPARED_DIR/$key.json" ]; then
            cp "$DB_PREPARED_DIR/$key.json" "$expanded" || return 1
        else
            # A missed cache entry keeps the original conservative clone path.
            db_inline_runtime "$runtime" "$expanded" || return 1
        fi
    else
        db_inline_runtime "$runtime" "$expanded" || return 1
    fi
    db_clone_runtime_raw "$1" "$2" "$3" "$4" "$5" "$expanded" "$7"
    result=$?
    rm -f "$expanded"
    return "$result"
}

db_clone_runtime_raw() {
    local protocol="$1" server="$2" bootstrap="$3" out="$4" bp="${5:-udp}" runtime="$6" choices="$7" cache='null' source snapshot
    db_resource_admit || return 1
    db_child_error=runtime_clone_unsupported
    jq -e '(.endpoints//[]|length)==0 and (.outbounds|type)=="array" and (.route|type)=="object" and (.dns.servers|type)=="array"' "$runtime" >/dev/null || return 1
    # Loopback SOCKS cannot reproduce a LAN client's identity, source address,
    # process or incoming interface. Never allow such rules to fall through to
    # a different outbound and falsely certify the current client routing.
    db_child_error=unsupported_client_routing
    jq -e '
      def client_sensitive:
        any(..|objects;
          any(keys[]; . as $key | startswith("source_") or startswith("process_") or
            (["package_name","user","user_id","auth_user","network_type","network_is_expensive","network_is_constrained","wifi_ssid","wifi_bssid","interface_name","interface_address","default_interface_address","rule_set_ip_cidr_match_source","rule_set_ipcidr_match_source","clash_mode"]|index($key))!=null) or
          (has("inbound") and ([.inbound]|flatten|any(.!="tproxy-in" and .!="dns-in" and .!="http-in" and .!="main-mixed-in" and .!="section-in"))));
      [.route.rules//[],.route.rule_set//[],.dns.rules//[]] | client_sensitive | not
      ' "$runtime" >/dev/null || return 1
    # Opaque SRS contents cannot be checked for client predicates here. Only
    # the native community destination datasets from main.js DOMAIN_LIST_OPTIONS
    # are trusted; this is an explicit source boundary, not content proof.
    db_child_error=unsupported_ruleset_routing
    jq -e '
      ["russia_inside","russia_outside","ukraine_inside","geoblock","block","porn","news","anime","youtube","discord","meta","twitter","hdrezka","tiktok","telegram","cloudflare","google_ai","google_play","hodca","roblox","hetzner","ovh","digitalocean","cloudfront"] as $communities |
      "https://github.com/itdoginfo/allow-domains/releases/latest/download/" as $prefix |
      all((.route.rule_set//[])[];
        . as $ruleset | .type=="inline" or
        (.type=="remote" and .format=="binary" and (.tag|type)=="string" and
          any($communities[]; . as $community |
            $ruleset.url==($prefix+$community+".srs") and
            ($ruleset.tag|endswith("-"+$community+"-community-ruleset")))))
      ' "$runtime" >/dev/null || return 1
    db_make_config "$protocol" "$server" "$bootstrap" "$out.dns" "$bp" || { db_child_error=invalid_endpoint; return 1; }
    if jq -e '.route.rule_set//[]|any(.type=="remote")' "$runtime" >/dev/null; then
        # Remote rules are loaded from a private copy of the CURRENT cache.
        # No process ever writes the production BoltDB cache or opens Clash.
        db_child_error=rules_cache_unavailable
        source="$(jq -r 'if .experimental.cache_file.enabled==true then .experimental.cache_file.path//empty else empty end' "$runtime")"
        case "$source" in /*) :;; *) rm -f "$out.dns"; return 1;; esac
        [ -s "$source" ] || { rm -f "$out.dns"; return 1; }
        db_source_admit "$source" || return 1
        snapshot="$out.rules-cache.snapshot"
        db_resource_admit || return 1
        if [ ! -s "$snapshot" ]; then cp "$source" "$snapshot" || { rm -f "$out.dns"; return 1; }; chmod 600 "$snapshot"; fi
        cp "$snapshot" "$out.cache.db" || { rm -f "$out.dns"; return 1; }
        chmod 600 "$out.cache.db"
        cache="$(jq -cn --arg path "$out.cache.db" --slurpfile runtime "$runtime" '{cache_file:({enabled:true,path:$path,store_fakeip:false,store_rdrc:false}+ (if $runtime[0].experimental.cache_file.cache_id then {cache_id:$runtime[0].experimental.cache_file.cache_id} else {} end))}')"
    fi
    db_child_error=active_selection_unavailable
    jq -e --slurpfile choices "$choices" --slurpfile candidate "$out.dns" --argjson cache "$cache" '
      def remap_inbound: if type=="string" then if .=="tproxy-in" or .=="section-in" then "http-in" else . end else map(if .=="tproxy-in" or .=="section-in" then "http-in" else . end) end;
      .route.rules=((.route.rules//[])|map(if has("inbound") then if (.inbound|type)=="string" then select(.inbound!="main-mixed-in") else .inbound|=map(select(.!="main-mixed-in"))|select(.inbound|length>0) end else . end)) |
      (.dns.final//"dns-server") as $main |
      [(.dns.servers[]|select(.tag!="bootstrap")|.tag)] as $old |
      .outbounds |= map(if .type=="selector" or .type=="urltest" then
        . as $group | ($choices[0].proxies[.tag].now//"") as $now |
        if ($now!="" and (.outbounds|index($now))!=null) then
          .type="selector" | .default=$now | del(.url,.interval,.tolerance,.idle_timeout)
        else error("active_selection_unavailable") end
      else . end) |
      (if (.experimental//{}|has("utls_fallback")) then {utls_fallback:.experimental.utls_fallback} else {} end) as $fallback |
      del(.experimental,.endpoints) | (if $cache!=null or ($fallback|length)>0 then .experimental=(($cache//{})+$fallback) else . end) | .log={level:"error"} |
      .inbounds=$candidate[0].inbounds |
      .dns.servers=($candidate[0].dns.servers|map(if .tag=="main" then .tag=$main else . end)) |
      .dns.final=$main | .dns.disable_cache=true | del(.dns.fakeip) |
      walk(if type=="object" then
        (if has("inbound") then .inbound|=remap_inbound else . end) |
        (.domain_resolver//null) as $resolver | (if ($resolver|type)=="string" and ($old|index($resolver)) then .domain_resolver=$main else . end)
      else . end) |
      .dns.rules=( (.dns.rules//[]) | map(walk(if type=="object" then (.server//null) as $server | if $server!=null and ($old|index($server)) then .server=$main else . end else . end))) |
      .route.default_domain_resolver=$main | .route.default_mark=2097152 |
      .route.rules=([{inbound:["dns-in"],action:"hijack-dns"}]+(.route.rules//[]))
      ' "$runtime" > "$out" 2>/dev/null || { rm -f "$out.dns" "$out"; return 1; }
    chmod 600 "$out"; rm -f "$out.dns"
}

db_make_pair_config() {
    local runtime worker section port index=0 dns_port="$DB_DNS_PORT" proxy_port="$DB_PROXY_PORT" rows='[]' row new_dns new_proxy
    runtime="$(db_runtime_path)"
    db_child_error=runtime_config_unavailable
    [ -s "$runtime" ] || return 1
    db_child_error=active_selection_unavailable
    db_snapshot_choices "$runtime" "$db_work/choices.json" || return 1
    db_clone_runtime "$1" "$2" "$3" "$4" "${5:-udp}" "$runtime" "$db_work/choices.json" || return 1
    # Remove orphan local relays only when no rule/final/detour/group references
    # them. Every reachable relay must be a known isolated section worker.
    jq '([.route.final, (.route.rules//[]|..|objects|.outbound? // empty), (.outbounds[]|.detour? // empty), (.outbounds[]|.outbounds[]?)]|map(select(.!=null))) as $refs | .outbounds|=map(select(. as $o|(.type!="socks" or (["127.0.0.1","localhost","::1"]|index($o.server))==null) or ($refs|index($o.tag))!=null))' "$4" > "$4.tmp" || return 1; mv "$4.tmp" "$4"
    for worker in $(db_worker_configs); do
        [ -s "$worker" ] || continue
        section="${worker%/worker.json}"; section="${section##*/}"
        case "$section" in ''|*[!A-Za-z0-9_-]*) db_child_error=unsupported_section_runtime; return 1;; esac
        db_child_error=unsupported_section_runtime
        jq -e '(.inbounds|length)==1 and .inbounds[0].type=="mixed" and .inbounds[0].listen=="127.0.0.1" and (.inbounds[0].listen_port|type)=="number"' "$worker" >/dev/null || return 1
        port="$(jq -r '.inbounds[0].listen_port' "$worker")"
        if ! jq -e --argjson port "$port" '.outbounds|any(.type=="socks" and .server=="127.0.0.1" and .server_port==$port)' "$4" >/dev/null; then continue; fi
        index=$((index+1)); [ "$index" -le 20 ] || return 1
        jq -e '.outbounds|all(. as $o|(.type!="socks" and .type!="http") or (["127.0.0.1","localhost","::1"]|index($o.server))==null)' "$worker" >/dev/null || return 1
        db_snapshot_choices "$worker" "$db_work/section-$section.choices" || { db_child_error=active_selection_unavailable; return 1; }
        new_dns=$((db_section_port_base+2*index)); new_proxy=$((db_section_port_base+1+2*index))
        DB_DNS_PORT="$new_dns"; DB_PROXY_PORT="$new_proxy"
        if ! db_clone_runtime "$1" "$2" "$3" "$db_work/section-$section.json" "${5:-udp}" "$worker" "$db_work/section-$section.choices"; then DB_DNS_PORT="$dns_port"; DB_PROXY_PORT="$proxy_port"; return 1; fi
        DB_DNS_PORT="$dns_port"; DB_PROXY_PORT="$proxy_port"
        jq --argjson old "$port" --argjson new "$new_proxy" '.outbounds|=map(if .type=="socks" and .server=="127.0.0.1" and .server_port==$old then .server_port=$new else . end)' "$4" > "$4.tmp"; mv "$4.tmp" "$4"
        row="$(jq -cn --arg section "$section" --arg config "$db_work/section-$section.json" --argjson dnsPort "$new_dns" --argjson proxyPort "$new_proxy" '{section:$section,config:$config,dnsPort:$dnsPort,proxyPort:$proxyPort}')"
        rows="$(jq -cn --argjson rows "$rows" --argjson row "$row" '$rows+[$row]')"
    done
    DB_DNS_PORT="$dns_port"; DB_PROXY_PORT="$proxy_port"
    db_child_error=unsupported_section_runtime
    # Never forward hostname resolution into an unchanged production worker.
    jq -e --argjson rows "$rows" '.outbounds|all(. as $o|(.type!="socks" and .type!="http") or (["127.0.0.1","localhost","::1"]|index($o.server))==null or (.type=="socks" and any($rows[];.proxyPort==$o.server_port)))' "$4" >/dev/null || return 1
    printf '%s\n' "$rows" > "$db_work/sections.json"
    db_tested_sections="$(jq -c --argjson rows "$rows" '([.route.rules[]?|.outbound? // empty|select(.!="direct-out" and endswith("-out"))|rtrimstr("-out")]+[$rows[].section])|unique' "$4")"
    chmod 600 "$db_work"/section-* "$db_work/sections.json" "$4" 2>/dev/null || true
}

db_runtime_safe() {
    local available pid floor=98304
    [ "${db_native_mode:-0}" != 1 ] || floor=16384
    if [ -n "$db_resource_error_file" ] && [ -s "$db_resource_error_file" ]; then read -r db_child_error < "$db_resource_error_file"; return 1; fi
    if [ -n "$db_resource_watch_pid" ]; then kill -0 "$db_resource_watch_pid" 2>/dev/null || { db_child_error=child_stopped; return 1; }; fi
    db_production_safe || return 1
    [ ! -f "$db_cancel_file" ] || { db_child_error=cancelled; return 1; }
    if [ "${db_light_policy:-0}" = 1 ]; then
        diag_remaining >/dev/null || { db_child_error=measurement_timeout; return 1; }
        diag_admit 0 || { db_child_error=memory_pressure; return 1; }
    fi
    [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || { db_child_error=measurement_timeout; return 1; }
    [ "$db_probe_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_probe_deadline" ] || { db_child_error=pair_budget_exceeded; return 1; }
    available="$(awk '/MemAvailable:/ {print $2}' "${PODKOP_DNS_BENCHMARK_MEMINFO_FILE:-/proc/meminfo}")"
    [ -n "$available" ] && [ "$available" -ge "$floor" ] || { db_child_error=memory_pressure; return 1; }
    for pid in $db_section_pids; do kill -0 "$pid" 2>/dev/null || { db_child_error=child_stopped; return 1; }; done
}

db_pid_start() {
    local stat rest
    case "$1" in ''|*[!0-9]*) return 1;; esac
    read -r stat 2>/dev/null < "/proc/$1/stat" || return 1
    rest="${stat##*) }"; set -- $rest
    [ "$#" -ge 20 ] || return 1
    shift 19; printf '%s\n' "$1"
}
db_coordinator_identity() {
    local pid="$1" start
    case "$pid" in ''|*[!0-9]*|0) return 1;; esac
    start="$(db_pid_start "$pid")" || return 1
    case "$start" in ''|*[!0-9]*) return 1;; esac
    printf '%s:%s\n' "$pid" "$start"
}
db_coordinator_cmdline() {
    local pid="$1" action="$2"
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | awk -v self="$DB_SELF" -v action="$action" '
      NR==1 {shell=($0=="sh" || $0=="ash" || $0 ~ /\/(sh|ash)$/)}
      NR==2 {script=($0==self)} NR==3 {worker=($0=="__worker")}
      NR==4 {operation=($0==action)} END {exit !(shell && script && worker && operation)}'
}
db_coordinator_owned() {
    local pid="$1" action="$2" identity
    [ "$(cat "$DB_LOCK/owner" 2>/dev/null)" = "$pid" ] || return 1
    identity="$(db_coordinator_identity "$pid")" || return 1
    [ "$(cat "$DB_LOCK/identity" 2>/dev/null)" = "$identity" ] || return 1
    db_coordinator_cmdline "$pid" "$action"
}
db_production_capture() {
    local pid start
    [ -z "$db_production_file" ] || { db_production_safe; return; }
    command -v pidof >/dev/null || { db_child_error=production_stopped; return 1; }
    db_production_file="$DB_DIR/production-baseline"
    : > "$db_production_file.tmp.$$"
    for pid in $(pidof sing-box 2>/dev/null || true); do
        start="$(db_pid_start "$pid")" || { db_child_error=production_stopped; return 1; }
        printf '%s %s\n' "$pid" "$start" >> "$db_production_file.tmp.$$"
    done
    [ -s "$db_production_file.tmp.$$" ] || { db_child_error=production_stopped; return 1; }
    chmod 600 "$db_production_file.tmp.$$"
    mv "$db_production_file.tmp.$$" "$db_production_file"
}
db_production_safe() {
    local pid start current
    [ -n "$db_production_file" ] || return 0
    [ -s "$db_production_file" ] || { db_child_error=production_stopped; return 1; }
    while read -r pid start; do
        current="$(db_pid_start "$pid")" || current=''
        [ -n "$start" ] && [ "$current" = "$start" ] || { db_child_error=production_stopped; return 1; }
    done < "$db_production_file"
}
db_resource_register() {
    local start
    start="$(db_pid_start "$1")" || return 1
    printf '%s %s\n' "$1" "$start" >> "$db_resource_owned_file"
}
db_resource_stop_registered() {
    local parent="$1" pid start current key value ignored owned
    while read -r pid start; do
        current="$(db_pid_start "$pid")" || continue
        [ "$current" = "$start" ] || continue
        owned=false
        while read -r key value ignored; do
            if [ "$key" = PPid: ]; then [ "$value" != "$parent" ] || owned=true; break; fi
        done 2>/dev/null < "/proc/$pid/status" || continue
        [ "$owned" = true ] || continue
        kill -TERM "$pid" 2>/dev/null || true
        current="$(db_pid_start "$pid")" || continue
        [ "$current" != "$start" ] || kill -KILL "$pid" 2>/dev/null || true
    done < "$db_resource_owned_file"
}
db_resource_watch_start() {
    local parent ignored parent_start
    db_production_capture || return 1
    db_resource_error_file="$DB_DIR/resource-error"
    db_resource_owned_file="$DB_DIR/resource-owned"
    rm -f "$db_resource_error_file"; : > "$db_resource_owned_file"
    read -r parent ignored < /proc/self/stat
    parent_start="$(db_pid_start "$parent")" || return 1
    (
        # A watcher must never inherit the coordinator's destructive EXIT
        # cleanup or its mutation-recovery signal handler.
        trap - EXIT INT TERM HUP
        while :; do
            [ "$(db_pid_start "$parent" 2>/dev/null || true)" = "$parent_start" ] || break
            if db_runtime_safe; then sleep 1; continue; fi
            printf '%s\n' "$db_child_error" > "$db_resource_error_file.tmp"
            mv "$db_resource_error_file.tmp" "$db_resource_error_file"
            db_resource_stop_registered "$parent"
            break
        done
    ) &
    db_resource_watch_pid=$!
    db_owned_child "$db_resource_watch_pid" || { db_child_error=child_start_failed; return 1; }
}
db_check_config() {
    local until now state result=0
    db_resource_admit || return 1
    [ -n "$db_resource_watch_pid" ] && db_owned_child "$db_resource_watch_pid" || { db_child_error=child_start_failed; return 1; }
    until=$(( $(date +%s)+20 ))
    (trap - EXIT INT TERM HUP; db_private_oom_priority || exit 125; unset SING_BOX_DNS_FALLBACK SING_BOX_RULESET_RECOVERED_HOOK; exec nice -n 19 "$DB_BIN" check -c "$1") > "$db_work/check.log" 2>&1 &
    db_check_pid=$!
    db_check_start="$(db_pid_start "$db_check_pid")" || { db_check_stop; db_child_error=child_start_failed; return 1; }
    db_resource_register "$db_check_pid" || { db_check_stop; db_child_error=child_start_failed; return 1; }
    while kill -0 "$db_check_pid" 2>/dev/null; do
        if ! db_runtime_safe; then db_check_stop; return 1; fi
        now="$(date +%s)"
        if [ "$now" -ge "$until" ]; then db_child_error=measurement_timeout; db_check_stop; return 1; fi
        state="$(awk '/^State:/{print $2}' "/proc/$db_check_pid/status" 2>/dev/null || true)"
        [ "$state" != Z ] || break
        sleep 1
    done
    wait "$db_check_pid" || result=$?
    db_check_pid=''; db_check_start=''
    db_runtime_safe || return 1
    [ "$result" = 0 ] || { db_child_error=child_config_invalid; return 1; }
}
db_check_stop() {
    [ -n "$db_check_pid" ] || return 0
    if [ -n "$db_check_start" ] && [ "$(db_pid_start "$db_check_pid" || true)" = "$db_check_start" ]; then
        db_owned_child "$db_check_pid" && kill -TERM "$db_check_pid" 2>/dev/null || true
        [ "$(db_pid_start "$db_check_pid" || true)" != "$db_check_start" ] || { db_owned_child "$db_check_pid" && kill -KILL "$db_check_pid" 2>/dev/null || true; }
    fi
    wait "$db_check_pid" 2>/dev/null || true; db_check_pid=''; db_check_start=''
}
db_private_oom_priority() {
    local score
    # Call ONLY in a private child subshell immediately before exec. This is
    # victim-selection preference, not a memory cap or protection guarantee.
    if ! printf '1000\n' 2>/dev/null > /proc/self/oom_score_adj ||
       ! read -r score 2>/dev/null < /proc/self/oom_score_adj || [ "$score" != 1000 ]; then
        if [ -n "$db_resource_error_file" ]; then
            printf '%s\n' private_oom_unavailable > "$db_resource_error_file.tmp.$$" &&
                mv "$db_resource_error_file.tmp.$$" "$db_resource_error_file"
        fi
        return 1
    fi
}
# timeout is optional on OpenWrt. Otherwise retain native dig/curl limits,
# shortened to the remaining budget; never target a production process group.
db_bounded_command() {
    local remaining argument limit previous=''
    if [ "$db_deadline" -gt 0 ]; then remaining=$((db_deadline-$(date +%s))); else remaining=180; fi
    if [ "$db_probe_deadline" -gt 0 ] && [ "$((db_probe_deadline-$(date +%s)))" -lt "$remaining" ]; then remaining=$((db_probe_deadline-$(date +%s))); fi
    [ "$remaining" -gt 0 ] || { db_child_error=measurement_timeout; return 1; }
    if command -v timeout >/dev/null 2>&1; then timeout "$remaining" "$@"; return; fi
    case "$1" in
      curl)
        limit="$remaining"
        for argument in "$@"; do
            if [ "$previous" = --max-time ] && [ "$argument" -lt "$limit" ]; then limit="$argument"; fi
            previous="$argument"
        done
        "$@" --max-time "$limit";;
      dig)
        [ "$remaining" -le 2 ] || remaining=2
        "$@" "+timeout=$remaining";;
      *) db_child_error=deadline_runner_unavailable; return 1;;
    esac
}

# Reserve production memory before allocating JSON/cache copies or starting Go.
# This is admission, not an assertion that a soft Go heap limit prevents OOM.
db_resource_admit() {
    local required="${1:-147456}" available
    db_runtime_safe || return 1
    available="$(awk '/MemAvailable:/ {print $2}' "${PODKOP_DNS_BENCHMARK_MEMINFO_FILE:-/proc/meminfo}")"
    case "$available" in ''|*[!0-9]*) db_child_error=memory_pressure; return 1;; esac
    [ "$available" -ge "$required" ] || { db_child_error=memory_pressure; return 1; }
}
db_source_admit() {
    local size
    size="$(wc -c < "$1")" || return 1
    # Bound private tmpfs growth before copying/inlining a production input.
    [ "$size" -le 16777216 ] || { db_child_error=memory_pressure; return 1; }
}

db_owned_child() {
    local pid="$1" owner ignored key value
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    # $$ is not the actual PID inside POSIX subshells. These builtin reads
    # avoid spawning a process during the ownership check before signalling.
    read -r owner ignored < /proc/self/stat || return 1
    [ -r "/proc/$pid/status" ] || return 1
    while read -r key value ignored; do
        if [ "$key" = PPid: ]; then [ "$value" = "$owner" ]; return; fi
    done 2>/dev/null < "/proc/$pid/status" || return 1
    return 1
}
db_child_stop() {
    local attempts=0 section_pid
    if [ -n "$db_resource_watch_pid" ]; then db_owned_child "$db_resource_watch_pid" && kill "$db_resource_watch_pid" 2>/dev/null || true; wait "$db_resource_watch_pid" 2>/dev/null || true; db_resource_watch_pid=''; fi
    db_check_stop
    for section_pid in $db_section_pids; do db_owned_child "$section_pid" && kill "$section_pid" 2>/dev/null || true; done
    if [ -n "$db_child_pid" ]; then
        db_owned_child "$db_child_pid" && kill "$db_child_pid" 2>/dev/null || true
        while db_owned_child "$db_child_pid" && kill -0 "$db_child_pid" 2>/dev/null && [ "$attempts" -lt 3 ]; do
            if db_is_recommend && [ "$(date +%s)" -ge "$db_deadline" ]; then break; fi
            sleep 1; attempts=$((attempts+1))
        done
        db_owned_child "$db_child_pid" && kill -KILL "$db_child_pid" 2>/dev/null || true
        wait "$db_child_pid" 2>/dev/null || true; db_child_pid=''
    fi
    for section_pid in $db_section_pids; do db_owned_child "$section_pid" && kill -KILL "$section_pid" 2>/dev/null || true; wait "$section_pid" 2>/dev/null || true; done
    db_section_pids=''
    rm -f "$DB_DIR/child.pid"
}
db_child_start() {
    db_native_mode=0
    local tries=0 mode="${5:-individual}" bp="${4:-udp}" available config dns proxy count=0
    db_child_stop
    db_child_error=netstat_unavailable
    command -v netstat >/dev/null 2>&1 || return 1
    db_child_error=insufficient_memory
    available="$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)"
    db_resource_admit || return 1
    if [ "$mode" = pair ]; then
        count="$(db_worker_configs | wc -l)"
        db_resource_admit "$((98304+49152+count*24576))" || return 1
    fi
    db_resource_watch_start || return 1
    # Refuse a pre-existing listener rather than attributing its DNS responses
    # to our child. netstat is provided by the supported OpenWrt base image.
    db_child_error=listener_collision
    if netstat -ln 2>/dev/null | awk -v dns=":$DB_DNS_PORT" -v proxy=":$DB_PROXY_PORT" '$4 ~ (dns "$") || $4 ~ (proxy "$") {found=1} END {exit !found}'; then return 1; fi
    if [ "$mode" = pair ]; then db_make_pair_config "$1" "$2" "$3" "$db_work/child.json" "$bp" || return 1
    elif [ "$mode" = bootstrap ]; then db_child_error=invalid_endpoint; db_make_config "$1" "$2" "$3" "$db_work/child.json" "$bp" bootstrap || return 1
    else db_child_error=invalid_endpoint; db_make_config "$1" "$2" "$3" "$db_work/child.json" "$bp" || return 1; fi
    if [ "$mode" = pair ] && [ -s "$db_work/sections.json" ]; then
        count="$(jq length "$db_work/sections.json")"
        db_child_error=insufficient_memory
        [ "$available" -ge "$((131072+count*24576))" ] || return 1
        jq -r '.[]|[.config,.dnsPort,.proxyPort]|join("|")' "$db_work/sections.json" > "$db_work/section-configs"
        while IFS='|' read -r config dns proxy; do
            db_child_error=listener_collision
            if netstat -ln 2>/dev/null | awk -v dns=":$dns" -v proxy=":$proxy" '$4 ~ (dns "$") || $4 ~ (proxy "$") {found=1} END {exit !found}'; then return 1; fi
            db_child_error=child_config_invalid
            db_resource_admit || return 1
            db_check_config "$config" || return 1
        done < "$db_work/section-configs"
    fi
    db_child_error=child_config_invalid
    db_resource_admit || return 1
    db_check_config "$db_work/child.json" || return 1
    if [ "$mode" = pair ] && [ -s "$db_work/section-configs" ]; then
        while IFS='|' read -r config dns proxy; do
            db_resource_admit || return 1
            # Structured probe failures remain in the report; do not retain an
            # unbounded Go log in the router's memory-backed filesystem.
            (trap - EXIT INT TERM HUP; db_private_oom_priority || exit 125; unset SING_BOX_DNS_FALLBACK SING_BOX_RULESET_RECOVERED_HOOK; exec nice -n 19 "$DB_BIN" run -c "$config") > /dev/null 2>&1 &
            db_section_pids="$db_section_pids $!"
            db_resource_register "$!" || { db_child_error=child_start_failed; return 1; }
        done < "$db_work/section-configs"
    fi
    db_resource_admit || return 1
    (trap - EXIT INT TERM HUP; db_private_oom_priority || exit 125; unset SING_BOX_DNS_FALLBACK SING_BOX_RULESET_RECOVERED_HOOK; exec nice -n 19 "$DB_BIN" run -c "$db_work/child.json") > /dev/null 2>&1 &
    db_child_pid=$!; printf '%s\n' "$db_child_pid" > "$DB_DIR/child.pid"
    db_resource_register "$db_child_pid" || { db_child_error=child_start_failed; return 1; }
    sleep 1
    db_child_error=child_start_failed
    while [ "$tries" -lt 5 ]; do
        db_runtime_safe || return 1
        [ ! -f "$db_cancel_file" ] || { db_child_error=cancelled; return 1; }
        [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || { db_child_error=measurement_timeout; return 1; }
        kill -0 "$db_child_pid" 2>/dev/null || return 1
        if db_bounded_command dig @127.0.0.1 -p "$DB_DNS_PORT" example.com A +time=1 +tries=1 +short 2>/dev/null | grep -q '^[0-9]'; then kill -0 "$db_child_pid" 2>/dev/null; return; fi
        tries=$((tries+1)); sleep 1
    done
    db_child_error=child_dns_unavailable
    return 1
}
# Native endpoint probes are ordering evidence only: no private Go process,
# no cloned production graph, and no service-routing admission.
db_native_start() {
    local protocol="$1" server="$2" bootstrap="$3" bp="${4:-udp}" kind="${5:-main}" endpoint boot output address
    db_native_mode=1
    db_production_capture || return 1
    db_runtime_safe || return 1
    endpoint="$(dns_catalog_endpoint "$protocol" "$server" "$kind")" || return 1
    db_native_protocol="$protocol"
    db_native_host="$(printf '%s' "$endpoint" | jq -r '.host')"
    db_native_name="$(printf '%s' "$endpoint" | jq -r '.server_name//empty')"
    db_native_port="$(printf '%s' "$endpoint" | jq -r '.port')"
    db_native_path="$(printf '%s' "$endpoint" | jq -r '.path//"/dns-query"')"
    if ! is_ipv4 "$db_native_host"; then
        [ -n "$db_native_name" ] || db_native_name="$db_native_host"
        boot="$(dns_catalog_endpoint "$bp" "$bootstrap" bootstrap)" || return 1
        db_native_boot_host="$(printf '%s' "$boot" | jq -r '.host')"
        is_ipv4 "$db_native_boot_host" || return 1
        output="$(db_native_dig "$bp" "$db_native_boot_host" "$(printf '%s' "$boot" | jq -r '.port')" "$(printf '%s' "$boot" | jq -r '.server_name//empty')" "$(printf '%s' "$boot" | jq -r '.path//"/dns-query"')" "$db_native_host")" || return 1
        [ "$(printf '%s\n' "$output" | query_status)" = NOERROR ] || return 1
        db_native_host=''
        for address in $(printf '%s\n' "$output" | awk '$4=="A" {print $5}'); do
            if dns_answer_ipv4_is_usable "$db_native_boot_host" "$address"; then db_native_host="$address"; break; fi
        done
        is_ipv4 "$db_native_host" || return 1
    fi
}

db_native_command() (
    local pid watch start rc=0 limit=3
    if [ "${db_light_policy:-0}" = 1 ]; then
        limit="$(diag_request_limit)" || exit 1
        diag_admit 0 || exit 1
    fi
    "$@" & pid=$!
    start="$(db_pid_start "$pid")" || start=''
    trap '[ -z "$start" ] || [ "$(db_pid_start "$pid" 2>/dev/null)" != "$start" ] || { kill -TERM "$pid" 2>/dev/null || true; kill -KILL "$pid" 2>/dev/null || true; }; wait "$pid" 2>/dev/null || true; exit 130' INT TERM HUP
    (
        count=0
        while [ "$count" -lt "$limit" ]; do
            sleep 1; count=$((count+1))
            [ ! -f "$db_cancel_file" ] || break
            [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || break
            [ "$db_probe_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_probe_deadline" ] || break
            db_runtime_safe || break
        done
        [ -n "$start" ] && [ "$(db_pid_start "$pid" 2>/dev/null)" = "$start" ] || exit 0
        kill -TERM "$pid" 2>/dev/null || true; kill -KILL "$pid" 2>/dev/null || true
    ) >/dev/null 2>&1 & watch=$!
    wait "$pid" 2>/dev/null || rc=$?
    kill "$watch" 2>/dev/null || true; wait "$watch" 2>/dev/null || true
    exit "$rc"
)

db_native_dig() {
    local protocol="$1" host="$2" port="$3" name="$4" path="$5" domain="$6" limit=2
    if [ "${db_light_policy:-0}" = 1 ]; then
        limit="$(diag_request_limit)" || return 1
        [ "$limit" -le 2 ] || limit=2
    fi
    set -- dig "@$host" -p "$port" "$domain" A "+timeout=$limit" +tries=1 +stats
    case "$protocol" in udp) ;; tcp) set -- "$@" +tcp;;
      doh) set -- "$@" "+https=$path";; dot) set -- "$@" +tls;; *) return 1;; esac
    case "$protocol" in doh|dot) set -- "$@" +tls-ca; [ -z "$name" ] || set -- "$@" "+tls-hostname=$name";; esac
    db_native_command "$@"
}

db_query() {
    local output status ms
    db_runtime_safe || return 1
    if [ "${db_native_mode:-0}" = 1 ]; then
        output="$(db_native_dig "$db_native_protocol" "$db_native_host" "$db_native_port" "$db_native_name" "$db_native_path" "$1" 2>/dev/null)" || return 1
    else
        output="$(db_bounded_command dig @127.0.0.1 -p "$DB_DNS_PORT" "$1" A +timeout=2 +tries=1 +stats 2>/dev/null || true)"
    fi
    status="$(printf '%s\n' "$output" | query_status)"
    if [ "$status" = NXDOMAIN ]; then printf 'NXDOMAIN\n'; return 0; fi
    if [ "$status" != NOERROR ]; then printf 'ERROR|%s\n' "${status:-TIMEOUT}"; return 1; fi
    printf '%s\n' "$output" | dns_output_has_usable_a 1.1.1.1 || { printf 'ERROR|UNUSABLE_ANSWER\n'; return 1; }
    ms="$(printf '%s\n' "$output" | query_time)"; case "$ms" in ''|*[!0-9]*) return 1;; esac
    printf 'NOERROR|%s\n' "$ms"
}

# A retry is a fresh measurement, not permission to relax any pass criterion.
# Leave time for the retry's native timeout and its bookkeeping/cleanup.
db_retry_budget() {
    local remaining limit="$db_deadline"
    db_runtime_safe || return 1
    if [ "$db_probe_deadline" -gt 0 ] && { [ "$limit" -eq 0 ] || [ "$db_probe_deadline" -lt "$limit" ]; }; then limit="$db_probe_deadline"; fi
    [ "$limit" -gt 0 ] || return 0
    remaining=$((limit-$(date +%s)))
    [ "$remaining" -ge "$1" ]
}

db_sample_query() {
    local output initial recovered=false
    if output="$(db_query "$1")"; then printf '%s\n' "$output"; return 0; fi
    initial="$output"
    if [ "$initial" != 'ERROR|TIMEOUT' ] || ! db_retry_budget 3; then
        printf '%s\n' "$output"; return 1
    fi
    if output="$(db_query "$1")"; then
        case "$output" in NOERROR\|*) recovered=true;; esac
    else
        # Never let a failed command's success-looking stdout count as proof.
        case "$output" in NOERROR\|*) output='ERROR|INVALID_RESPONSE';; esac
    fi
    jq -cn --arg domain "$1" --arg initial "$initial" --arg final "$output" --argjson recovered "$recovered" \
      '{kind:"dns",domain:$domain,initialError:$initial,finalResult:$final,recovered:$recovered}' >> "$db_work/retries.jsonl"
    printf '%s\n' "$output"
    [ "$recovered" = true ]
}
db_query_progress() {
    [ ! -f "$db_cancel_file" ] || return 1
    [ -s "$DB_STATUS" ] || return 0
    jq --argjson completed "$1" --argjson total "$2" \
      'if .state=="running" then .queryCompleted=$completed | .queryTotal=$total |
      .progress=(if .action=="pair_test" and $total>0 then 10+(80*$completed/$total|floor) else .progress end) else . end' \
      "$DB_STATUS" > "$DB_STATUS.query.$$"
    mv "$DB_STATUS.query.$$" "$DB_STATUS"
}
db_measure() {
    local output domain n=0 successes=0 sum=0 ms error='' nx=false queries failed_queries='[]' repeats='1 2' repeat_count=2 sampled='null'
    # Both service groups and the old optimizer's selected-community probes stay
    # load-bearing. Each record is attempted twice to expose unstable resolvers.
    if [ "$db_measurement_profile" = minute_sample ] && [ -n "$db_sample_cache_dir" ] && [ -s "$db_sample_cache_dir/base-domains" ]; then
        cp "$db_sample_cache_dir/base-domains" "$db_work/domains"
    else
        write_compatibility_domains "$db_work/domains" "$db_work/community"
    fi
    if [ "$db_measurement_profile" = minute_sample ]; then
        # The exact same deterministic base sample is used for every pair and
        # its independent cold-start confirmation. Section probes follow below.
        awk -F '|' '$1=="base" && ($2=="google_play" || $2=="chatgpt") && !seen[$2]++ {print}' "$db_work/domains" > "$db_work/domains.sample"
        mv "$db_work/domains.sample" "$db_work/domains"
        repeats=1; repeat_count=1
        sampled="$(cut -d '|' -f3 "$db_work/domains" | jq -Rsc 'split("\n")|map(select(.!=""))')"
        [ "$(wc -l < "$db_work/domains")" = 2 ] || error=sample_scope_unverified
        if [ -z "$error" ] && [ -n "$db_sample_cache_dir" ]; then cp "$db_work/domains" "$db_sample_cache_dir/base-domains"; fi
    fi
    queries=$((repeat_count * $(wc -l < "$db_work/domains")+1))
    while IFS='|' read -r scope service domain; do
        [ -n "$domain" ] || continue
        for repeat in $repeats; do
            if ! db_runtime_safe; then error="$db_child_error"; break 2; fi
            if [ "$db_deadline" -gt 0 ] && [ "$(date +%s)" -ge "$db_deadline" ]; then error=measurement_timeout; break 2; fi
            [ ! -f "$db_cancel_file" ] || { error=cancelled; break 2; }
            n=$((n+1)); output="$(db_sample_query "$domain" || true)"
            db_query_progress "$n" "$queries" || { error=cancelled; break 2; }
            case "$output" in NOERROR\|*) successes=$((successes+1)); ms="${output#*|}"; sum=$((sum+ms));;
              *)
                failed_queries="$(jq -cn --argjson rows "$failed_queries" --arg domain "$domain" --arg scope "$scope" --arg error "${output:-ERROR|NO_RESPONSE}" '$rows+[{domain:$domain,scope:$scope,error:$error}]')"
                [ "$scope" = advisory ] || error=dns_query_failed;; esac
        done
        if db_is_recommend && [ "$error" = dns_query_failed ]; then break; fi
    done < "$db_work/domains"
    if [ "$error" != pair_budget_exceeded ] && [ "$error" != sample_scope_unverified ] && [ "$error" != measurement_timeout ] && [ "$error" != cancelled ] && { ! db_is_recommend || [ "$error" != dns_query_failed ]; }; then
        output="$(db_query "podkop-pe-$(date +%s)-$$.invalid" || true)"
        db_query_progress "$((n+1))" "$queries" || error=cancelled
        [ "$output" != NXDOMAIN ] || nx=true
        [ "$nx" = true ] || error=nxdomain_check_failed
    fi
    jq -cn --argjson successCount "$successes" --argjson totalQueries "$n" --argjson sum "$sum" --argjson nxdomainOk "$nx" --arg error "$error" --argjson failedQueries "$failed_queries" --arg profile "$db_measurement_profile" --argjson sampled "$sampled" \
      '{successCount:$successCount,totalQueries:$totalQueries,averageMs:(if $successCount>0 then $sum/$successCount else null end),nxdomainOk:$nxdomainOk,reliable:($error=="" and $successCount>0),failedQueries:$failedQueries,error:(if $error=="" then null else $error end)}+(if $profile=="minute_sample" then {measurementProfile:$profile,fullCompatibilityVerified:false,sampledDomains:$sampled} else {} end)'
}
db_transport_guards() {
    local url statuses policy code bytes file request_ok reason elapsed acceptable attempt endpoint_done=0 connect_timeout=5 request_timeout=12 curl_exit=0 first_exit=0 first_http=''
    file="$db_work/canary"
    rm -f "$DB_DIR/transport-error.json"
    if [ -n "${db_section_endpoints:-}" ]; then cp "$db_section_endpoints" "$db_work/endpoints"; else { google_play_transport_endpoints | sed 's/$/|200 206|required/'; chatgpt_transport_endpoints; } > "$db_work/endpoints"; fi
    if [ "$db_measurement_profile" = minute_sample ]; then
        connect_timeout=2; request_timeout=3
        if [ -z "${db_section_endpoints:-}" ]; then
            { google_play_transport_endpoints | head -n 1 | sed 's/$/|200 206|required/'; chatgpt_transport_endpoints | head -n 1; } > "$db_work/endpoints"
        fi
    fi
    while IFS='|' read -r url statuses policy; do
        first_exit=0; first_http=''
        db_runtime_safe || return 1
        [ ! -f "$db_cancel_file" ] || return 1
        [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || return 1
        # SOCKS hostname resolution belongs to the isolated candidate DNS and
        # copied current Podkop routes, not curl's system DNS or proxy env.
        if [ "$policy" = reachability ]; then set -- --head; else set -- --max-filesize 65536 --range 0-4095; fi
        for attempt in 1 2; do
            rm -f "$file"; request_ok=0
            db_https_attempted=true
            if code="$(unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy NO_PROXY no_proxy; db_bounded_command curl -sSL "$@" --proxy "socks5h://127.0.0.1:$DB_PROXY_PORT" --noproxy '' --connect-timeout "$connect_timeout" --max-time "$request_timeout" -w '%{http_code}|%{time_total}' -o "$file" "$url" 2>/dev/null)"; then request_ok=1; curl_exit=0; else curl_exit=$?; fi
            elapsed="${code#*|}"; code="${code%%|*}"
            if [ "$db_measurement_profile" = minute_sample ]; then
                [ "$attempt" = 1 ] || break
                # Retry only connect/timeout/empty-reply/receive failures.
                # TLS handshake (35), certificate (60), refusal and actual
                # blocking HTTP statuses are not transient retry candidates.
                case "$curl_exit" in 7|28|52|56) :;; *) break;; esac
                case "$code" in ''|000) :;; *)
                    if [ "$policy" = reachability ]; then
                        case "$code" in 2[0-9][0-9]|3[0-9][0-9]|4[0-9][0-9]) :;; *) break;; esac
                    else transport_status_is_expected "$code" "$statuses" || break; fi;;
                esac
                db_retry_budget 4 || break
                first_exit="$curl_exit"; first_http="$code"
                continue
            fi
            db_is_recommend && [ "$attempt" = 1 ] || break
            [ "$request_ok" != 1 ] || [ "$code" = 000 ] || break
            # Do not retry an actual wrong/blocking HTTP answer. A curl error
            # before headers, or during an otherwise acceptable answer, gets
            # one bounded retry through this exact same isolated child.
            case "$code" in ''|000) :;; *)
                if [ "$policy" = reachability ]; then
                    case "$code" in 2[0-9][0-9]|3[0-9][0-9]|4[0-9][0-9]) :;; *) break;; esac
                else transport_status_is_expected "$code" "$statuses" || break; fi;;
            esac
            db_runtime_safe || return 1
            [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || return 1
        done
        bytes=0; [ ! -f "$file" ] || bytes="$(wc -c < "$file" | tr -d ' ')"
        acceptable=false
        if [ "$policy" = reachability ]; then
            case "$code" in 2[0-9][0-9]|3[0-9][0-9]|4[0-9][0-9]) [ "$request_ok" != 1 ] || acceptable=true;; esac
        elif [ "$request_ok" = 1 ] && [ "$bytes" -ge 64 ] && transport_status_is_expected "$code" "$statuses"; then acceptable=true; fi
        if [ "$db_measurement_profile" = minute_sample ] && [ "$attempt" = 2 ]; then
            jq -cn --arg url "$url" --argjson initialExit "$first_exit" --arg initialHttp "$first_http" --argjson finalExit "$curl_exit" --argjson recovered "$acceptable" \
              '{kind:"https",url:$url,curlExit:$initialExit,initialHttpStatus:$initialHttp,finalCurlExit:$finalExit,recovered:$recovered}' >> "$db_work/retries.jsonl"
        fi
        if [ "$acceptable" != true ]; then
            if [ "$policy" = required ] || [ "$policy" = reachability ]; then
                reason=unexpected_status
                if [ "$request_ok" != 1 ]; then reason=curl_failed; elif [ "$bytes" -lt 64 ]; then reason=response_too_small; fi
                jq -cn --arg url "$url" --arg httpStatus "$code" --arg reason "$reason" --argjson bytes "$bytes" --argjson curlExit "$curl_exit" --arg elapsed "$elapsed" \
                  '{url:$url,httpStatus:$httpStatus,reason:$reason,bytes:$bytes,curlExit:$curlExit,elapsedSeconds:($elapsed|tonumber? // null),path:"candidate_podkop"}' > "$DB_DIR/transport-error.json"
                return 1
            fi
        fi
        if [ "$request_ok" = 1 ]; then
            case "$elapsed" in *[!0-9.]*|'') :;; *) db_https_ms=$((db_https_ms+$(awk -v value="$elapsed" 'BEGIN{printf "%d",value*1000}'))); db_https_count=$((db_https_count+1));; esac
        fi
        endpoint_done=$((endpoint_done+1))
        if [ -n "${db_section_endpoints:-}" ] && [ -s "$DB_STATUS" ]; then
            jq --argjson completed "$endpoint_done" '.sectionHttpsCompleted=$completed' "$DB_STATUS" > "$DB_STATUS.section.$$"; mv "$DB_STATUS.section.$$" "$DB_STATUS"
        fi
    done < "$db_work/endpoints"
}

# Check representative destinations for each active section, through that
# section's isolated worker. Direct/VPN sections use the cloned front router.
# This is explicitly a domain/HTTPS sample, not all SRS destinations or UDP.
db_section_guards() {
    local section dns="$DB_DNS_PORT" proxy="$DB_PROXY_PORT" services service domain output n https error row ports tag failed_queries repeat repeats='1 2' repeat_count=2 sampled='null' cache
    db_section_results='[]'
    [ -s "$db_work/sections.json" ] || return 0
    printf '%s' "$db_tested_sections" | jq -r '.[]' > "$db_work/test-sections"
    while IFS= read -r section; do
        n=0; https=0; error=''; failed_queries='[]'
        ports="$(jq -r --arg section "$section" '.[]|select(.section==$section)|[.dnsPort,.proxyPort]|join("|")' "$db_work/sections.json")"
        if [ -n "$ports" ]; then DB_DNS_PORT="${ports%%|*}"; DB_PROXY_PORT="${ports#*|}"; else DB_DNS_PORT="$dns"; DB_PROXY_PORT="$proxy"; fi
        # Cache only the deterministic scope, never responses or reliability.
        # The recommendation creates a fresh private directory for each run;
        # its fingerprint guards every candidate and confirmation unchanged.
        cache=''
        if [ "$db_measurement_profile" = minute_sample ] && [ -n "$db_sample_cache_dir" ]; then
            case "$section" in ''|*[!A-Za-z0-9_-]*) :;; *) cache="$db_sample_cache_dir/section-$section";; esac
        fi
        if [ -n "$cache" ] && [ -s "$cache" ]; then
            cp "$cache" "$db_work/section-domains.unique"
        else
        : > "$db_work/section-domains"
        jq -r --arg outbound "$section-out" '[.route.rules[]?|select(.outbound==$outbound)|.rule_set? // empty]|flatten|unique[]' "$db_work/child.json" > "$db_work/section-tags"
        while IFS= read -r tag; do
            case "$tag" in
              *-community-ruleset)
                service="${tag#"$section-"}"; service="${service%-community-ruleset}"
                write_community_service_probes "$service" > "$db_work/section-probes"
                if [ ! -s "$db_work/section-probes" ]; then
                    case "$service" in porn) echo 'community|porn|www.pornhub.com' > "$db_work/section-probes";; cloudflare) echo 'community|cloudflare|www.cloudflare.com' > "$db_work/section-probes";; *) error=section_scope_unverified;; esac
                fi
                cut -d '|' -f3 "$db_work/section-probes" >> "$db_work/section-domains";;
              *)
                jq -r --arg tag "$tag" '[((.route.rule_set//[])[]|select(.tag==$tag)|.rules|..|objects|(.domain_suffix? // empty),(.domain? // empty)|if type=="array" then .[] else . end)]|unique|.[0:3][]' "$db_work/child.json" >> "$db_work/section-domains";;
            esac
        done < "$db_work/section-tags"
        sort -u "$db_work/section-domains" > "$db_work/section-domains.unique"
        fi
        if [ "$db_measurement_profile" = minute_sample ]; then
            head -n 1 "$db_work/section-domains.unique" > "$db_work/section-domains.sample"
            mv "$db_work/section-domains.sample" "$db_work/section-domains.unique"
            sampled="$(jq -Rsc 'split("\n")|map(select(.!=""))' "$db_work/section-domains.unique")"
            repeats=1; repeat_count=1
            if [ -n "$cache" ] && [ -z "$error" ] && [ -s "$db_work/section-domains.unique" ]; then cp "$db_work/section-domains.unique" "$cache"; fi
        fi
        if [ -s "$DB_STATUS" ]; then
            jq --arg section "$section" --argjson tested "$db_tested_sections" --argjson total "$((repeat_count * $(wc -l < "$db_work/section-domains.unique")))" --argjson rows "$db_section_results" '.currentSection=$section|.testedSections=$tested|.sectionResults=$rows|.sectionQueryCompleted=0|.sectionQueryTotal=$total|.sectionHttpsCompleted=0|.message="testing_section"' "$DB_STATUS" > "$DB_STATUS.section.$$"; mv "$DB_STATUS.section.$$" "$DB_STATUS"
        fi
        : > "$db_work/section-endpoints"
        while IFS= read -r domain; do
            if ! db_runtime_safe; then error="$db_child_error"; break; fi
            case "$domain" in ''|*[!A-Za-z0-9._-]*) error=section_scope_unverified; continue;; esac
            for repeat in $repeats; do
                if ! db_runtime_safe; then error="$db_child_error"; break; fi
                output="$(db_sample_query "$domain" || true)"; n=$((n+1)); case "$output" in NOERROR\|*) :;; *) error=section_dns_failed; failed_queries="$(jq -cn --argjson rows "$failed_queries" --arg domain "$domain" --arg error "${output:-ERROR|NO_RESPONSE}" '$rows+[{domain:$domain,error:$error}]')";; esac
                if [ -s "$DB_STATUS" ]; then jq --argjson count "$n" '.sectionQueryCompleted=$count' "$DB_STATUS" > "$DB_STATUS.section.$$"; mv "$DB_STATUS.section.$$" "$DB_STATUS"; fi
            done
            # googlevideo.com is a DNS/CDN namespace, not an HTTP homepage.
            # Keep its DNS check, but use YouTube's real lightweight endpoint.
            case "$domain" in googlevideo.com|youtube.com) printf 'https://www.youtube.com/generate_204||reachability\n';; *) printf 'https://%s/||reachability\n' "$domain";; esac >> "$db_work/section-endpoints"
            https=$((https+1))
        done < "$db_work/section-domains.unique"
        [ "$n" -gt 0 ] || error=section_scope_unverified
        if [ -z "$error" ]; then
            db_section_endpoints="$db_work/section-endpoints"
            db_transport_guards || error=section_transport_failed
            db_section_endpoints=''
        fi
        row="$(jq -cn --arg section "$section" --arg error "$error" --argjson dnsCount "$n" --argjson httpsCount "$https" --argjson failedQueries "$failed_queries" '{section:$section,success:($error==""),error:(if $error=="" then null else $error end),dnsCount:$dnsCount,httpsCount:$httpsCount,failedQueries:$failedQueries,scope:"representative_dns_tls_http_reachability_not_application_access_or_all_destinations_or_udp",applicationAccessVerified:false}')"
        if [ "$db_measurement_profile" = minute_sample ]; then row="$(printf '%s' "$row" | jq --argjson sampled "$sampled" '.measurementProfile="minute_sample"|.fullCompatibilityVerified=false|.sampledDomains=$sampled')"; fi
        if [ -n "$error" ] && [ -s "$DB_DIR/transport-error.json" ]; then row="$(printf '%s' "$row" | jq --slurpfile context "$DB_DIR/transport-error.json" '.transportError=$context[0]')"; fi
        db_section_results="$(jq -cn --argjson rows "$db_section_results" --argjson row "$row" '$rows+[$row]')"
        if db_is_recommend && [ -n "$error" ]; then break; fi
    done < "$db_work/test-sections"
    DB_DNS_PORT="$dns"; DB_PROXY_PORT="$proxy"
    printf '%s' "$db_section_results" | jq -e 'length>0 and all(.success)' >/dev/null
}
db_measure_bootstrap() {
    local domain output n=0 successes=0 sum=0 ms nx=false error='' query_errors='[]'
    printf 'example.com\n' > "$db_work/bootstrap-domains"
    # Only generic responsiveness here. Exact encrypted primary hostname is
    # resolved during that pair's cold start; other candidates are unrelated.
    sort -u "$db_work/bootstrap-domains" > "$db_work/bootstrap-domains.unique"
    while IFS= read -r domain; do
        for repeat in 1 2; do
            [ ! -f "$db_cancel_file" ] || { error=cancelled; break 2; }
            [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || { error=measurement_timeout; break 2; }
            n=$((n+1)); output="$(db_query "$domain" || true)"
            case "$output" in NOERROR\|*) successes=$((successes+1)); ms="${output#*|}"; sum=$((sum+ms));;
              *) query_errors="$(jq -cn --argjson errors "$query_errors" --arg domain "$domain" --arg reason "${output:-ERROR|NO_RESPONSE}" '$errors+[{domain:$domain,reason:$reason}]')";; esac
        done
    done < "$db_work/bootstrap-domains.unique"
    if [ -z "$error" ]; then output="$(db_query "podkop-pe-$(date +%s)-$$.invalid" || true)"; [ "$output" != NXDOMAIN ] || nx=true; fi
    jq -cn --argjson successCount "$successes" --argjson totalQueries "$n" --argjson sum "$sum" --argjson nx "$nx" --arg error "$error" --argjson queryErrors "$query_errors" \
      '{successCount:$successCount,totalQueries:$totalQueries,averageMs:(if $successCount>0 then $sum/$successCount else null end),reliable:($error=="" and $successCount==$totalQueries and $successCount>0 and $nx),queryErrors:$queryErrors,error:(if $error!="" then $error elif $successCount==$totalQueries and $nx then null else "bootstrap_query_failed" end)}'
}
db_check_pair() {
    local stats='null' success=false error=pair_test_failed bp="${5:-udp}" host bootstrap_used=false
    rm -f "$DB_DIR/transport-error.json"
    : > "$db_work/retries.jsonl"
    db_section_results='[]'; db_https_ms=0; db_https_count=0; db_https_attempted=false
    if db_child_start "$1" "$3" "$4" "$bp" pair; then
        stats="$(db_measure)"
        if printf '%s' "$stats" | jq -e '.reliable' >/dev/null; then
            if db_transport_guards; then
                if db_section_guards; then success=true; error=''; else error="$(printf '%s' "$db_section_results" | jq -r '[.[]|select(.success==false)][0].error//"section_scope_unverified"')"; fi
            else error=service_transport_failed; fi
        else error="$(printf '%s' "$stats" | jq -r '.error//"dns_query_failed"')"; fi
    else error="$db_child_error";
    fi
    if ! db_runtime_safe; then success=false; error="$db_child_error"; fi
    db_child_stop
    [ ! -f "$db_cancel_file" ] || { success=false; error=cancelled; }
    [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || { success=false; error=measurement_timeout; }
    db_pair_json="$(db_pair_object "$1" "$2" "$3" "$4" "$success" "$bp" | jq --argjson stats "$stats" --arg error "$error" --argjson sections "$db_section_results" --argjson ms "$db_https_ms" --argjson count "$db_https_count" --argjson httpsTested "$db_https_attempted" '.httpsTested=$httpsTested|.stats=$stats|.sectionResults=$sections|.scope="representative_dns_tls_http_reachability_not_application_access_or_all_destinations_or_udp"|(if .stats!=null then .stats.transportAverageMs=(if $count>0 then $ms/$count else null end)|.stats.scoreMs=((.stats.averageMs//0)+(if $count>0 then $ms/$count else 0 end)) else . end)|.scoreBasis="dns_plus_https_mean_ms"|.error=(if $error=="" then null else $error end)')"
    db_pair_json="$(printf '%s' "$db_pair_json" | jq --arg profile "$db_measurement_profile" --slurpfile retries "$db_work/retries.jsonl" '.measurementProfile=$profile|(if $profile=="minute_sample" then .fullCompatibilityVerified=false else . end)|(if .stats!=null then .stats.retryCount=($retries|length)|.stats.recoveredRetries=([$retries[]|select(.recovered)]|length)|.stats.retryDetails=$retries else . end)')"
    if { [ "$error" = service_transport_failed ] || [ "$error" = section_transport_failed ]; } && [ -s "$DB_DIR/transport-error.json" ]; then
        db_pair_json="$(printf '%s' "$db_pair_json" | jq --slurpfile context "$DB_DIR/transport-error.json" '.transportError=$context[0]')"
    fi
    host="$(dns_catalog_endpoint "$1" "$3" main | jq -r '.host')"
    is_ipv4 "$host" || bootstrap_used=true
    db_pair_json="$(printf '%s' "$db_pair_json" | jq --arg host "$host" --argjson used "$bootstrap_used" '.bootstrapRequiredForPrimary=$used|.primaryEndpointHost=$host|.bootstrapAttribution=(if $used then "cold_start_primary_hostname_resolution" else "primary_literal_ip_bootstrap_not_used_for_primary" end)')"
}

db_infrastructure_error() {
    case "$1" in unsupported_client_routing|unsupported_ruleset_routing|unsupported_section_runtime|runtime_config_unavailable|active_selection_unavailable|rules_cache_unavailable|netstat_unavailable|listener_collision|insufficient_memory|memory_pressure|production_stopped|private_oom_unavailable|deadline_runner_unavailable|child_stopped|child_config_invalid|configuration_changed|cancelled|measurement_timeout) return 0;; *) return 1;; esac
}

db_pair_test() {
    local fingerprint current error
    rm -f "$DB_PROOF"
    db_pair_json="$(db_pair_object "$1" "$2" "$3" "$4" false "${5:-udp}")"
    fingerprint="$(db_fingerprint)" || { db_state error pair_test active_selection_unavailable 100 0 1 active_selection_unavailable; return 1; }
    db_state running pair_test testing_pair 10 0 1 ''
    db_check_pair "$@"
    if [ "${db_native_mode:-0}" = 1 ]; then current="$(db_fingerprint ordering)" || current=''
    else current="$(db_fingerprint)" || current=''; fi
    if [ "$fingerprint" != "$current" ] || db_busy; then db_pair_json="$(printf '%s' "$db_pair_json" | jq '.success=false|.error="configuration_changed"')"; fi
    if printf '%s' "$db_pair_json" | jq -e '.success' >/dev/null; then
        error=''
        db_write_proof "$db_pair_json" "$fingerprint" || error=proof_unavailable
        current="$(db_fingerprint)" || current=''
        if [ "$fingerprint" != "$current" ] || db_busy; then error=configuration_changed; fi
        db_runtime_safe || error="$db_child_error"
        [ ! -f "$DB_DIR/cancel" ] || error=cancelled
        if [ -z "$error" ] && db_state done pair_test pair_verified 100 1 1 ''; then
            cp "$DB_STATUS" "$DB_REPORT"; return 0
        fi
        [ -n "$error" ] || error=cancelled
        rm -f "$DB_PROOF"
        db_pair_json="$(printf '%s' "$db_pair_json" | jq --arg error "$error" '.success=false|.error=$error')"
    fi
    error="$(printf '%s' "$db_pair_json" | jq -r '.error//"pair_test_failed"')"
    db_state error pair_test pair_test_failed 100 1 1 "$error"
    cp "$DB_STATUS" "$DB_REPORT"
    return 1
}

db_pairs() {
    local count completed=0 protocol id server bootstrap bp fingerprint current row error=''
    db_pair_results='[]'; db_pair_json='null'
    rm -f "$DB_PROOF"
    jq -cn --argjson main "$db_results" --argjson bootstrap "$db_bootstrap_results" '
      [$main[]|select((.reliable==true or .precheckUsable==true) and .primaryEligible==true)] as $main |
      [$bootstrap[]|select(.reliable==true or .precheckUsable==true)] as $boot |
      [$main[] as $m|$boot[]|{protocol:$m.protocol,id:$m.id,dnsServer:$m.dnsServer,bootstrapDnsServer:.server,bootstrapProtocol:(.protocol//"udp")}]
      ' > "$db_work/pairs.json"
    count="$(jq length "$db_work/pairs.json")"
    if [ "$db_individual_complete" != true ] || [ "$count" = 0 ]; then db_state error pairs measured_candidates_required 100 0 "$count" measured_candidates_required; return 1; fi
    fingerprint="$(db_fingerprint)" || { db_state error pairs active_selection_unavailable 100 0 "$count" active_selection_unavailable; return 1; }
    jq -r '.[]|[.protocol,.id,.dnsServer,.bootstrapDnsServer,.bootstrapProtocol]|join("|")' "$db_work/pairs.json" > "$db_work/pairs.list"
    db_state running pairs measuring_pairs 0 0 "$count" ''
    while IFS='|' read -r protocol id server bootstrap bp; do
        [ ! -f "$DB_DIR/cancel" ] || { error=cancelled; break; }
        [ "$db_deadline" -eq 0 ] || [ "$(date +%s)" -lt "$db_deadline" ] || { error=measurement_timeout; break; }
        if ! db_validate_pair "$protocol" "$id" "$server" "$bootstrap" "$bp"; then
            db_pair_json="$(db_pair_object "$protocol" "$id" "$server" "$bootstrap" false "$bp" | jq '.error="stale_candidate"|.stats=null')"
        else db_check_pair "$protocol" "$id" "$server" "$bootstrap" "$bp"; fi
        current="$(db_fingerprint)" || current=''
        if [ "$current" != "$fingerprint" ] || db_busy; then db_pair_json="$(printf '%s' "$db_pair_json" | jq '.success=false|.error="configuration_changed"')"; error=configuration_changed; fi
        row="$db_pair_json"
        db_pair_results="$(printf '%s\n' "$db_pair_results" | jq -c --argjson row "$row" '.+[$row]')"
        completed=$((completed+1)); db_pair_json='null'
        if db_infrastructure_error "$(printf '%s' "$row" | jq -r '.error//""')"; then error="$(printf '%s' "$row" | jq -r '.error')"; fi
        [ -z "$error" ] || break
        db_state running pairs measuring_pairs "$((100*completed/count))" "$completed" "$count" ''
    done < "$db_work/pairs.list"
    if [ -n "$error" ]; then db_state error pairs "$error" 100 "$completed" "$count" "$error"; cp "$DB_STATUS" "$DB_REPORT"; return 1; fi
    if db_is_recommend; then db_state running "$db_action" pairs_complete 100 "$completed" "$count" ''; else db_state done pairs pairs_complete 100 "$completed" "$count" ''; fi
    cp "$DB_STATUS" "$DB_REPORT"
}

# Fast recommendation prechecks are ordering hints, never acceptance evidence.
# In particular direct precheck failure cannot disqualify a proxy-routed DNS.
db_fast_catalog() {
    local kind="$1" protocols="$2" protocol id provider server profile endpoint family automatic excluded=0
    : > "$db_work/$kind.rows"
    : > "$db_work/$kind.available.rows"
    for protocol in $protocols; do
        if [ "$kind" = main ]; then write_main_candidates "$protocol" "$db_work/catalog" || continue
        else write_bootstrap_candidates "$db_work/catalog" "$protocol" || continue; fi
        while IFS='|' read -r id provider server profile; do
            db_runtime_safe || return 1
            if [ "$kind" = main ] && ! candidate_is_primary_eligible "$id" "$provider" "$server"; then excluded=$((excluded+1)); continue; fi
            endpoint="$(dns_catalog_endpoint "$protocol" "$server" "$kind" 2>/dev/null)" || { excluded=$((excluded+1)); continue; }
            if [ "$kind" = bootstrap ] && ! is_ipv4 "$(printf '%s' "$endpoint" | jq -r '.host')"; then excluded=$((excluded+1)); continue; fi
            family="$(db_provider_family "$provider")"
            automatic=false; if profile_is_universal "$profile"; then automatic=true; fi
            jq -cn --arg protocol "$protocol" --arg id "$id" --arg provider "$provider" --arg server "$server" --argjson endpoint "$endpoint" --arg family "$family" --arg profile "$profile" --argjson automatic "$automatic" \
              '{protocol:$protocol,id:$id,provider:$provider,server:$server,profile:$profile,primaryEligible:true,automaticEligible:$automatic,key:([$protocol,$endpoint]|tojson),family:$family}' >> "$db_work/$kind.available.rows"
            if [ "$automatic" = false ]; then continue; fi
            tail -n 1 "$db_work/$kind.available.rows" >> "$db_work/$kind.rows"
        done < "$db_work/catalog"
    done
    jq -s 'reduce .[] as $row ([]; if any(.key==$row.key) then . else .+[$row] end)' "$db_work/$kind.rows" > "$db_work/$kind.all"
    # A saved/custom alias must not hide the canonical automatic candidate.
    jq -s 'sort_by(.automaticEligible!=true)|reduce .[] as $row ([];if any(.key==$row.key) then . else .+[$row] end)' "$db_work/$kind.available.rows" > "$db_work/$kind.available"
    db_prefilter="$(printf '%s' "$db_prefilter" | jq --argjson excluded "$excluded" --argjson raw "$(wc -l < "$db_work/$kind.rows")" --argjson count "$(jq length "$db_work/$kind.all")" '.excluded+=$excluded|.duplicates+=($raw-$count)')"
}

db_fast_hint() {
    local hint="$1" protocol server bootstrap bp main_endpoint boot_endpoint main_key boot_key
    [ "$hint" != null ] || { printf 'null\n'; return; }
    protocol="$(printf '%s' "$hint" | jq -r '.protocol')"
    server="$(printf '%s' "$hint" | jq -r '.dnsServer')"
    bootstrap="$(printf '%s' "$hint" | jq -r '.bootstrapDnsServer')"
    bp="$(printf '%s' "$hint" | jq -r '.bootstrapProtocol//"udp"')"
    main_endpoint="$(dns_catalog_endpoint "$protocol" "$server" main 2>/dev/null)" || { printf 'null\n'; return; }
    boot_endpoint="$(dns_catalog_endpoint "$bp" "$bootstrap" bootstrap 2>/dev/null)" || { printf 'null\n'; return; }
    main_key="$(jq -cn --arg protocol "$protocol" --argjson endpoint "$main_endpoint" '[$protocol,$endpoint]|tojson')"
    boot_key="$(jq -cn --arg protocol "$bp" --argjson endpoint "$boot_endpoint" '[$protocol,$endpoint]|tojson')"
    jq -n --argjson mainKey "$main_key" --argjson bootKey "$boot_key" --slurpfile m "$db_work/main.all" --slurpfile b "$db_work/bootstrap.all" \
      '[$m[0][]|select(.key==$mainKey)] as $m|[$b[0][]|select(.key==$bootKey)] as $b|if ($m|length)>0 and ($b|length)>0 then {protocol:$m[0].protocol,id:$m[0].id,dnsServer:$m[0].server,bootstrapDnsServer:$b[0].server,bootstrapProtocol:$b[0].protocol} else null end'
}

db_fast_probe() {
    db_native_mode=1
    local kind="$1" row protocol server bp bootstrap output domain domains endpoint_host attempt good=0 sum=0 samples=0 stats nxdomain=false completed total
    : > "$db_work/$kind.measured"
    jq -c '.[]' "$db_work/$kind.short" > "$db_work/$kind.list"
    while IFS= read -r row; do
        db_runtime_safe || return 1
        protocol="$(printf '%s' "$row" | jq -r '.protocol')"; server="$(printf '%s' "$row" | jq -r '.server')"
        bp="$protocol"; bootstrap="$server"; good=0; sum=0; samples=0; nxdomain=false
        db_probe_deadline=$(( $(date +%s)+30 ))
        [ "$db_probe_deadline" -le "$db_deadline" ] || db_probe_deadline="$db_deadline"
        if [ "$kind" = main ]; then
            bootstrap="$(printf '%s' "$db_bootstrap_results" | jq -r 'sort_by(.quickReliable!=true,.averageMs//999999)|.[0].server//empty')"
            bp="$(printf '%s' "$db_bootstrap_results" | jq -r 'sort_by(.quickReliable!=true,.averageMs//999999)|.[0].protocol//"udp"')"
        fi
        domains='example.com youtube.com'
        if [ "$kind" = bootstrap ]; then
            endpoint_host="$(jq -r '.[]|(.key|fromjson)[1].host' "$db_work/main.all" | awk '/[A-Za-z]/{print;exit}')"
            domains="example.com ${endpoint_host:-example.com}"
        fi
        if [ -n "$bootstrap" ] && db_native_start "$protocol" "$server" "$bootstrap" "$bp"; then
            for domain in $domains; do
                for attempt in 1 2; do
                    db_runtime_safe || { db_child_stop; return 1; }
                    if output="$(db_query "$domain")"; then
                        case "$output" in NOERROR\|*) good=$((good+1)); sum=$((sum+${output#*|})); samples=$((samples+1)); break;; esac
                    fi
                done
            done
            output="$(db_query "podkop-precheck-$(date +%s)-$$.invalid" || true)"
            [ "$output" != NXDOMAIN ] || nxdomain=true
        elif db_infrastructure_error "$db_child_error"; then db_child_stop; return 1; fi
        db_child_stop
        db_probe_deadline=0
        stats="$(printf '%s' "$row" | jq --arg kind "$kind" --argjson good "$good" --argjson nx "$nxdomain" --argjson sum "$sum" --argjson n "$samples" '.quickReliable=($good==2 and $nx)|.nxdomainOk=$nx|.reliable=false|.measured=true|.httpsTested=false|.successCount=$good|.totalQueries=2|.precheckUsable=true|.precheckOnly=true|.probeScope="direct_native_dns_ordering_only"|.averageMs=(if $n>0 then $sum/$n else null end)|(if $kind=="main" then .dnsServer=.server else . end)')"
        printf '%s\n' "$stats" >> "$db_work/$kind.measured"
        stats="$(jq -c --slurpfile measured "$db_work/$kind.measured" 'map(. as $row|([$measured[]|select(.key==$row.key)][0]//$row))' "$db_work/$kind.available")"
        if [ "$kind" = main ]; then db_results="$stats"; db_available_results="$stats"
        else db_bootstrap_results="$stats"; db_available_bootstrap_results="$stats"; fi
        db_endpoint_coverage="$(printf '%s' "$db_endpoint_coverage" | jq -c --arg kind "$kind" '.[$kind].tested+=1')"
        completed="$(printf '%s' "$db_endpoint_coverage" | jq '[.main.tested,.bootstrap.tested]|add')"
        total="$(printf '%s' "$db_endpoint_coverage" | jq '[.main.selected,.bootstrap.selected]|add')"
        db_state running "$db_action" measuring_endpoints "$((5+5*completed/total))" "$completed" "$total" ''
    done < "$db_work/$kind.list"
    if [ "$kind" = main ]; then db_results="$(jq -sc '.' "$db_work/$kind.measured")"
    else db_bootstrap_results="$(jq -sc '.' "$db_work/$kind.measured")"; fi
}

db_fast_context() {
    [ ! -f "$DB_DIR/cancel" ] || { db_child_error=cancelled; return 1; }
    [ "$(date +%s)" -lt "$db_deadline" ] || { db_child_error=measurement_timeout; return 1; }
    db_runtime_safe || return 1
    local current
    current="$(db_fingerprint)" || current=''
    [ ! -f "$DB_DIR/cancel" ] || { db_child_error=cancelled; return 1; }
    [ "$(date +%s)" -lt "$db_deadline" ] || { db_child_error=measurement_timeout; return 1; }
    if [ "$1" != "$current" ]; then
        printf 'dns_fast_context reason=fingerprint_changed expected=%s current=%s\n' "$1" "${current:-unavailable}" >&2
        db_child_error=configuration_changed; return 1
    fi
    if db_busy; then
        printf 'dns_fast_context reason=runtime_busy fingerprint=%s\n' "$current" >&2
        db_child_error=configuration_changed; return 1
    fi
}

# A single private pair at a time: do not race admission against another clone.
db_parallel_limit() {
    echo 1
}
db_pool_forget_pid() {
    local removed="$1" owned remaining=''
    for owned in $db_pool_pids; do
        [ "$owned" = "$removed" ] || remaining="$remaining $owned"
    done
    db_pool_pids="$remaining"
}
db_pool_stop() {
    local pid
    for pid in $db_pool_pids; do
        db_owned_child "$pid" && kill "$pid" 2>/dev/null || true
    done
    for pid in $db_pool_pids; do wait "$pid" 2>/dev/null || true; done
    db_pool_pids=''
}
db_pool_pair() {
    local directory="$1" slot="$2"
    shift 2
    # Each child owns every mutable artifact, including transport errors and
    # scope cache. The immutable cancellation path remains coordinator-owned.
    db_work="$directory"; DB_DIR="$directory/state"; DB_STATUS="$DB_DIR/status.json"
    mkdir -p "$DB_DIR" "$directory/scope"
    db_sample_cache_dir="$directory/scope"
    DB_DNS_PORT=$((20000+slot*100)); DB_PROXY_PORT=$((20001+slot*100))
    db_section_port_base=$((20010+slot*100))
    db_child_pid=''; db_section_pids=''; db_pool_pids=''
    trap 'db_child_stop' EXIT
    trap 'db_child_stop; exit 130' INT TERM HUP
    if [ "$db_measurement_profile" = full ]; then db_probe_deadline=$(( $(date +%s)+180 ))
    else db_probe_deadline=$(( $(date +%s)+90 )); fi
    [ "$db_probe_deadline" -le "$db_deadline" ] || db_probe_deadline="$db_deadline"
    db_check_pair "$@"
    printf '%s\n' "$db_pair_json" > "$directory/result.tmp"
    mv "$directory/result.tmp" "$directory/result.json"
}
# Current endpoint aliases and canonical catalog addresses are one comparison.
db_stage_current() {
    local configured slot prefix='' protocol server bootstrap bp main boot main_key boot_key
    slot="$(configured_active_slot)"
    configured="$(read_configured_pair "$slot" || true)"
    [ -n "$configured" ] || return 0
    IFS='|' read -r protocol server bootstrap <<EOF
$configured
EOF
    [ "$slot" != secondary ] || prefix=secondary_
    bp="$(uci -q get "podkop.settings.${prefix}bootstrap_dns_type" 2>/dev/null || true)"; bp="${bp:-udp}"
    main="$(dns_catalog_endpoint "$protocol" "$server" main 2>/dev/null)" || return 0
    boot="$(dns_catalog_endpoint "$bp" "$bootstrap" bootstrap 2>/dev/null)" || return 0
    main_key="$(jq -cn --arg protocol "$protocol" --argjson endpoint "$main" '[$protocol,$endpoint]|tojson')"
    boot_key="$(jq -cn --arg protocol "$bp" --argjson endpoint "$boot" '[$protocol,$endpoint]|tojson')"
    # A current tuple outside selected catalogs remains comparison-only and
    # does not enter the selected endpoint coverage counters.
    jq --argjson mainKey "$main_key" --argjson bootKey "$boot_key" --arg protocol "$protocol" --arg server "$server" --arg bp "$bp" --arg bootstrap "$bootstrap" '
      map(if .mainKey==$mainKey and .bootstrapKey==$bootKey then .currentPair=true|.automaticEligible=false else .currentPair=false end) |
      if any(.currentPair) then . else .+[{protocol:$protocol,id:"current_pair",dnsServer:$server,bootstrapDnsServer:$bootstrap,bootstrapProtocol:$bp,automaticEligible:false,currentPair:true,mainKey:$mainKey,bootstrapKey:$bootKey,mainFamily:"current",bootstrapFamily:"current",quickFailed:2,quickScore:1999998}] end
      ' "$db_work/all-pairs.json" > "$db_work/current-pairs.json"
    mv "$db_work/current-pairs.json" "$db_work/all-pairs.json"
}

db_stage_order() {
    # Endpoint failures only sort last; they never remove an eligible pair.
    # Prefer unseen providers and protocols, then the cheap latency estimate.
    jq '
      map(select(.automaticEligible or .currentPair)) as $rows |
      reduce range(0;($rows|length)) as $i ({pending:$rows,ordered:[],main:[],boot:[],protocol:[],bp:[]};
        . as $state |
        (.pending|sort_by(.currentPair!=true,.quickFailed,
          . as $row | -((if ($state.main|index($row.mainFamily))==null then 1 else 0 end)+
            (if ($state.boot|index($row.bootstrapFamily))==null then 1 else 0 end)+
            (if ($state.protocol|index($row.protocol))==null then 1 else 0 end)+
            (if ($state.bp|index($row.bootstrapProtocol))==null then 1 else 0 end)),
          .quickScore,.protocol,.id,.bootstrapDnsServer)|.[0]) as $next |
        .ordered+=[$next]|.pending-=[$next]|.main+=[$next.mainFamily]|.boot+=[$next.bootstrapFamily]|.protocol+=[$next.protocol]|.bp+=[$next.bootstrapProtocol]) | .ordered
      ' "$db_work/all-pairs.json" > "$db_work/ordered-pairs.json"
    jq -r '.[]|[.protocol,.id,.dnsServer,.bootstrapDnsServer,.bootstrapProtocol]|join("|")' "$db_work/ordered-pairs.json" > "$db_work/all-pairs"
}

# Full verification is a fresh isolated run, not a promotion of sampled stats.
# Every successful automatic finalist is considered, including unrechecked rows.
db_verify_finalists() {
    local fingerprint="$1" first protocol id server bootstrap bp directory pid result error bootstrap_test host
    db_recommendation=null; db_pair_json=null; db_selection_complete=false
    db_full_verification_complete=false; db_measurement_profile=full; db_phase=full_verify
    printf '%s' "$db_pair_results" | jq -c '[.[]|select(.automaticEligible==true and .success==true and .stats.reliable==true and .rechecked!=false)]|sort_by((.stats.retryCount//0),(.stableScoreMs//.stats.scoreMs//.stats.averageMs//999999))|.[]' > "$db_work/full-ranked"
    while IFS= read -r first; do
        db_fast_context "$fingerprint" || return 1
        protocol="$(printf '%s' "$first" | jq -r '.protocol')"; id="$(printf '%s' "$first" | jq -r '.id')"
        server="$(printf '%s' "$first" | jq -r '.dnsServer')"; bootstrap="$(printf '%s' "$first" | jq -r '.bootstrapDnsServer')"; bp="$(printf '%s' "$first" | jq -r '.bootstrapProtocol')"
        db_validate_pair "$protocol" "$id" "$server" "$bootstrap" "$bp" || { db_child_error=configuration_changed; return 1; }
        db_full_verification_attempts=$((db_full_verification_attempts+1))
        db_state running "$db_action" full_verifying 95 "$db_full_verification_attempts" "$(wc -l < "$db_work/full-ranked")" ''
        directory="$db_work/full-$db_full_verification_attempts"; mkdir -p "$directory"
        (db_pool_pair "$directory" 0 "$protocol" "$id" "$server" "$bootstrap" "$bp") &
        pid=$!; db_pool_pids="$pid"; wait "$pid" || true; db_pool_pids=''
        if [ ! -s "$directory/result.json" ]; then
            if [ -f "$db_cancel_file" ]; then db_child_error=cancelled; else db_child_error=worker_stopped; fi
            case "$directory" in "$db_work"/full-*) rm -rf "$directory";; esac
            return 1
        fi
        result="$(cat "$directory/result.json")"
        case "$directory" in "$db_work"/full-*) rm -rf "$directory";; esac
        db_fast_context "$fingerprint" || return 1
        # A worker can never certify a different tuple or a short profile.
        if ! printf '%s' "$result" | jq -e --arg p "$protocol" --arg id "$id" --arg server "$server" --arg bootstrap "$bootstrap" --arg bp "$bp" '.measurementProfile=="full" and .protocol==$p and .id==$id and .dnsServer==$server and .bootstrapDnsServer==$bootstrap and .bootstrapProtocol==$bp' >/dev/null; then
            db_child_error=full_verification_invalid; return 1
        fi
        result="$(printf '%s' "$result" | jq -c '.automaticEligible=true|.comparisonOnly=false|.currentPair=false|.rechecked=(.success==true and .stats.reliable==true)')"
        if [ "$db_action" = recommend_reserve ]; then
            result="$(printf '%s' "$result" | jq -c --slurpfile pairs "$db_work/all-pairs.json" '. as $r|[$pairs[0][]|select(.protocol==$r.protocol and .dnsServer==$r.dnsServer and .bootstrapProtocol==$r.bootstrapProtocol and .bootstrapDnsServer==$r.bootstrapDnsServer)][0] as $candidate|.mainFamily=$candidate.mainFamily|.bootstrapFamily=$candidate.bootstrapFamily|.provider=$candidate.mainFamily|.bootstrapProvider=$candidate.bootstrapFamily')"
            if printf '%s' "$result" | jq -e '.success==true and .stats.reliable==true' >/dev/null; then
                host="$(dns_catalog_endpoint "$protocol" "$server" main | jq -r '.host')"
                bootstrap_test="$(probe_bootstrap "$bp" "$bootstrap" "$host" || true)"
                if ! printf '%s' "$bootstrap_test" | jq -e 'type=="object" and .success==true' >/dev/null 2>&1; then
                    result="$(printf '%s' "$result" | jq -c --argjson check "${bootstrap_test:-null}" '.success=false|.rechecked=false|.stats.reliable=false|.error="bootstrap_query_failed"|.bootstrapTest=$check')"
                else
                    db_recommendation_bootstrap_test="$bootstrap_test"
                    result="$(printf '%s' "$result" | jq -c --argjson check "$bootstrap_test" '.bootstrapTest=$check')"
                fi
            fi
        fi
        db_full_verification_results="$(printf '%s' "$db_full_verification_results" | jq -c --argjson row "$result" '.+[$row]')"
        db_tested_sections="$(jq -cn --argjson old "$db_tested_sections" --argjson row "$result" '($old+[$row.sectionResults[]?.section|select(.!=null)])|unique')"
        error="$(printf '%s' "$result" | jq -r '.error//""')"
        if db_infrastructure_error "$error"; then db_child_error="$error"; return 1; fi
        case "$error" in child_stopped|worker_stopped|full_verification_invalid) db_child_error="$error"; return 1;; esac
        if printf '%s' "$result" | jq -e '.success==true and .stats.reliable==true and .error==null' >/dev/null; then
            db_recommendation="$result"; db_pair_json="$result"; db_full_verification_complete=true
            return 0
        fi
        db_state running "$db_action" full_candidate_failed 95 "$db_full_verification_attempts" "$(wc -l < "$db_work/full-ranked")" ''
    done < "$db_work/full-ranked"
    db_child_error=no_fully_verified_pairs; return 1
}

db_recommend() {
    local fingerprint protocols bootstrap_protocols error='' row protocol id server bootstrap bp
    local count index=0 slot directory pid active first confirmation successful stable best limit
    db_started_at="$(date +%s)"
    rm -f "$DB_RESERVE_PROOF"
    [ "$db_deadline" -ne 0 ] || db_deadline=$((db_started_at+7200))
    db_probe_deadline=0; db_measurement_profile=minute_sample; db_phase=precheck
    db_selection_complete=false; db_exhaustive_selected=false; db_comparison_complete=false; db_tested_sections='[]'
    db_recommendation=null; db_pair_json=null; db_pair_results='[]'; db_results='[]'; db_bootstrap_results='[]'
    db_available_results='[]'; db_available_bootstrap_results='[]'; db_individual_complete=false
    db_candidates_total=0; db_pairs_tested=0; db_confirmation_runs=0; db_target_pairs=0
    db_full_verification_complete=false; db_full_verification_attempts=0; db_full_verification_results='[]'
    db_shortlisted_pairs=0; db_endpoint_coverage='{"main":{"selected":0,"tested":0},"bootstrap":{"selected":0,"tested":0}}'
    db_current_primary_provider=''; db_current_bootstrap_provider=''; db_recommendation_bootstrap_test=null
    db_prefilter='{"excluded":0,"duplicates":0,"deferred":0}'
    db_cancel_file="$DB_DIR/cancel"; db_pool_pids=''
    rm -f "$DB_PROOF"
    if db_endpoint_only_if_needed; then return 0; fi
    rm -f "$DB_PROOF"
    db_native_mode=1
    fingerprint="$(db_fingerprint ordering)" || { db_state error recommend active_selection_unavailable 100 0 0 active_selection_unavailable; return 1; }
    db_state running recommend precheck 0 0 0 ''
    protocols="$(uci -q get podkop.settings.dns_optimizer_protocols 2>/dev/null || true)"
    bootstrap_protocols="$(uci -q get podkop.settings.dns_optimizer_bootstrap_protocols 2>/dev/null || true)"
    protocols="$(normalize_benchmark_protocols "${protocols:-auto}")" || error=invalid_protocol
    bootstrap_protocols="$(normalize_benchmark_protocols "${bootstrap_protocols:-udp}")" || error=invalid_bootstrap_protocol
    if [ -z "$error" ]; then db_fast_catalog main "$protocols" && db_fast_catalog bootstrap "$bootstrap_protocols" || error="$db_child_error"; fi
    if [ -z "$error" ]; then
        db_available_results="$(jq -c 'map(.dnsServer=.server|.measured=false|.reliable=false)' "$db_work/main.available")"
        db_available_bootstrap_results="$(jq -c 'map(.measured=false|.reliable=false)' "$db_work/bootstrap.available")"
        db_results="$db_available_results"; db_bootstrap_results="$db_available_bootstrap_results"
        db_endpoint_coverage="$(jq -cn --argjson m "$(jq length "$db_work/main.available")" --argjson b "$(jq length "$db_work/bootstrap.available")" '{main:{selected:$m,tested:0},bootstrap:{selected:$b,tested:0}}')"
        if db_is_staged; then
            db_phase=endpoints
            cp "$db_work/main.available" "$db_work/main.short"; cp "$db_work/bootstrap.available" "$db_work/bootstrap.short"
            db_fast_probe bootstrap && db_fast_probe main && db_fast_context "$fingerprint" || error="$db_child_error"
            db_available_results="$db_results"; db_available_bootstrap_results="$db_bootstrap_results"
            [ -n "$error" ] || db_individual_complete=true
        fi
        [ -z "$error" ] || { db_state error "$db_action" "$error" 100 0 0 "$error"; cp "$DB_STATUS" "$DB_REPORT"; return 1; }
        jq -n --argjson m "$db_results" --argjson b "$db_bootstrap_results" '[$m[] as $m|$b[] as $b|{protocol:$m.protocol,id:$m.id,dnsServer:$m.server,bootstrapDnsServer:$b.server,bootstrapProtocol:$b.protocol,automaticEligible:($m.automaticEligible and $b.automaticEligible),mainKey:$m.key,bootstrapKey:$b.key,mainFamily:$m.family,bootstrapFamily:$b.family,quickFailed:([$m,$b]|map(select(.quickReliable!=true))|length),quickScore:(($m.averageMs//999999)+($b.averageMs//999999))}]' > "$db_work/all-pairs.json"
        if [ "$db_action" = recommend_reserve ]; then
            db_reserve_filter || { error="$db_child_error"; db_state error "$db_action" "$error" 100 0 0 "$error"; cp "$DB_STATUS" "$DB_REPORT"; return 1; }
        fi
        db_prefilter="$(printf '%s' "$db_prefilter" | jq --slurpfile pairs "$db_work/all-pairs.json" '.comparisonOnly=([$pairs[0][]|select(.automaticEligible==false)]|length)')"
        count="$(jq length "$db_work/all-pairs.json")"; db_candidates_total="$count"
        [ "$count" -gt 0 ] || error=no_candidates
        if db_is_staged; then
            [ "$db_action" = recommend_reserve ] || db_stage_current
            db_stage_order
            db_candidates_total="$(jq length "$db_work/all-pairs.json")"
            count="$(jq length "$db_work/ordered-pairs.json")"; limit=8; [ "$limit" -le "$count" ] || limit="$count"
        else
            jq -r '.[]|[.protocol,.id,.dnsServer,.bootstrapDnsServer,.bootstrapProtocol]|join("|")' "$db_work/all-pairs.json" > "$db_work/all-pairs"
            limit="$count"
        fi
        db_native_mode=0
        # Ordering never mints proof. Capture the full engine/version identity
        # only now, immediately before guarded isolated graph verification.
        fingerprint="$(db_fingerprint)" || { db_state error recommend active_selection_unavailable 100 0 0 active_selection_unavailable; return 1; }
        db_prepare_runtime_cache "$fingerprint" || { db_state error recommend "$db_child_error" 100 0 0 "$db_child_error"; return 1; }
        db_target_pairs="$limit"; db_shortlisted_pairs="$limit"
        db_prefilter="$(printf '%s' "$db_prefilter" | jq -c --slurpfile pairs "$db_work/all-pairs.json" --argjson target "$limit" '.comparisonOnly=([$pairs[0][]|select(.automaticEligible==false)]|length)|.deferred=(($pairs[0]|length)-$target)')"
        while [ -z "$error" ]; do
        db_phase=pairs
        while [ "$index" -lt "$limit" ] && [ -z "$error" ]; do
            db_fast_context "$fingerprint" || { error="$db_child_error"; break; }
            db_parallelism="$(db_parallel_limit)"
            case "$db_parallelism" in 2) :;; *) db_parallelism=1;; esac
            active=0; : > "$db_work/batch"
            while [ "$active" -lt "$db_parallelism" ] && [ "$index" -lt "$limit" ]; do
                index=$((index+1)); slot="$active"; active=$((active+1))
                row="$(sed -n "${index}p" "$db_work/all-pairs")"
                IFS='|' read -r protocol id server bootstrap bp <<EOF
$row
EOF
                # The separately captured current tuple may not be selected
                # in the catalog. It can only be compared, never recommended.
                if ! jq -e --arg protocol "$protocol" --arg server "$server" --arg bp "$bp" --arg bootstrap "$bootstrap" 'any(.currentPair==true and .protocol==$protocol and .dnsServer==$server and .bootstrapProtocol==$bp and .bootstrapDnsServer==$bootstrap)' "$db_work/all-pairs.json" >/dev/null; then
                    db_validate_pair "$protocol" "$id" "$server" "$bootstrap" "$bp" || { error=configuration_changed; break; }
                fi
                directory="$db_work/pair-$index"; mkdir -p "$directory"
                (db_pool_pair "$directory" "$slot" "$protocol" "$id" "$server" "$bootstrap" "$bp") &
                pid=$!; db_pool_pids="$db_pool_pids $pid"
                printf '%s|%s\n' "$pid" "$directory" >> "$db_work/batch"
            done
            # Only this coordinator writes public progress. Workers publish
            # atomic private results; a killed worker cannot fabricate coverage.
            while IFS='|' read -r pid directory; do
                wait "$pid" || true
                # Reaped PIDs are reusable by the kernel. Never retain them
                # in cancellation ownership once wait has completed.
                db_pool_forget_pid "$pid"
                if [ ! -s "$directory/result.json" ]; then
                    if [ -f "$db_cancel_file" ]; then error=cancelled; else error=worker_stopped; fi
                    break
                fi
                first="$(cat "$directory/result.json")"
                first="$(printf '%s' "$first" | jq --slurpfile pairs "$db_work/all-pairs.json" '. as $row|([$pairs[0][]|select(.protocol==$row.protocol and .dnsServer==$row.dnsServer and .bootstrapProtocol==$row.bootstrapProtocol and .bootstrapDnsServer==$row.bootstrapDnsServer)][0]) as $candidate|.automaticEligible=$candidate.automaticEligible|.currentPair=($candidate.currentPair//false)|.comparisonOnly=(.automaticEligible==false)')"
                # wait completed the private EXIT cleanup. Retain the small
                # measured row, not N complete runtime replicas in tmpfs.
                case "$directory" in "$db_work"/pair-*) rm -rf "$directory";; esac
                db_pair_results="$(printf '%s\n' "$db_pair_results" | jq -c --argjson row "$first" '.+[$row]')"
                db_tested_sections="$(jq -cn --argjson old "$db_tested_sections" --argjson row "$first" '($old+[$row.sectionResults[]?.section|select(.!=null)])|unique')"
                db_pairs_tested=$((db_pairs_tested+1))
                if db_infrastructure_error "$(printf '%s' "$first" | jq -r '.error//""')"; then error="$(printf '%s' "$first" | jq -r '.error')"; break; fi
            done < "$db_work/batch"
            db_pool_stop
            db_fast_context "$fingerprint" || error="$db_child_error"
            [ -n "$error" ] || db_state running "$db_action" measuring_pairs "$((10+70*db_pairs_tested/limit))" "$db_pairs_tested" "$limit" ''
        done
        if [ -z "$error" ] && [ "$db_pairs_tested" -eq "$limit" ]; then
            [ "$db_action" != recommend_full ] || db_exhaustive_selected=true
        else [ -n "$error" ] || error=comparison_incomplete; fi
        successful="$(printf '%s' "$db_pair_results" | jq '[.[]|select(.success and .stats.reliable and .automaticEligible==true)]|length')"
        if [ -z "$error" ] && [ "$successful" -ge 2 ]; then
            printf '%s' "$db_pair_results" | jq -c '[.[]|select(.success and .stats.reliable and .automaticEligible==true and .rechecked==null)]|sort_by((.stats.retryCount//0),(.stats.scoreMs//.stats.averageMs//999999))|.[]' > "$db_work/ranked"
            db_phase=recheck
            while IFS= read -r first; do
                stable="$(printf '%s' "$db_pair_results" | jq '[.[]|select(.rechecked==true)]|length')"
                best="$(printf '%s' "$db_pair_results" | jq -c '[.[]|select(.rechecked==true)]|sort_by((.stats.retryCount//0),.stableScoreMs)|.[0]//null')"
                # max(initial,repeat) and accumulated retry count cannot beat
                # their initial lower bound. Stop only after two stable rows
                # and no remaining ranked lower bound can beat the leader.
                if [ "$stable" -ge 2 ] && printf '%s' "$first" | jq -e --argjson best "$best" '(.stats.retryCount//0)>($best.stats.retryCount//0) or ((.stats.retryCount//0)==($best.stats.retryCount//0) and (.stats.scoreMs//.stats.averageMs//999999)>=$best.stableScoreMs)' >/dev/null; then break; fi
                db_fast_context "$fingerprint" || { error="$db_child_error"; break; }
                db_state running recommend rechecking 90 "$db_confirmation_runs" "$successful" ''
                protocol="$(printf '%s' "$first" | jq -r '.protocol')"; id="$(printf '%s' "$first" | jq -r '.id')"
                server="$(printf '%s' "$first" | jq -r '.dnsServer')"; bootstrap="$(printf '%s' "$first" | jq -r '.bootstrapDnsServer')"; bp="$(printf '%s' "$first" | jq -r '.bootstrapProtocol')"
                directory="$db_work/recheck-$db_confirmation_runs"; mkdir -p "$directory"
                (db_pool_pair "$directory" 0 "$protocol" "$id" "$server" "$bootstrap" "$bp") &
                pid=$!; db_pool_pids="$pid"; wait "$pid" || true; db_pool_pids=''
                [ -s "$directory/result.json" ] || { error=worker_stopped; break; }
                confirmation="$(cat "$directory/result.json")"; db_confirmation_runs=$((db_confirmation_runs+1))
                case "$directory" in "$db_work"/recheck-*) rm -rf "$directory";; esac
                db_fast_context "$fingerprint" || { error="$db_child_error"; break; }
                first="$(printf '%s' "$first" | jq --argjson c "$confirmation" '.confirmationRuns=2|.confirmations=[$c]|.rechecked=($c.success and $c.stats.reliable)|.stableScoreMs=([(.stats.scoreMs//.stats.averageMs),($c.stats.scoreMs//$c.stats.averageMs)]|max)|.stableAverageMs=([.stats.averageMs,$c.stats.averageMs]|add/2)|.stats.retryCount=((.stats.retryCount//0)+($c.stats.retryCount//0))|.stats.recoveredRetries=((.stats.recoveredRetries//0)+($c.stats.recoveredRetries//0))')"
                db_pair_results="$(printf '%s\n' "$db_pair_results" | jq -c --argjson row "$first" 'map(if .protocol==$row.protocol and .dnsServer==$row.dnsServer and .bootstrapProtocol==$row.bootstrapProtocol and .bootstrapDnsServer==$row.bootstrapDnsServer then $row else . end)')"
                if db_infrastructure_error "$(printf '%s' "$confirmation" | jq -r '.error//""')"; then error="$(printf '%s' "$confirmation" | jq -r '.error')"; break; fi
            done < "$db_work/ranked"
            if [ -z "$error" ]; then
                db_recommendation="$(printf '%s' "$db_pair_results" | jq -c '[.[]|select(.rechecked==true)]|sort_by((.stats.retryCount//0),.stableScoreMs)|.[0]//null')"
            fi
        fi
        stable="$(printf '%s' "$db_pair_results" | jq '[.[]|select(.automaticEligible==true and .rechecked==true)]|length')"
        [ -z "$error" ] || break
        [ "$stable" -lt 2 ] || break
        if db_is_staged && [ "$limit" -lt "$count" ]; then
            limit=$((limit+8)); [ "$limit" -le "$count" ] || limit="$count"
            db_target_pairs="$limit"; db_shortlisted_pairs="$limit"; db_recommendation=null
            db_prefilter="$(printf '%s' "$db_prefilter" | jq -c --argjson deferred "$((db_candidates_total-limit))" '.deferred=$deferred')"
        else error=insufficient_working_pairs; fi
        done
    fi
    db_pool_stop; db_pair_json=null
    if [ -z "$error" ] && db_is_verified; then
        db_verify_finalists "$fingerprint" || error="$db_child_error"
    fi
    if [ -z "$error" ] && [ "$db_action" = recommend_verified ]; then
        db_write_proof "$db_pair_json" "$fingerprint" || error=proof_unavailable
    fi
    if [ -z "$error" ] && [ "$db_action" = recommend_reserve ]; then
        db_write_reserve_proof "$fingerprint" || error=proof_unavailable
    fi
    db_fast_context "$fingerprint" || error="$db_child_error"
    if [ -n "$error" ]; then
        rm -f "$DB_RESERVE_PROOF"
        db_selection_complete=false; db_exhaustive_selected=false; db_comparison_complete=false; db_recommendation=null; db_full_verification_complete=false
        if db_is_verified; then db_pair_json=null; rm -f "$DB_PROOF"; fi
        db_state error recommend "$error" 100 "$db_pairs_tested" "$db_target_pairs" "$error"; cp "$DB_STATUS" "$DB_REPORT"; return 1
    fi
    db_selection_complete=true; db_comparison_complete=true
    db_phase=complete
    if ! db_state done recommend recommendation_complete 100 "$db_pairs_tested" "$db_target_pairs" ''; then
        rm -f "$DB_RESERVE_PROOF"
        db_full_verification_complete=false; db_selection_complete=false; db_recommendation=null; db_pair_json=null; rm -f "$DB_PROOF"
        db_state error "$db_action" cancelled 100 "$db_pairs_tested" "$db_target_pairs" cancelled; cp "$DB_STATUS" "$DB_REPORT"; return 1
    fi
    cp "$DB_STATUS" "$DB_REPORT"
}
db_native_measure() {
    local domain output good=0 sum=0 nx=false attempted=0 nx_tested=false
    for domain in example.com youtube.com; do
        attempted=$((attempted+1))
        output="$(db_query "$domain" || true)"
        case "$output" in NOERROR\|*) good=$((good+1)); sum=$((sum+${output#*|}));; *) break;; esac
    done
    if [ "$good" = 2 ]; then
        nx_tested=true
        output="$(db_query "podkop-native-$$.invalid" || true)"
        [ "$output" != NXDOMAIN ] || nx=true
    fi
    jq -cn --argjson good "$good" --argjson attempted "$attempted" --argjson sum "$sum" --argjson nx "$nx" --argjson nx_tested "$nx_tested" '{successCount:$good,totalQueries:$attempted,plannedQueries:2,averageMs:(if $good>0 then $sum/$good else null end),nxdomainOk:$nx,nxdomainTested:$nx_tested,reliable:($good==2 and $nx),fullCompatibilityVerified:false,httpsTested:false,precheckOnly:true,probeScope:"direct_native_dns_ordering_only"}'
}

db_endpoint_only_if_needed() {
    local available required=147456 completed total count
    count="$(db_worker_configs | wc -l)"
    required=$((required+count*24576))
    available="$(awk '/MemAvailable:/ {print $2}' "${PODKOP_DNS_BENCHMARK_MEMINFO_FILE:-/proc/meminfo}")"
    case "$available" in ''|*[!0-9]*) return 1;; esac
    [ "$available" -lt "$required" ] || return 1
    db_native_mode=1; db_phase=endpoints
    [ "$db_deadline" -le "$(( $(date +%s)+120 ))" ] || db_deadline=$(( $(date +%s)+120 ))
