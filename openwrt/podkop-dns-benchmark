}

db_dns_transaction() {
    local helper_rc=0
    db_load_apply_helper || { db_transaction_error=dns_apply_helper_unavailable; return 1; }
    db_transaction_error=''; db_apply_signal=0; db_mutation_pending=1
    db_apply_launching=1
    PODKOP_DNS_APPLY_LOCK_HELD=1 dns_apply_worker "$@" > "$DB_DIR/apply-result.json.tmp" &
    db_apply_pid=$!
    db_apply_launching=0
