        db_phase=endpoint_only
        completed="$(jq -r '.completed' "$DB_STATUS")"; total="$(jq -r '.total' "$DB_STATUS")"
        db_state done "$db_action" endpoint_only 100 "$completed" "$total" '' || return 0
        jq --argjson available "$available" --argjson required "$required" '.measurementProfile="native_endpoints"|.recommendationScope="endpoint_ordering_only"|.fullVerificationDeferred=true|.deferredReason="insufficient_memory"|.memory={availableKb:$available,requiredKb:$required}|.selectionComplete=false|.recommendation=null|.pairResult=null|.fullVerificationComplete=false' "$DB_STATUS" > "$DB_STATUS.native.$$" &&
            mv "$DB_STATUS.native.$$" "$DB_STATUS"
        cp "$DB_STATUS" "$DB_REPORT"
    fi
    return 0
}

db_benchmark() {
    db_native_mode=1
    local protocol id provider server profile stats total completed=0 primary protocols bootstrap current bp bootstrap_protocols
    : > "$db_work/main"; : > "$db_work/bootstrap"
    protocols="$(uci -q get podkop.settings.dns_optimizer_protocols 2>/dev/null || true)"
    protocols="$(normalize_benchmark_protocols "${protocols:-auto}")" || { db_state error benchmark invalid_protocol 100 0 0 invalid_protocol; return 1; }
    for protocol in $protocols; do
        write_main_candidates "$protocol" "$db_work/catalog"
        while IFS= read -r line; do printf '%s|%s\n' "$protocol" "$line" >> "$db_work/main"; done < "$db_work/catalog"
    done
    bootstrap_protocols="$(uci -q get podkop.settings.dns_optimizer_bootstrap_protocols 2>/dev/null || true)"
    bootstrap_protocols="$(normalize_benchmark_protocols "${bootstrap_protocols:-udp}")" || { db_state error benchmark invalid_bootstrap_protocol 100 0 0 invalid_bootstrap_protocol; return 1; }
    for bp in $bootstrap_protocols; do
        if write_bootstrap_candidates "$db_work/catalog" "$bp"; then
            while IFS= read -r line; do printf '%s|%s\n' "$bp" "$line" >> "$db_work/bootstrap"; done < "$db_work/catalog"
        fi
    done
    total=$(( $(wc -l < "$db_work/main") + $(wc -l < "$db_work/bootstrap") ))
    if [ "$total" = 0 ]; then db_state error benchmark no_candidates 100 0 0 no_candidates; return 1; fi
    rm -f "$DB_PROOF"
    # Bootstrap DNS has a different job: resolve encrypted DNS endpoints. It
    # must not be rejected merely because it filters client service names.
    while IFS='|' read -r bp id provider server profile; do
        if ! db_runtime_safe; then db_state error benchmark "$db_child_error" 100 "$completed" "$total" "$db_child_error"; return 1; fi
        if [ "$(date +%s)" -ge "$db_deadline" ]; then db_child_error=measurement_timeout; db_state error benchmark measurement_timeout 100 "$completed" "$total" measurement_timeout; return 1; fi
        stats='{"successCount":0,"totalQueries":0,"averageMs":null,"reliable":false,"error":"child_failed"}'
        if db_native_start "$bp" "$server" "$server" "$bp" bootstrap; then stats="$(db_measure_bootstrap | jq '.precheckOnly=true|.probeScope="direct_native_dns_ordering_only"|.httpsTested=false|.fullCompatibilityVerified=false')";
        elif db_infrastructure_error "$db_child_error"; then db_child_stop; db_state error benchmark "$db_child_error" 100 "$completed" "$total" "$db_child_error"; return 1; fi
        db_child_stop
        db_bootstrap_results="$(jq -cn --argjson list "$db_bootstrap_results" --argjson stats "$stats" --arg protocol "$bp" --arg id "$id" --arg provider "$provider" --arg server "$server" '$list+[$stats+{protocol:$protocol,id:$id,provider:$provider,server:$server,precheckUsable:true}]')"
        completed=$((completed+1)); db_state running benchmark measuring "$((100*completed/total))" "$completed" "$total" ''
    done < "$db_work/bootstrap"
    current="$(uci -q get podkop.settings.bootstrap_dns_server 2>/dev/null || true)"
    bootstrap="$(printf '%s' "$db_bootstrap_results" | jq -r --arg current "$current" '[.[]|select(.reliable)] | sort_by(if .server==$current and .protocol=="udp" then -1 else .averageMs end) | .[0].server//empty')"
    bp="$(printf '%s' "$db_bootstrap_results" | jq -r --arg current "$current" '[.[]|select(.reliable)] | sort_by(if .server==$current and .protocol=="udp" then -1 else .averageMs end) | .[0].protocol//"udp"')"
    while IFS='|' read -r protocol id provider server profile; do
        if ! db_runtime_safe; then db_state error benchmark "$db_child_error" 100 "$completed" "$total" "$db_child_error"; return 1; fi
        if [ "$(date +%s)" -ge "$db_deadline" ]; then db_child_error=measurement_timeout; db_state error benchmark measurement_timeout 100 "$completed" "$total" measurement_timeout; return 1; fi
        primary="$(candidate_primary_eligible_json "$id" "$provider" "$server")"
        stats='{"successCount":0,"totalQueries":0,"averageMs":null,"reliable":false,"error":"bootstrap_unavailable"}'
        if [ -n "$bootstrap" ]; then
            stats='{"successCount":0,"totalQueries":0,"averageMs":null,"reliable":false,"error":"child_failed"}'
            if db_native_start "$protocol" "$server" "$bootstrap" "$bp"; then stats="$(db_native_measure)";
            elif db_infrastructure_error "$db_child_error"; then db_child_stop; db_state error benchmark "$db_child_error" 100 "$completed" "$total" "$db_child_error"; return 1; fi
        fi
        db_child_stop
        db_results="$(jq -cn --argjson list "$db_results" --argjson stats "$stats" --arg protocol "$protocol" --arg id "$id" --arg provider "$provider" --arg dnsServer "$server" --argjson primaryEligible "$primary" '$list+[$stats+{protocol:$protocol,id:$id,provider:$provider,dnsServer:$dnsServer,primaryEligible:$primaryEligible,precheckUsable:true,precheckOnly:true,probeScope:"direct_native_dns_ordering_only",httpsTested:false,fullCompatibilityVerified:false}]')"
        completed=$((completed+1)); db_state running benchmark measuring "$((100*completed/total))" "$completed" "$total" ''
    done < "$db_work/main"
    db_individual_complete=true
    if db_is_recommend; then db_state running "$db_action" precheck_complete 100 "$completed" "$total" ''; else db_state done benchmark benchmark_complete 100 "$completed" "$total" ''; fi
    cp "$DB_STATUS" "$DB_REPORT"
}
# Ordinary endpoint timing is deliberately separate from route-aware pair
# verification. Hitting this budget retains measurements, never apply proof.
db_quick_benchmark() {
    local started deadline result=0 completed total exhausted=false elapsed helper finished
    helper="${PODKOP_DNS_BENCHMARK_OPTIMIZER:-/usr/bin/podkop-dns-optimizer}"
    helper="${PODKOP_DIAGNOSTIC_POLICY:-${helper%/*}/podkop-diagnostic-policy.sh}"
    if [ ! -r "$helper" ]; then
        db_state error benchmark diagnostic_policy_unavailable 100 0 0 diagnostic_policy_unavailable; return 1
    fi
    # shellcheck disable=SC1090
    . "$helper"
    PODKOP_DIAG_MEMINFO_FILE="${PODKOP_DNS_BENCHMARK_MEMINFO_FILE:-/proc/meminfo}"
    diag_begin selection 60 || { db_state error benchmark clock_unavailable 100 0 0 clock_unavailable; return 1; }
    diag_admit 8192 || { db_state error benchmark insufficient_memory 100 0 0 insufficient_memory; return 1; }
    db_light_policy=1
    started="$(date +%s)"; deadline=$((started+60))
    [ "$db_deadline" -gt 0 ] && [ "$db_deadline" -le "$deadline" ] || db_deadline="$deadline"
    db_action=benchmark; db_native_mode=1
    db_recommendation=null; db_pair_json=null; db_pair_results='[]'
    db_selection_complete=false; db_full_verification_complete=false
    rm -f "$DB_PROOF"
    db_benchmark || result=$?
    if [ "$result" != 0 ]; then
        [ "$db_child_error" = measurement_timeout ] || return "$result"
        exhausted=true
    fi
    [ "$(date +%s)" -lt "$db_deadline" ] || exhausted=true
    diag_remaining >/dev/null || exhausted=true
    [ "$exhausted" != true ] || db_individual_complete=false
    finished="$(diag_now)" || { db_state error benchmark clock_unavailable 100 0 0 clock_unavailable; return 1; }
    elapsed=$((finished-DIAG_STARTED))
    [ "$elapsed" -ge 0 ] || { db_state error benchmark clock_unavailable 100 0 0 clock_unavailable; return 1; }
    completed="$(jq -r '.completed//0' "$DB_STATUS")"; total="$(jq -r '.total//0' "$DB_STATUS")"
    db_phase=quick_endpoints
    db_state done benchmark quick_dns_complete 100 "$completed" "$total" '' || return 1
    jq --argjson exhausted "$exhausted" --argjson elapsed "$elapsed" '
      .measurementProfile="native_endpoints"|.probeScope="direct_native_dns_ordering_only"|
      .budgetSeconds=60|.elapsedSeconds=$elapsed|.budgetExhausted=$exhausted|.partial=$exhausted|
      .individualComplete=($exhausted|not)|.selectionComplete=false|.searchComplete=false|
      .recommendation=null|.pairResult=null|.pairResults=[]|.httpsTested=false|
      .fullVerificationComplete=false|.fullCompatibilityVerified=false
    ' "$DB_STATUS" > "$DB_STATUS.quick.$$" &&
        mv "$DB_STATUS.quick.$$" "$DB_STATUS" &&
        cp "$DB_STATUS" "$DB_REPORT"
}

# lightweight_dns_pairs_v1 begin
# Native DNS-chain proof only: never route/application proof, never a second engine.
db_light_policy_load() {
    local helper="${PODKOP_DNS_BENCHMARK_OPTIMIZER:-/usr/bin/podkop-dns-optimizer}"
    helper="${PODKOP_DIAGNOSTIC_POLICY:-${helper%/*}/podkop-diagnostic-policy.sh}"
    [ -r "$helper" ] || return 1
    . "$helper"
    PODKOP_DIAG_MEMINFO_FILE="${PODKOP_DNS_BENCHMARK_MEMINFO_FILE:-/proc/meminfo}"
    db_light_policy=1; db_native_mode=1; db_probe_deadline=0; db_deadline=0
}
db_light_context() (
    local path file count=0 bytes=0 size
    path="$(db_runtime_path)" || exit 1
    [ -f "${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}" ] || exit 1
    sha256sum "${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}" || exit 1
    cat /proc/sys/kernel/random/boot_id || exit 1
    for file in "$path" $(db_worker_configs); do
        [ -f "$file" ] && [ ! -L "$file" ] || exit 1
        size="$(wc -c < "$file")"; bytes=$((bytes+size)); count=$((count+1))
        [ "$bytes" -le 2097152 ] && [ "$count" -le 16 ] || exit 1
        # A different detour requires route-aware diagnostics. Do not infer it
        # from successful queries sent directly by this process.
        jq --stream -ne '
          reduce inputs as $i ({dns:{servers:[]},outbounds:[]};
            if ($i|length)==2 and
              (($i[0][0:2]==["dns","servers"] and
                (($i[0]|length)==4 and ($i[0][3]=="tag" or $i[0][3]=="detour") or
                 ($i[0]|length)==5 and $i[0][3:5]==["tls","insecure"])) or
               ($i[0][0]=="outbounds" and ($i[0]|length)==3 and
                ($i[0][2]=="tag" or $i[0][2]=="type")))
            then setpath($i[0];$i[1]) else . end) |
          . as $c | [.dns.servers[]?|select(.tag=="dns-server")] as $m |
          [.dns.servers[]?|select(.tag=="bootstrap-dns-server")] as $b |
          ($m|length)==1 and ($b|length)==1 and
          all(($m+$b)[]; (.detour//"direct-out") as $d |
            any($c.outbounds[]?;.tag==$d and .type=="direct")) and
          all(($m+$b)[]; (.tls.insecure//false)==false)
        ' "$file" >/dev/null || exit 1
        sha256sum "$file" || exit 1
    done
)
db_light_fingerprint() {
    local context
    context="$(db_light_context)" || return 1
    printf '%s\n' "$context" | sha256sum | awk '{print $1}'
}
db_light_catalog() {
    local kind="$1" protocols="$2" p id label server profile family endpoint key
    : > "$db_work/light-$kind.tsv"
    for p in $protocols; do
        if [ "$kind" = main ]; then write_main_candidates "$p" "$db_work/catalog"
        else write_bootstrap_candidates "$db_work/catalog" "$p"; fi || continue
        while IFS='|' read -r id label server profile; do
            diag_remaining >/dev/null || break
            if [ "$kind" = main ]; then
                [ "$(candidate_primary_eligible_json "$id" "$label" "$server")" = true ] || continue
            fi
            family="$(db_provider_family "$label")"; [ -n "$family" ] || continue
            endpoint="$(dns_catalog_endpoint "$p" "$server" "$kind")" || continue
            key="$(printf '%s' "$endpoint" | jq -cS --arg p "$p" '{p:$p,host,port,path,server_name}')" || continue
            printf '%s|%s|%s|%s|%s|%s\n' "$p" "$id" "$label" "$server" "$family" "$key"
        done < "$db_work/catalog"
    done | awk -F'|' '!seen[$6]++ {print}' > "$db_work/light-$kind.all"
    # First round covers providers before alternate addresses/protocols.
    awk -F'|' '!seen[$5]++ {print}' "$db_work/light-$kind.all" > "$db_work/light-$kind.tsv"
    awk -F'|' 'seen[$5]++ {print}' "$db_work/light-$kind.all" >> "$db_work/light-$kind.tsv"
}
db_light_collect() {
    local p id label server family key stats bp bootstrap protocols bprotocols remaining
    protocols="$(uci -q get podkop.settings.dns_optimizer_protocols 2>/dev/null || true)"
    bprotocols="$(uci -q get podkop.settings.dns_optimizer_bootstrap_protocols 2>/dev/null || true)"
    protocols="$(normalize_benchmark_protocols "${protocols:-auto}")" || return 1
    bprotocols="$(normalize_benchmark_protocols "${bprotocols:-udp}")" || return 1
    db_light_catalog main "$protocols" && db_light_catalog bootstrap "$bprotocols" || return 1
    : > "$db_work/light-boot.rows"; : > "$db_work/light-main.rows"
    # Bound candidate and subprocess counts, not only wall-clock duration.
    head -n 6 "$db_work/light-bootstrap.tsv" > "$db_work/light-probes"
    while IFS='|' read -r p id label server family key; do
        remaining="$(diag_remaining)" || break
        [ "$remaining" -gt 42 ] || break
        stats='{"reliable":false}'
        if db_native_start "$p" "$server" "$server" "$p" bootstrap; then stats="$(db_native_measure)"; fi
        jq -cn --argjson s "$stats" --arg p "$p" --arg id "$id" --arg server "$server" --arg f "$family" \
          '$s+{protocol:$p,id:$id,server:$server,family:$f}' >> "$db_work/light-boot.rows"
    done < "$db_work/light-probes"
    jq -s 'sort_by(.averageMs//999999)' "$db_work/light-boot.rows" > "$db_work/light-boot.json"
    bootstrap="$(jq -r '[.[]|select(.reliable)][0].server//empty' "$db_work/light-boot.json")"
    bp="$(jq -r '[.[]|select(.reliable)][0].protocol//"udp"' "$db_work/light-boot.json")"
    head -n 12 "$db_work/light-main.tsv" > "$db_work/light-probes"
    if [ -n "$bootstrap" ]; then
        while IFS='|' read -r p id label server family key; do
            remaining="$(diag_remaining)" || break
            [ "$remaining" -gt 27 ] || break
            stats='{"reliable":false}'
            if db_native_start "$p" "$server" "$bootstrap" "$bp"; then stats="$(db_native_measure)"; fi
            jq -cn --argjson s "$stats" --arg p "$p" --arg id "$id" --arg server "$server" --arg f "$family" \
              '$s+{protocol:$p,id:$id,dnsServer:$server,family:$f}' >> "$db_work/light-main.rows"
        done < "$db_work/light-probes"
    fi
    jq -s 'sort_by(.averageMs//999999)' "$db_work/light-main.rows" > "$db_work/light-main.json"
}
db_light_rank() {
    jq -n --slurpfile m "$db_work/light-main.json" --slurpfile b "$db_work/light-boot.json" '
      [$m[0][]|select(.reliable)|. as $m |
       $b[0][]|select(.reliable and .family!=$m.family)|. as $b |
       {protocol:$m.protocol,id:$m.id,dnsServer:$m.dnsServer,bootstrapDnsServer:$b.server,
        bootstrapProtocol:$b.protocol,mainFamily:$m.family,bootstrapFamily:$b.family,
        averageMs:($m.averageMs+$b.averageMs)}] |
      unique_by([.protocol,.dnsServer,.bootstrapProtocol,.bootstrapDnsServer]) | sort_by(.averageMs) |
      .[:24] | map(.+{key:([.protocol,.id,.dnsServer,.bootstrapDnsServer,.bootstrapProtocol]|join("|"))})
    ' > "$db_work/light-pairs.json"
}
db_light_pick() {
    jq -c --argjson failed "$1" '
      map(select(.key as $k|$failed|index($k)==null)) as $p |
      [ $p[] as $a | $p[] |
        select(.mainFamily!=$a.mainFamily and .mainFamily!=$a.bootstrapFamily and
          .bootstrapFamily!=$a.mainFamily and .bootstrapFamily!=$a.bootstrapFamily) |
        {primary:$a,secondary:.} ][0] // {primary:$p[0],secondary:null}
    ' "$db_work/light-pairs.json"
}
db_light_probe() {
    local p="$1" server="$2" boot="$3" bp="$4" end="$DIAG_DEADLINE" now stats output rc=1
    now="$(diag_now)" || return 1
    [ "$DIAG_DEADLINE" -le "$((now+12))" ] || DIAG_DEADLINE=$((now+12))
    # Bootstrap must answer independently, even when the main endpoint is an IP.
    if db_native_start "$bp" "$boot" "$boot" "$bp" bootstrap &&
       output="$(db_query example.com)" && [ "${output%%|*}" = NOERROR ] &&
       db_native_start "$p" "$server" "$boot" "$bp"; then
        stats="$(db_native_measure)" &&
        printf '%s' "$stats" | jq -e '.reliable==true' >/dev/null &&
        diag_remaining >/dev/null && rc=0
    fi
    DIAG_DEADLINE="$end"
    [ "$rc" = 0 ] || return 1
    printf '%s' "$stats" | jq '.+{success:true,scope:"direct_dns_pair",httpsTested:false,fullCompatibilityVerified:false}'
}
db_light_publish() {
    local complete="$1" primary="$2" secondary="$3" fingerprint="$4" error="${5:-}" elapsed
    elapsed=$(( $(diag_now)-DIAG_STARTED ))
    jq -cn --arg report "$db_report_id" --argjson complete "$complete" --argjson p "$primary" --argjson s "$secondary" \
      --argjson elapsed "$elapsed" --arg error "$error" --argjson pid "$db_worker_pid" \
      '{state:"done",action:"select",reportId:$report,operationId:$report,pid:$pid,progress:100,
       selectionComplete:$complete,partial:($complete|not),recommendation:(if $complete then $p else null end),
       secondaryRecommendation:(if $complete then $s else null end),pairResults:([$p,$s]|map(select(.!=null))),
       scope:"direct_dns_pair",measurementProfile:"native_pairs",budgetSeconds:60,elapsedSeconds:$elapsed,
       searchComplete:false,httpsTested:false,fullCompatibilityVerified:false,
       error:(if $error=="" then null else $error end)}' > "$DB_STATUS.tmp.$$" || return 1
    [ ! -e "$db_cancel_file" ] || return 1
    mv "$DB_STATUS.tmp.$$" "$DB_STATUS" && cp "$DB_STATUS" "$DB_REPORT" || return 1
    if [ "$complete" = true ]; then
        jq --arg fingerprint "$fingerprint" --argjson tested "$(diag_now)" \
          '.+{fingerprint:$fingerprint,testedMonotonic:$tested}' "$DB_REPORT" > "$DB_PERSIST/light-pairs-proof.json.tmp.$$" &&
          mv "$DB_PERSIST/light-pairs-proof.json.tmp.$$" "$DB_PERSIST/light-pairs-proof.json"
    fi
}
db_light_select() {
    local fingerprint after choice primary=null secondary=null failed='[]' stats key row attempts=0 complete=false error=''
    db_light_policy_load && diag_begin selection 60 && diag_admit 8192 || {
        db_state error select insufficient_memory 100 0 0 insufficient_memory; return 1;
    }
    rm -f "$DB_PERSIST/light-pairs-proof.json" "$DB_PROOF" "$DB_RESERVE_PROOF"
    fingerprint="$(db_light_fingerprint)" || { db_light_publish false null null '' unsupported_dns_route; return; }
    db_production_capture || { db_state error select production_stopped 100 0 0 production_stopped; return 1; }
    db_light_collect && db_light_rank || { db_light_publish false null null '' incomplete_measurement; return; }
    : > "$db_work/light-confirmed.rows"
    while [ "$attempts" -lt 8 ] && diag_remaining >/dev/null; do
        choice="$(db_light_pick "$failed")" || return 1
        primary="$(printf '%s' "$choice" | jq -c '.primary')"; secondary="$(printf '%s' "$choice" | jq -c '.secondary')"
        [ "$primary" != null ] && [ "$secondary" != null ] || break
        for row in "$primary" "$secondary"; do
            key="$(printf '%s' "$row" | jq -r '.key')"
            if jq -se --arg k "$key" 'any(.[];.key==$k)' "$db_work/light-confirmed.rows" >/dev/null; then continue; fi
            attempts=$((attempts+1))
            set -- $(printf '%s' "$row" | jq -r '[.protocol,.dnsServer,.bootstrapDnsServer,.bootstrapProtocol]|join(" ")')
            if stats="$(db_light_probe "$@")" && diag_remaining >/dev/null; then
                printf '%s' "$row" | jq -c --argjson s "$stats" '.+$s' >> "$db_work/light-confirmed.rows"
            else
                failed="$(printf '%s' "$failed" | jq -c --arg k "$key" '.+[$k]')"
                break
            fi
        done
        primary="$(jq -sc --arg k "$(printf '%s' "$primary" | jq -r '.key')" '[.[]|select(.key==$k)][0]' "$db_work/light-confirmed.rows")"
        secondary="$(jq -sc --arg k "$(printf '%s' "$secondary" | jq -r '.key')" '[.[]|select(.key==$k)][0]' "$db_work/light-confirmed.rows")"
        if [ "$primary" != null ] && [ "$secondary" != null ]; then complete=true; break; fi
    done
    diag_remaining >/dev/null || { complete=false; error=measurement_timeout; }
    db_production_safe && after="$(db_light_fingerprint)" && [ "$fingerprint" = "$after" ] || { complete=false; error=runtime_changed; }
    [ "$complete" = true ] || { primary=null; secondary=null; [ -n "$error" ] || error=independent_reserve_unavailable; }
    db_light_publish "$complete" "$primary" "$secondary" "$fingerprint" "$error"
}
db_light_proof_valid() {
    local fingerprint now proof="$DB_PERSIST/light-pairs-proof.json"
    [ ! -e "$db_cancel_file" ] && [ -s "$proof" ] && [ -s "$DB_REPORT" ] || return 1
    db_light_policy_load || return 1
    now="$(diag_now)" && fingerprint="$(db_light_fingerprint)" || return 1
    jq -e --arg id "$1" --arg fingerprint "$fingerprint" --argjson now "$now" --slurpfile r "$DB_REPORT" '
      .reportId==$id and .reportId==$r[0].reportId and .fingerprint==$fingerprint and
      .state=="done" and .selectionComplete==true and .partial==false and .scope=="direct_dns_pair" and
      .testedMonotonic<=$now and $now-.testedMonotonic<=300 and
      .recommendation.success==true and .secondaryRecommendation.success==true and
      .recommendation==$r[0].recommendation and .secondaryRecommendation==$r[0].secondaryRecommendation
    ' "$proof" >/dev/null
}
db_light_apply() {
