    if [ "$helper_rc" = 0 ] && jq -e 'type=="object" and .success==true' "$DB_DIR/apply-result.json" >/dev/null 2>&1; then return 0; fi
    db_transaction_error="$(jq -er 'if type=="object" and (.error|type)=="string" and (.error|length)>0 then .error else "dns_apply_result_unknown" end' "$DB_DIR/apply-result.json" 2>/dev/null)" || db_transaction_error=dns_apply_result_unknown
    [ -n "$db_transaction_error" ] || db_transaction_error=dns_apply_result_unknown
    return 1
