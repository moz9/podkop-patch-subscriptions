db_apply() {
    podkop_mutation_lock_acquire dns_benchmark_apply || { db_state error apply busy 100 0 1 busy; return 1; }
    # Check after acquiring the shared mutation lock, not only at RPC admission.
    if ! db_proof_valid "$@" || db_reload_busy; then db_state error apply stale_proof 100 0 1 stale_proof; return 1; fi
    db_state running apply applying 10 0 1 ''
    rm -f "$DB_PROOF"
    if db_dns_transaction apply "$1" "$3" "${5:-udp}" "$4"; then db_state done apply apply_complete 100 1 1 ''; return 0; fi
    db_state error apply "$db_transaction_error" 100 1 1 "$db_transaction_error"
    return 1
}
db_reserve_status() {
    local work result file="${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}"
    local ready=false report_id='' save_error='' tuple protocol id server bootstrap bp pending
    db_load_apply_helper || { db_reply dns_apply_helper_unavailable; return 1; }
    db_prepare
    work="$(mktemp -d "$DB_DIR/reserve-read.XXXXXX")" || return 1
    if [ ! -L "$file" ] && dns_reserve_export "$file" > "$work/podkop" && result="$(dns_reserve_fields "$work/podkop")"; then
        rm -rf "$work"
        # Old reserve reports have no backend-owned context proof. Never mint
        # one from a display report; expose admission so the UI can require a
        # fresh selection after upgrade without offering a doomed Save action.
        if [ -s "$DB_REPORT" ] && tuple="$(jq -er 'select(.action=="recommend_reserve" and .state=="done" and .fullVerificationComplete==true) | [.recommendation.protocol,.recommendation.id,.recommendation.dnsServer,.recommendation.bootstrapDnsServer,.recommendation.bootstrapProtocol]|join("|")' "$DB_REPORT")"; then
            report_id="$(jq -r '.reportId//""' "$DB_REPORT")"
            IFS='|' read -r protocol id server bootstrap bp <<EOF
$tuple
EOF
            if [ ! -s "$DB_RESERVE_PROOF" ]; then save_error=reserve_recheck_required
            elif db_reserve_proof_valid "$protocol" "$id" "$server" "$bootstrap" "$bp"; then
                if [ "$(printf '%s' "$result" | jq -r '.activeSlot')" != primary ] || [ "$(configured_active_slot)" != primary ]; then save_error=reserve_is_active
                elif ! pending="$(uci -q changes podkop)"; then save_error=reserve_pending_unavailable
                elif ! dns_reserve_pending_safe "$pending"; then save_error=reserve_pending_conflict
                elif db_reload_busy; then save_error=busy
                else ready=true; fi
            else save_error=stale_reserve_proof; fi
        fi
        jq -cn --argjson reserve "$result" --argjson ready "$ready" --arg saveReportId "$report_id" --arg saveError "$save_error" \
          '{success:true,error:null,reserve:$reserve,saveReady:$ready,saveReportId:$saveReportId,saveError:(if $saveError=="" then null else $saveError end)}'
    else rm -rf "$work"; db_reply reserve_readback_failed; return 1; fi
}
db_reserve_save() {
    local error
    podkop_mutation_lock_acquire dns_reserve_save || { db_state error reserve_save busy 100 0 1 busy; return 1; }
    if ! db_reserve_proof_valid "$@" || db_reload_busy; then db_state error reserve_save stale_reserve_proof 100 0 1 stale_reserve_proof; return 1; fi
    [ "$(configured_active_slot)" = primary ] || { db_state error reserve_save reserve_is_active 100 0 1 reserve_is_active; return 1; }
    db_load_apply_helper || { db_state error reserve_save dns_apply_helper_unavailable 100 0 1 dns_apply_helper_unavailable; return 1; }
    # Signals cannot interrupt the tiny rename boundary. Cancel likewise
    # refuses reserve-save mutations; this action never starts a service.
    # Commit context needs the original admitted tuple, not helper's arguments.
    db_reserve_tuple_protocol="$1"; db_reserve_tuple_id="$2"; db_reserve_tuple_server="$3"; db_reserve_tuple_bootstrap="$4"; db_reserve_tuple_bp="${5:-udp}"
    db_reserve_commit_context() { db_reserve_proof_valid "$db_reserve_tuple_protocol" "$db_reserve_tuple_id" "$db_reserve_tuple_server" "$db_reserve_tuple_bootstrap" "$db_reserve_tuple_bp" && ! db_reload_busy; }
    db_state running reserve_save saving_reserve 10 0 1 ''
    trap '' INT TERM HUP
    if dns_reserve_save "$1" "$3" "${5:-udp}" "$4"; then
        trap 'db_worker_signal' INT TERM HUP
        db_state done reserve_save reserve_save_complete 100 1 1 ''; return 0
    fi
    error="${DNS_RESERVE_ERROR:-reserve_commit_failed}"
    trap 'db_worker_signal' INT TERM HUP
    db_state error reserve_save "$error" 100 0 1 "$error"; return 1
}
db_rollback() {
    podkop_mutation_lock_acquire dns_benchmark_rollback || { db_state error rollback busy 100 0 1 busy; return 1; }
    db_state running rollback restoring 10 0 1 ''
    rm -f "$DB_PROOF"
    if db_dns_transaction rollback; then db_state done rollback rollback_complete 100 1 1 ''; return 0; fi
    db_state error rollback "$db_transaction_error" 100 1 1 "$db_transaction_error"; return 1
}

db_worker_signal() {
    # The PID must be recorded before recovery can forward a signal.
    if [ "$db_apply_launching" = 1 ]; then db_apply_signal=1; return; fi
    # Do not interrupt recovery with a second catchable signal. EXIT cleanup
    # releases the shared mutation and worker locks only after this completes.
    trap '' INT TERM HUP
    db_recommendation='null'; db_selection_complete=false; db_exhaustive_selected=false; db_comparison_complete=false
    db_full_verification_complete=false
    if db_is_verified; then db_pair_json=null; fi
    rm -f "$DB_PROOF" "$DB_RESERVE_PROOF"
    if [ "$db_mutation_pending" = 1 ]; then
        if [ -n "$db_apply_pid" ]; then db_owned_child "$db_apply_pid" && kill -TERM "$db_apply_pid" 2>/dev/null || true; wait "$db_apply_pid" 2>/dev/null || true; db_apply_pid=''; fi
        db_mutation_pending=0
        if jq -e '.success==true' "$DB_DIR/apply-result.json.tmp" >/dev/null 2>&1; then
            db_state done "$db_action" "${db_action}_complete" 100 1 1 ''
        elif jq -e '.restored==true' "$DB_DIR/apply-result.json.tmp" >/dev/null 2>&1; then
            db_state error "$db_action" "${db_action}_interrupted_rolled_back" 100 1 1 "${db_action}_interrupted_rolled_back"
        elif jq -e '.changed==false' "$DB_DIR/apply-result.json.tmp" >/dev/null 2>&1; then
            db_state error "$db_action" dns_apply_interrupted_unchanged 100 1 1 dns_apply_interrupted_unchanged
        else db_state error "$db_action" rollback_failed 100 1 1 rollback_failed; fi
        cp "$DB_STATUS" "$DB_REPORT"
    else db_state cancelled "$db_action" cancelled 100 0 0 cancelled; fi
    exit 130
}
db_cleanup() {
    if [ -n "$db_apply_pid" ]; then db_owned_child "$db_apply_pid" && kill -TERM "$db_apply_pid" 2>/dev/null || true; wait "$db_apply_pid" 2>/dev/null || true; db_apply_pid=''; fi
    db_pool_stop
    db_child_stop
    podkop_mutation_lock_release
    if [ -n "$db_work" ]; then rm -rf "$db_work"; fi
    if [ -f "$DB_LOCK/owner" ] && [ "$(cat "$DB_LOCK/owner")" = "$$" ]; then rm -f "$DB_LOCK/owner" "$DB_LOCK/identity"; rmdir "$DB_LOCK" 2>/dev/null || true; fi
}

# Shared configured-pair health check for transports unsupported by busybox dig.
# It has no status/report/proof side effects and does not require catalog IDs.
db_probe_pair() {
    local slot="$1" pair protocol server bootstrap bp prefix stats='null' error='' success=false
    case "$slot" in primary) prefix='';; secondary) prefix=secondary_;; *) db_reply invalid_slot; return 1;; esac
    pair="$(read_configured_pair "$slot" || true)"
    protocol="${pair%%|*}"; pair="${pair#*|}"
    server="${pair%%|*}"; bootstrap="${pair#*|}"
    bp="$(uci -q get "podkop.settings.${prefix}bootstrap_dns_type" 2>/dev/null || true)"; bp="${bp:-udp}"
    db_prepare
    if ! mkdir "$DB_LOCK" 2>/dev/null; then jq -cn --arg slot "$slot" '{success:false,slot:$slot,error:"busy"}'; return 0; fi
    printf '%s\n' "$$" > "$DB_LOCK/owner"
    rm -f "$DB_DIR/cancel"
    db_work="$(mktemp -d "$DB_DIR/probe.XXXXXX")"
    DB_STATUS="$db_work/status.json"
    db_deadline=$(( $(date +%s)+90 ))
    trap 'db_cleanup' EXIT
    trap 'exit 130' INT TERM HUP
    if db_child_start "$protocol" "$server" "$bootstrap" "$bp"; then
        stats="$(db_measure)"
        if printf '%s' "$stats" | jq -e '.reliable' >/dev/null; then success=true; else error="$(printf '%s' "$stats" | jq -r '.error//"dns_query_failed"')"; fi
    else error="$db_child_error"; fi
    db_child_stop
    jq -cn --arg slot "$slot" --arg protocol "$protocol" --arg bootstrapProtocol "$bp" --argjson stats "$stats" --argjson success "$success" --arg error "$error" '{success:$success,slot:$slot,protocol:$protocol,bootstrapProtocol:$bootstrapProtocol,stats:$stats,error:(if $error=="" then null else $error end)}'
    db_cleanup
    trap - EXIT INT TERM HUP
}
db_validate_bootstrap_request() {
    local boot main host
    case "$1:$3" in udp:udp|udp:tcp|udp:doh|udp:dot|tcp:udp|tcp:tcp|tcp:doh|tcp:dot|doh:udp|doh:tcp|doh:doh|doh:dot|dot:udp|dot:tcp|dot:doh|dot:dot) :;; *) return 1;; esac
    boot="$(dns_catalog_endpoint "$1" "$2" bootstrap)" || return 1
    is_ipv4 "$(printf '%s' "$boot" | jq -r '.host')" || return 1
    main="$(dns_catalog_endpoint "$3" "$4" main)" || return 1
    host="$(printf '%s' "$main" | jq -er '.host|select(type=="string")')" || return 1
    # OpenWrt jq-small has no regex library; keep admission portable.
    case "$host" in ''|*[!A-Za-z0-9.-]*) return 1;; *) return 0;; esac
}
db_test_bootstrap() {
    local host error=''
    db_pair_json=null; db_recommendation=null; db_bootstrap_test=null
    db_state running bootstrap_test bootstrap_check 0 0 1 ''
    host="$(dns_catalog_endpoint "$3" "$4" main | jq -r '.host')" || error=invalid_endpoint
    if [ -z "$error" ]; then
        db_bootstrap_test="$(probe_bootstrap "$1" "$2" "$host" || true)"
        if ! printf '%s' "$db_bootstrap_test" | jq -e 'type=="object" and .success==true' >/dev/null 2>&1; then error=bootstrap_query_failed; fi
    fi
    [ -n "$db_bootstrap_test" ] || db_bootstrap_test=null
    # Diagnostic status is separate from the completed pair proof/report.
    if [ -z "$error" ]; then db_state done bootstrap_test bootstrap_complete 100 1 1 ''; else db_state error bootstrap_test "$error" 100 1 1 "$error"; return 1; fi
}
db_worker() {
    db_action="$1"; shift
    local ready_wait=0
    while [ ! -f "$DB_DIR/start.ready" ] && [ "$ready_wait" -lt 5 ]; do sleep 1; ready_wait=$((ready_wait+1)); done
    [ -f "$DB_DIR/start.ready" ] || return 1
    db_worker_pid=$$; printf '%s\n' "$$" > "$DB_LOCK/owner"
    db_coordinator_identity "$$" > "$DB_LOCK/identity" || return 1
    db_recommendation='null'; db_selection_complete=false; db_phase=''; db_tested_sections='[]'
    db_full_verification_complete=false; db_full_verification_attempts=0; db_full_verification_results='[]'
    db_report_id="$(date +%s)-$$"; db_work="$(mktemp -d "$DB_DIR/work.XXXXXX")"
    db_measurement_profile=full; db_probe_deadline=0
    if db_is_recommend; then db_deadline=$(( $(date +%s)+7200 )); elif [ "$db_action" = pairs ]; then db_deadline=$(( $(date +%s)+7200 )); elif [ "$db_action" = benchmark ]; then db_deadline=$(( $(date +%s)+60 )); else db_deadline=$(( $(date +%s)+180 )); fi
    trap 'db_cleanup' EXIT
    trap 'db_worker_signal' INT TERM HUP
    if [ -s "$DB_STATUS" ]; then
        db_results="$(jq -c '.results//[]' "$DB_STATUS")"
        db_bootstrap_results="$(jq -c '.bootstrapResults//[]' "$DB_STATUS")"
        db_available_results="$(jq -c '.availableResults//null' "$DB_STATUS")"
        db_available_bootstrap_results="$(jq -c '.availableBootstrapResults//null' "$DB_STATUS")"
        db_pair_results="$(jq -c '.pairResults//[]' "$DB_STATUS")"
        db_individual_complete="$(jq -r '.individualComplete//(.action=="benchmark" and .state=="done")' "$DB_STATUS")"
    fi
    if [ "$db_action" = benchmark ]; then db_results='[]'; db_bootstrap_results='[]'; db_pair_results='[]'; db_available_results='null'; db_available_bootstrap_results='null'; db_individual_complete=false; fi
    case "$db_action" in light_pair) db_light_manual "$@";; select) db_light_select;; select_apply) db_light_apply "$@";; recommend|recommend_full|recommend_verified|recommend_reserve) db_recommend;; bootstrap_test) db_test_bootstrap "$@";; benchmark) db_quick_benchmark;; pairs) db_pairs;; pair_test) db_pair_test "$@";; apply) db_apply "$@";; reserve_save) db_reserve_save "$@";; rollback) db_rollback;; esac
}
db_start() {
    local action="$1" pid holder
    shift; db_prepare
    db_recommendation='null'; db_selection_complete=false; db_phase=''; db_tested_sections='[]'
    db_full_verification_complete=false; db_full_verification_attempts=0; db_full_verification_results='[]'
    if db_busy; then db_reply busy; return 1; fi
    if [ "$action" = pair_test ] || [ "$action" = light_pair ] || [ "$action" = apply ]; then
        db_validate_pair "$@" || { db_reply invalid_pair; return 1; }
        if [ "$action" = apply ] && ! db_proof_valid "$@"; then db_reply stale_proof; return 1; fi
    fi
    if [ "$action" = select_apply ]; then db_light_proof_valid "$@" || { db_reply stale_proof; return 1; }; fi
    if [ "$action" = reserve_save ]; then db_reserve_proof_valid "$@" || { db_reply stale_reserve_proof; return 1; }; fi
    if [ "$action" = bootstrap_test ]; then db_validate_bootstrap_request "$@" || { db_reply invalid_endpoint; return 1; }; fi
    if ! mkdir "$DB_LOCK" 2>/dev/null; then
        holder="$(cat "$DB_LOCK/owner" 2>/dev/null || true)"
        if [ -z "$holder" ] || pid_alive "$holder"; then db_reply busy; return 1; fi
        rm -f "$DB_LOCK/owner" "$DB_LOCK/identity"; rmdir "$DB_LOCK" 2>/dev/null || { db_reply busy; return 1; }
        mkdir "$DB_LOCK" 2>/dev/null || { db_reply busy; return 1; }
    fi
    rm -f "$DB_DIR/cancel" "$DB_DIR/start.ready"
    db_worker_pid=0; db_action="$action"
    if [ -s "$DB_STATUS" ]; then
        db_results="$(jq -c '.results//[]' "$DB_STATUS")"; db_bootstrap_results="$(jq -c '.bootstrapResults//[]' "$DB_STATUS")"
        db_available_results="$(jq -c '.availableResults//null' "$DB_STATUS")"; db_available_bootstrap_results="$(jq -c '.availableBootstrapResults//null' "$DB_STATUS")"
        db_pair_results="$(jq -c '.pairResults//[]' "$DB_STATUS")"
        db_individual_complete="$(jq -r '.individualComplete//(.action=="benchmark" and .state=="done")' "$DB_STATUS")"
    fi
    if [ "$action" = select ] || [ "$action" = light_pair ]; then
        rm -f "$DB_PERSIST/light-pairs-proof.json"
        db_results='[]'; db_bootstrap_results='[]'; db_pair_results='[]'
        db_available_results=null; db_available_bootstrap_results=null
    fi
    db_state running "$action" starting 0 0 1 ''
    # Never put proofs or benchmark output in argv. Only validated public tuple.
    sh "$DB_SELF" __worker "$action" "$@" > "$DB_DIR/worker.log" 2>&1 < /dev/null &
    pid=$!; printf '%s\n' "$pid" > "$DB_LOCK/owner"
    db_coordinator_identity "$pid" > "$DB_LOCK/identity" || true
    jq --argjson pid "$pid" 'if .state=="running" then .pid=$pid else . end' "$DB_STATUS" > "$DB_STATUS.pid.$$"
    mv "$DB_STATUS.pid.$$" "$DB_STATUS"
    : > "$DB_DIR/start.ready"
    db_reply
}
db_cancel() {
    local action pid state
    db_prepare
    [ -s "$DB_STATUS" ] || { db_reply; return 0; }
    action="$(jq -r '.action' "$DB_STATUS")"; state="$(jq -r '.state' "$DB_STATUS")"; pid="$(jq -r '.pid//0' "$DB_STATUS")"
    if [ "$state" = running ] && { [ "$action" = apply ] || [ "$action" = rollback ] || [ "$action" = reserve_save ] || [ "$action" = select_apply ]; }; then db_reply busy; return 1; fi
    : > "$DB_DIR/cancel"
    if [ "$state" = running ] && [ "$pid" != 0 ] && db_coordinator_owned "$pid" "$action"; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$DB_PROOF" "$DB_RESERVE_PROOF"
    jq '.state="cancelled" | .message="cancelled" | .error="cancelled" | .selectionComplete=false | .fullVerificationComplete=false | .exhaustiveSelected=false | .comparisonComplete=false | .recommendation=null | (if .action=="recommend_verified" then .pairResult=null else . end)' "$DB_STATUS" > "$DB_STATUS.tmp.$$"; mv "$DB_STATUS.tmp.$$" "$DB_STATUS"
    db_reply
}

[ "${PODKOP_DNS_BENCHMARK_LIBRARY_ONLY:-0}" != 1 ] || return 0
case "${1:-}" in
    legacy_status) db_light_legacy_status;;
    legacy_apply_start) shift; db_light_legacy_apply "$@";;
    status) db_status;;
    reserve_status) db_reserve_status;;
    reserve_save_start) [ "$#" = 6 ] || { db_reply arguments_required; exit 1; }; shift; db_start reserve_save "$@";;
    light_pair_start) [ "$#" = 6 ] || { db_reply arguments_required; exit 1; }; shift; db_start light_pair "$@";;
    select_start) db_start select;;
    apply_selected_start) [ "$#" = 2 ] || { db_reply arguments_required; exit 1; }; db_start select_apply "$2";;
    benchmark_start) db_start benchmark;;
    recommend_start) db_start recommend;;
    recommend_full_start) db_start recommend_full;;
    recommend_verified_start) db_start recommend_verified;;
    recommend_reserve_start) db_start recommend_reserve;;
    bootstrap_test_start) [ "$#" = 5 ] || { db_reply arguments_required; exit 1; }; shift; db_start bootstrap_test "$@";;
    pairs_start) db_start pairs;;
    probe_pair) [ "$#" = 2 ] || { db_reply arguments_required; exit 1; }; db_probe_pair "$2";;
    pair_test_start|apply_start)
        { [ "$#" = 5 ] || [ "$#" = 6 ]; } || { db_reply arguments_required; exit 1; }
        if [ "$1" = pair_test_start ]; then db_action=pair_test; else db_action=apply; fi
        shift; db_start "$db_action" "$@";;
    rollback_start) db_start rollback;;
    cancel) db_cancel;;
    __worker) shift; db_worker "$@";;
    *) db_reply invalid_command; exit 1;;
esac
