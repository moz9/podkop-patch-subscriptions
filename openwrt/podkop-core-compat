#!/bin/sh
# Drop-in stock 1.12.12 ARM64 only. PE engines have their own Reality fix.
set -eu
umask 077
CORE_VERSION=1.12.12-pdk-reality1
CORE_SHA256=b16d1530c45417a28317aa188bc32b845e09b6232aab2f5cc5831b37a770744a
CORE_BYTES=36569223
CORE_URL=https://github.com/moz9/podkop-patch-subscriptions/releases/download/core-1.12.12-pdk-reality1/sing-box-1.12.12-pdk-reality1-linux-arm64
CORE_ROOT=''
CORE_ACTION_DIR=/tmp/podkop-subscription-action.lock.d
CORE_ACTION_FILE=/tmp/podkop-subscription-action.lock
core_valid_work() {
    local suffix
    case "$1" in "$CORE_ROOT"/root/podkop-core-compat.??????) ;; *) return 1;; esac
    suffix="${1#"$CORE_ROOT"/root/podkop-core-compat.}"
    case "$suffix" in *[!0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ]*) return 1;; esac
}
core_hash() { sha256sum "$1" | awk '{print $1}'; }
core_route() {
    case "$1:$2:$3" in
        pe:aarch64:1.14.2-pdk-r14|pe:aarch64:1.13.21-pdk-r11) echo native ;;
        legacy:aarch64:1.12.12) echo update ;;
        legacy:aarch64:1.12.12-pdk-reality1) [ "$4" = "$CORE_SHA256" ] && echo current ;;
        *) return 1 ;;
    esac
}
core_require_space() {
    # Disk holds new ELF plus untouched 8MiB. Old ELF is a retained hardlink.
    [ "$1" -ge "$((($3 + 1023) / 1024 + 8192))" ] && [ "$2" -ge 65536 ]
}
core_process_start() (
    stat="$(cat "/proc/$1/stat")" || exit 1
    stat="${stat##*) }"
    # /proc fields after comm are deliberately split into numbered fields.
    # shellcheck disable=SC2086
    set -- $stat
    shift 19
    case "$1" in ''|*[!0-9]*) exit 1;; esac
    printf '%s\n' "$1"
)
core_procd_identity() {
    [ "$(cat /proc/1/comm)" = procd ] || return 1
    printf '%s %s\n' "$(cat /proc/sys/kernel/random/boot_id)" "$(core_process_start 1)"
}
core_new_nonce() { cat /proc/sys/kernel/random/uuid; }
core_atomic_record() {
    # Same-directory rename: never expose a truncated/empty owner record.
    local target="$1" value="$2" staging="$1.core-$CORE_NONCE"
    test ! -L "$target" && test ! -L "$staging" || return 1
    printf '%s\n' "$value" > "$staging" && mv -f "$staging" "$target"
}
core_load_reservation() {
    test ! -L "$CORE_WORK/reservation" && test -s "$CORE_WORK/reservation" || return 1
    IFS=' ' read -r CORE_NONCE CORE_BOOT CORE_PROCD_START CORE_PARENT CORE_PARENT_START reserved_work extra < "$CORE_WORK/reservation"
    [ -z "$extra" ] && [ "$reserved_work" = "$CORE_WORK" ] || return 1
    local value
    for value in "$CORE_NONCE" "$CORE_BOOT"; do
        case "$value" in ''|*[!0123456789abcdef-]*) return 1;; esac
    done
    for value in "$CORE_PROCD_START" "$CORE_PARENT" "$CORE_PARENT_START"; do
        case "$value" in ''|*[!0123456789]*) return 1;; esac
    done
    [ "$(core_procd_identity)" = "$CORE_BOOT $CORE_PROCD_START" ] || return 1
    CORE_RESERVED_OWNER="1 core-compat $CORE_NONCE $CORE_BOOT $CORE_PROCD_START $CORE_WORK"
    CORE_RETURN_OWNER="$CORE_PARENT installer $CORE_NONCE"
}
core_reservation_matches() {
    core_load_reservation || return 1
    test ! -L "$CORE_ACTION_DIR/core-reservation" &&
        cmp -s "$CORE_WORK/reservation" "$CORE_ACTION_DIR/core-reservation"
}
core_record_allowed() {
    local record
    test ! -L "$1" || return 1
    record="$(cat "$1" 2>/dev/null)" || return 1
    [ "$record" = "$CORE_RESERVED_OWNER" ] || [ "$record" = "$CORE_RETURN_OWNER" ] || cmp -s "$1" "$2"
}
core_reserve() {
    # PID 1 is used ONLY as a compatibility reservation, never as an action
    # target. Boot/procd birth + nonce + private work/journal bind its ownership.
    [ "$(awk 'NR==1{print $1}' "$CORE_ACTION_DIR/owner")" = "$CORE_PARENT" ] || return 1
    [ "$(awk 'NR==1{print $1}' "$CORE_ACTION_FILE")" = "$CORE_PARENT" ] || return 1
    CORE_NONCE="$(core_new_nonce)" || return 1
    local identity parent_start
    identity="$(core_procd_identity)" || return 1
    parent_start="$(core_process_start "$CORE_PARENT")" || return 1
    cp "$CORE_ACTION_DIR/owner" "$CORE_WORK/owner.before" || return 1
    cp "$CORE_ACTION_FILE" "$CORE_WORK/legacy.before" || return 1
    core_atomic_record "$CORE_WORK/reservation" "$CORE_NONCE $identity $CORE_PARENT $parent_start $CORE_WORK" || return 1
    core_load_reservation || return 1
    test ! -e "$CORE_ACTION_DIR/core-reservation" || return 1
    core_atomic_record "$CORE_ACTION_DIR/core-reservation" "$(cat "$CORE_WORK/reservation")" || return 1
    # Journal makes the directory non-removable even during a partial handoff.
    # Legacy-only consumers must see the live reservation before the guard starts.
    core_atomic_record "$CORE_ACTION_FILE" "$CORE_RESERVED_OWNER" || return 1
    core_atomic_record "$CORE_ACTION_DIR/owner" "$CORE_RESERVED_OWNER"
}
core_drop_journal() {
    core_load_reservation || return 1
    if [ -e "$CORE_ACTION_DIR/core-reservation" ]; then
        core_reservation_matches || return 1
    fi
    rm -f "$CORE_ACTION_DIR/core-reservation.core-$CORE_NONCE" "$CORE_ACTION_DIR/owner.core-$CORE_NONCE" "$CORE_ACTION_FILE.core-$CORE_NONCE" || return 1
    # After journal removal, a later installer may legitimately own this lock.
    # Finish our staging cleanup first; terminal cleanup can then leave a new
    # owner's directory completely untouched when the journal is already gone.
    if [ -e "$CORE_ACTION_DIR/core-reservation" ]; then
        core_reservation_matches && rm -f "$CORE_ACTION_DIR/core-reservation" || return 1
    fi
    [ -e "$CORE_ACTION_DIR/owner" ] || rmdir "$CORE_ACTION_DIR" 2>/dev/null || true
}
core_snapshot() (
    # Called from conditional health paths too: do not rely on shell errexit.
    test -d "$CORE_ROOT/etc/config" || exit 1
    test -s "$CORE_ROOT/etc/sing-box/config.json" || exit 1
    links="$(find "$CORE_ROOT/etc/config" -type l)" || exit 1
    test -z "$links" || exit 1
    find "$CORE_ROOT/etc/config" -type f | LC_ALL=C sort | while IFS= read -r f; do sha256sum "$f" || exit 1; done || exit 1
    for rel in etc/sing-box/config.json etc/podkop/section-runtime/logical.json \
        etc/podkop/section-runtime/metadata.json etc/podkop/section-runtime/context.sha256 \
        etc/podkop/subscriptions/service-runtime/snapshot.json; do
        test ! -L "$CORE_ROOT/$rel" || exit 1
        if [ -e "$CORE_ROOT/$rel" ]; then sha256sum "$CORE_ROOT/$rel" || exit 1; else printf 'absent %s\n' "$rel"; fi
    done
    drafts="$(uci changes)" || exit 1
    test -z "$drafts"
)
core_restart() { timeout 20 /etc/init.d/sing-box restart; }
core_runtime_binding() (
    expected="$1"
    [ "$(core_hash "$CORE_ROOT/usr/bin/sing-box")" = "$expected" ] || exit 1
    runtime_pid="$(pidof sing-box)" || exit 1
    case "$runtime_pid" in ''|*[!0-9]*) exit 1;; esac
    birth="$(core_process_start "$runtime_pid")" || exit 1
    loaded="$(core_hash "$CORE_ROOT/proc/$runtime_pid/exe")" || exit 1
    [ "$loaded" = "$expected" ] || exit 1
    [ "$(uci -q get podkop.settings.config_path)" = /etc/sing-box/config.json ] || exit 1
    # Preserve NUL boundaries, including empty/additional trailing arguments.
    jq -Rse 'split("\u0000")==["/usr/bin/sing-box","run","-c","/etc/sing-box/config.json",""]' \
        "$CORE_ROOT/proc/$runtime_pid/cmdline" >/dev/null || exit 1
    service="$(ubus call service list '{"name":"sing-box","verbose":true}')" || exit 1
    printf '%s' "$service" | jq -e --argjson pid "$runtime_pid" '
      .["sing-box"].instances | select(type=="object") | to_entries |
      length==1 and .[0].value.running==true and .[0].value.pid==$pid and
      .[0].value.command==["/usr/bin/sing-box","run","-c","/etc/sing-box/config.json"]
    ' >/dev/null || exit 1
    # Reject PID reuse/process turnover while collecting the binding.
    [ "$(pidof sing-box)" = "$runtime_pid" ] && [ "$(core_process_start "$runtime_pid")" = "$birth" ] || exit 1
    printf '%s %s %s\n' "$runtime_pid" "$birth" "$loaded"
)
core_rollback() {
    local old_sha current_sha
    old_sha="$(cat "$CORE_WORK/before.sha256")" || return 1
    [ "$(core_hash "$CORE_WORK/sing-box.before")" = "$old_sha" ] || return 1
    test ! -L "$CORE_ROOT/usr/bin/sing-box" || return 1
    current_sha="$(core_hash "$CORE_ROOT/usr/bin/sing-box")" || return 1
    # A package/operator may have installed a different engine despite the
    # shared lock. That engine is not this transaction's rollback target.
    [ "$current_sha" = "$CORE_SHA256" ] || [ "$current_sha" = "$old_sha" ] || return 1
    if [ -e "$CORE_ROOT/usr/bin/sing-box.core-restore" ]; then
        test ! -L "$CORE_ROOT/usr/bin/sing-box.core-restore" || return 1
        [ "$(core_hash "$CORE_ROOT/usr/bin/sing-box.core-restore")" = "$old_sha" ] || return 1
    fi
    if [ "$current_sha" = "$old_sha" ]; then
        # A prior attempt may already have restored the inode, but failed DNS.
        # Renaming another hardlink onto that same inode fails on real mv.
        rm -f "$CORE_ROOT/usr/bin/sing-box.core-restore" || return 1
    else
        [ -e "$CORE_ROOT/usr/bin/sing-box.core-restore" ] ||
            ln "$CORE_WORK/sing-box.before" "$CORE_ROOT/usr/bin/sing-box.core-restore" || return 1
        mv -f "$CORE_ROOT/usr/bin/sing-box.core-restore" "$CORE_ROOT/usr/bin/sing-box" || return 1
    fi
    core_restart && core_wait_health "$old_sha"
}
core_health() {
    CORE_HEALTH_RUNTIME="$(core_runtime_binding "${1:-$CORE_SHA256}")" || return 1
    timeout 4 nslookup example.com 127.0.0.1 >/dev/null 2>&1 || return 1
    timeout 4 nslookup chatgpt.com 127.0.0.1 >/dev/null 2>&1 || return 1
    core_snapshot > "$CORE_WORK/after.sha256" || return 1
    cmp -s "$CORE_WORK/protected.sha256" "$CORE_WORK/after.sha256" || return 1
    [ "$(core_runtime_binding "${1:-$CORE_SHA256}")" = "$CORE_HEALTH_RUNTIME" ]
}
core_wait_health() {
    local expected="$1" n=0 deadline first_runtime
    deadline="$(( $(date +%s) + 60 ))"
    while [ "$n" -lt 15 ] && [ "$(date +%s)" -lt "$deadline" ]; do
        if core_health "$expected"; then
            first_runtime="$CORE_HEALTH_RUNTIME"
            sleep 2
            core_health "$expected" && [ "$CORE_HEALTH_RUNTIME" = "$first_runtime" ] && return 0
        fi
        sleep 1; n=$((n+1))
    done
    return 1
}
core_activate() {
    [ "$(core_hash "$CORE_WORK/sing-box.new")" = "$CORE_SHA256" ] || return 1
    core_runtime_binding "$(cat "$CORE_WORK/before.sha256")" > "$CORE_WORK/runtime.before-swap" || return 1
    cmp -s "$CORE_WORK/runtime.before" "$CORE_WORK/runtime.before-swap" || return 1
    core_snapshot > "$CORE_WORK/before-swap.sha256" || return 1
    cmp -s "$CORE_WORK/protected.sha256" "$CORE_WORK/before-swap.sha256" || return 1
    touch "$CORE_WORK/activated" || return 1
    mv -f "$CORE_WORK/sing-box.new" "$CORE_ROOT/usr/bin/sing-box" || return 1
    core_restart || return 1
    core_wait_health "$CORE_SHA256"
}
core_exit() {
    rc="$?"
    if [ -n "${CORE_WORK:-}" ] && [ -d "$CORE_WORK" ]; then
        if [ -e "$CORE_WORK/reservation" ]; then
            touch "$CORE_WORK/abort"
            echo "Core transaction interrupted; autonomous result: $CORE_WORK/result; recovery: sh $CORE_WORK/transaction.sh recover $CORE_WORK" >&2
        else
            # Only our not-yet-activated staging files, never an installed ELF.
            rm -f "$CORE_WORK/sing-box.new" "$CORE_WORK/sing-box.before"
        fi
    fi
    exit "$rc"
}
core_cleanup_finished_guard() {
    local guard="$CORE_ROOT/etc/init.d/podkop-core-compat-guard" previous state
    [ -e "$guard" ] || return 0
    test ! -L "$guard" || return 1
    grep -Fxq '# PODKOP_CORE_GUARD=1' "$guard" || return 1
    previous="$(sed -n 's/^# CORE_WORK=//p' "$guard")"
    core_valid_work "$previous" || return 1
    test ! -L "$previous" && test -f "$previous/lock-released" || return 1
    state="$(cat "$previous/result")"
    case "$state" in committed|rolled-back|not-activated) ;; *) return 1;; esac
    # Completed previous guard, not an unknown active transaction.
    core_finish_handoff "$previous" || return 1
    core_service_action stop || return 1
    rm -f "$guard"
}
core_finish_handoff() (
    CORE_WORK="$1"
    core_valid_work "$CORE_WORK" && test ! -L "$CORE_WORK" || exit 1
    test -f "$CORE_WORK/terminal" && test -f "$CORE_WORK/lock-released" || exit 1
    case "$(cat "$CORE_WORK/result")" in committed|rolled-back|not-activated) ;; *) exit 1;; esac
    if [ ! -e "$CORE_ACTION_DIR/core-reservation" ] && [ ! -L "$CORE_ACTION_DIR/core-reservation" ]; then
        # Already complete. A new installer may now own the shared lock;
        # stopping our terminal guard must not inspect/mutate that new owner.
        exit 0
    fi
    core_load_reservation || exit 1
    # The marker fences respawns; it is NOT proof the following journal unlink
    # finished. Complete that matching cleanup before stopping its supervisor.
    for target in "$CORE_ACTION_DIR/owner" "$CORE_ACTION_FILE"; do
        if [ -e "$target" ] || [ -L "$target" ]; then
            test ! -L "$target" && [ "$(cat "$target")" = "$CORE_RETURN_OWNER" ] || exit 1
        fi
    done
    core_drop_journal || exit 1
    test ! -e "$CORE_ACTION_DIR/core-reservation" && test ! -L "$CORE_ACTION_DIR/core-reservation"
)
core_release_lock() {
    core_reservation_matches || return 1
    test -f "$CORE_WORK/terminal" || return 1
    local record target original
    # Mixed original/reserved/returned records are a valid interrupted transfer.
    # Anything else belongs to somebody else and is never overwritten.
    for target in "$CORE_ACTION_DIR/owner" "$CORE_ACTION_FILE"; do
        original="$CORE_WORK/owner.before"
        [ "$target" != "$CORE_ACTION_FILE" ] || original="$CORE_WORK/legacy.before"
        if [ -e "$target" ]; then core_record_allowed "$target" "$original" || return 1; fi
    done
    if [ "$(core_process_start "$CORE_PARENT" 2>/dev/null || true)" = "$CORE_PARENT_START" ]; then
        core_atomic_record "$CORE_ACTION_DIR/owner" "$CORE_RETURN_OWNER" || return 1
        core_atomic_record "$CORE_ACTION_FILE" "$CORE_RETURN_OWNER" || return 1
    else
        rm -f "$CORE_ACTION_DIR/owner" "$CORE_ACTION_FILE" || return 1
    fi
    # Receipt fences all later respawns before removing the reservation journal.
    touch "$CORE_WORK/lock-released" || return 1
    core_drop_journal
}
core_guard() {
    CORE_WORK="$1"; CORE_PARENT="$2"
    core_valid_work "$CORE_WORK" || exit 1
    case "$CORE_PARENT" in ''|*[!0-9]*) exit 1;; esac
    test ! -L "$CORE_WORK"
    # procd also respawns successful exits. Never recheck/revert a terminal core.
    if [ -f "$CORE_WORK/lock-released" ]; then
        core_finish_handoff "$CORE_WORK"
        return
    fi
    core_reservation_matches || return 1
    # procd owns one instance. Refuse direct/concurrent invocation while its
    # prior process still has the recorded birth identity.
    if [ -s "$CORE_WORK/guard-pid" ]; then
        read -r owner owner_start < "$CORE_WORK/guard-pid"
        [ "$(core_process_start "$owner" 2>/dev/null || true)" != "$owner_start" ] || return 1
    fi
    core_atomic_record "$CORE_WORK/guard-pid" "$$ $(core_process_start "$$")" || return 1
    # No EXIT release: death must retain the procd reservation until recovery.
    if [ -f "$CORE_WORK/terminal" ]; then core_release_lock; return; fi
    core_record_allowed "$CORE_ACTION_DIR/owner" "$CORE_WORK/owner.before" || return 1
    core_record_allowed "$CORE_ACTION_FILE" "$CORE_WORK/legacy.before" || return 1
    core_atomic_record "$CORE_ACTION_FILE" "$CORE_RESERVED_OWNER" || return 1
    core_atomic_record "$CORE_ACTION_DIR/owner" "$CORE_RESERVED_OWNER" || return 1
    # A respawn never re-applies a candidate: finish committed handoff or recover.
    if [ -f "$CORE_WORK/activated" ]; then
        if [ "$(cat "$CORE_WORK/result" 2>/dev/null || true)" = committed ] && core_health; then :
        elif core_rollback; then echo rolled-back > "$CORE_WORK/result"
        else echo recovery-required > "$CORE_WORK/result"; return 1; fi
        touch "$CORE_WORK/terminal" || return 1
        core_release_lock
        return 0
    fi
    printf '%s\n' ready > "$CORE_WORK/guard-ready"
    n=0
    while [ "$n" -lt 120 ]; do
        [ ! -e "$CORE_WORK/abort" ] || break
        if [ -e "$CORE_WORK/activate-request" ]; then
            # Only this supervised process can swap the ELF. A delayed caller
            # can never activate after the rollback supervisor has exited.
            if core_activate; then echo committed > "$CORE_WORK/result"; break; fi
            break
        fi
        sleep 1; n=$((n+1))
    done
    if [ "$(cat "$CORE_WORK/result" 2>/dev/null || true)" = committed ]; then :
    elif [ -e "$CORE_WORK/activated" ]; then
        if core_rollback; then echo rolled-back > "$CORE_WORK/result"
        else echo recovery-required > "$CORE_WORK/result"; return 1; fi
    else echo not-activated > "$CORE_WORK/result"; fi
    touch "$CORE_WORK/terminal" || return 1
    core_release_lock
}
core_write_guard() {
    guard="$CORE_ROOT/etc/init.d/podkop-core-compat-guard"
    if [ -e "$guard" ]; then
        test ! -L "$guard" && grep -Fxq '# PODKOP_CORE_GUARD=1' "$guard" &&
            grep -Fxq "# CORE_WORK=$CORE_WORK" "$guard" || return 1
        chmod 755 "$guard"
        return
    fi
    local service
    service="$(printf '#!/bin/sh /etc/rc.common\n# PODKOP_CORE_GUARD=1\n# CORE_WORK=%s\nUSE_PROCD=1\nstart_service() {\n procd_open_instance\n procd_set_param command /bin/sh %s/transaction.sh guard %s %s\n procd_set_param respawn 3600 2 3\n procd_close_instance\n}\n' "$CORE_WORK" "$CORE_WORK" "$CORE_WORK" "$CORE_PARENT")"
    core_atomic_record "$guard" "$service" && chmod 755 "$guard"
}
core_service_action() { timeout 20 "$guard" "$1"; }
core_recover() {
    CORE_WORK="$1"
    core_valid_work "$CORE_WORK" && test ! -L "$CORE_WORK" || return 1
    core_load_reservation || return 1
    if [ -f "$CORE_WORK/lock-released" ]; then
        core_finish_handoff "$CORE_WORK" || return 1
        printf 'CORE_RECOVERY=%s\n' "$(cat "$CORE_WORK/result")"
        return 0
    fi
    if [ ! -e "$CORE_ACTION_DIR/core-reservation" ]; then
        # Death before the journal rename cannot have activated an ELF. Clean
        # only our nonce-named staging; never acquire or overwrite another lock.
        test ! -f "$CORE_WORK/activated" || return 1
        local target original
        for target in "$CORE_ACTION_DIR/owner" "$CORE_ACTION_FILE"; do
            original="$CORE_WORK/owner.before"
            [ "$target" != "$CORE_ACTION_FILE" ] || original="$CORE_WORK/legacy.before"
            if [ -e "$target" ]; then
                test ! -L "$target" && cmp -s "$target" "$original" || return 1
            fi
        done
        core_atomic_record "$CORE_WORK/result" not-activated || return 1
        touch "$CORE_WORK/terminal" "$CORE_WORK/lock-released" || return 1
        core_drop_journal || return 1
        echo CORE_RECOVERY=not-activated
        return 0
    fi
    core_reservation_matches || return 1
    test ! -L "$CORE_WORK/transaction.sh" && test -s "$CORE_WORK/transaction.sh" || return 1
    # Recovery never starts a candidate. procd restart serializes the one guard
    # instance, including recovery after its finite automatic retry allowance.
    touch "$CORE_WORK/abort" || return 1
    core_write_guard || return 1
    core_service_action restart || return 1
    local n=0
    while [ ! -f "$CORE_WORK/lock-released" ] && [ "$n" -lt 300 ]; do sleep 1; n=$((n+1)); done
    test -f "$CORE_WORK/lock-released" || return 1
    core_finish_handoff "$CORE_WORK" || return 1
    printf 'CORE_RECOVERY=%s\n' "$(cat "$CORE_WORK/result")"
}
core_update() {
    CORE_PARENT="$1"
    # Caller is the already locked patch installer. Never bypass another action.
    test "$(awk 'NR==1{print $1}' /tmp/podkop-subscription-action.lock.d/owner)" = "$CORE_PARENT"
    test "$(awk 'NR==1{print $1}' /tmp/podkop-subscription-action.lock)" = "$CORE_PARENT"
    test ! -L /usr/bin/sing-box
    test -x /etc/init.d/sing-box
    core_cleanup_finished_guard || { echo 'ERROR: previous core transaction needs recovery; inspect its result.' >&2; return 1; }
    pid="$(pidof sing-box)"
    case "$pid" in ''|*[!0-9]*) echo 'ERROR: split/multiple runtime needs a separate core upgrade.' >&2; return 1;; esac
    version="$(/usr/bin/sing-box version | sed -n 's/^sing-box version //p')"
    arch="$(uname -m)"
    before_sha="$(core_hash /usr/bin/sing-box)"
    route="$(core_route legacy "$arch" "$version" "$before_sha")" || {
        echo 'ERROR: Reality core update supports stock 1.12.12 on ARM64 only; no core changes made.' >&2; return 1;
    }
    runtime_before="$(core_runtime_binding "$before_sha")" || {
        echo 'ERROR: loaded core/config/procd identity is not the exact supported main runtime; no restart performed.' >&2; return 1;
    }
    [ "$route" != current ] || { echo 'CORE_COMPAT=current'; return 0; }
    # Do not replace any package-managed PE or a reduced-feature/custom build.
    if command -v opkg >/dev/null 2>&1; then
        ! opkg status podkop-engine 2>/dev/null | grep -q '^Status: .* installed' || return 1
    elif command -v apk >/dev/null 2>&1; then
        ! apk list --installed --manifest | awk '$1=="podkop-engine" {found=1} END {exit !found}' || return 1
    else return 1; fi
    tags="$(/usr/bin/sing-box version | sed -n 's/^Tags: //p' | tr ',' '\n' | LC_ALL=C sort)"
    expected="$(printf '%s\n' with_clash_api with_gvisor with_quic with_tailscale with_utls with_wireguard | LC_ALL=C sort)"
    [ "$tags" = "$expected" ] || { echo 'ERROR: untested core feature set; existing core preserved.' >&2; return 1; }
    disk="$(df -Pk /usr/bin | awk 'END{print $4}')"
    memory="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)"
    core_require_space "$disk" "$memory" "$CORE_BYTES" || {
        echo 'ERROR: core update needs 44MiB free storage and 64MiB available RAM; working core preserved.' >&2; return 1;
    }
    command -v curl >/dev/null
    command -v timeout >/dev/null
    test -r /etc/rc.common
    CORE_WORK="$(mktemp -d /root/podkop-core-compat.XXXXXX)"
    trap core_exit EXIT
    trap 'exit 1' INT TERM HUP
    core_snapshot > "$CORE_WORK/protected.sha256"
    printf '%s\n' "$runtime_before" > "$CORE_WORK/runtime.before"
    core_hash /usr/bin/sing-box > "$CORE_WORK/before.sha256"
    # Hardlink can copy-up a lower-layer ELF; recheck free space afterwards.
    ln /usr/bin/sing-box "$CORE_WORK/sing-box.before"
    disk="$(df -Pk /usr/bin | awk 'END{print $4}')"
    core_require_space "$disk" "$memory" "$CORE_BYTES" || return 1
    curl --proto '=https' --proto-redir '=https' -fL --connect-timeout 15 --max-time 300 "$CORE_URL" -o "$CORE_WORK/sing-box.new"
    [ "$(wc -c < "$CORE_WORK/sing-box.new")" = "$CORE_BYTES" ]
    [ "$(core_hash "$CORE_WORK/sing-box.new")" = "$CORE_SHA256" ]
    chmod 755 "$CORE_WORK/sing-box.new"
    [ "$("$CORE_WORK/sing-box.new" version | sed -n 's/^sing-box version //p')" = "$CORE_VERSION" ]
    "$CORE_WORK/sing-box.new" check -c /etc/sing-box/config.json
    core_snapshot > "$CORE_WORK/before-activate.sha256"
    cmp -s "$CORE_WORK/protected.sha256" "$CORE_WORK/before-activate.sha256"
    cp "$0" "$CORE_WORK/transaction.sh"
    core_reserve
    core_write_guard
    core_service_action start
    n=0; while [ ! -f "$CORE_WORK/guard-ready" ] && [ "$n" -lt 10 ]; do sleep 1; n=$((n+1)); done
    test -f "$CORE_WORK/guard-ready"
    touch "$CORE_WORK/activate-request"
    n=0; while [ ! -f "$CORE_WORK/lock-released" ] && [ "$n" -lt 300 ]; do sleep 1; n=$((n+1)); done
    test -f "$CORE_WORK/lock-released"
    core_finish_handoff "$CORE_WORK" || return 1
    test "$(awk 'NR==1{print $1}' /tmp/podkop-subscription-action.lock.d/owner)" = "$CORE_PARENT"
    test "$(awk 'NR==1{print $1}' /tmp/podkop-subscription-action.lock)" = "$CORE_PARENT"
    result="$(cat "$CORE_WORK/result")"
    trap - EXIT INT TERM HUP
    core_service_action stop
    rm -f "$guard"
    [ "$result" = committed ] || { echo "ERROR: core transaction $result; old-core health was verified." >&2; return 1; }
    printf 'CORE_COMPAT=committed %s\nRollback core and protected-state hashes retained at %s\n' "$CORE_VERSION" "$CORE_WORK"
}
# CORE_MAIN
case "${1:-}" in
    guard) core_guard "$2" "$3" ;;
    recover) core_recover "$2" ;;
    apply) core_update "$2" ;;
    *) echo 'Use from the locked normal Legacy patch installer.' >&2; exit 2 ;;
esac
