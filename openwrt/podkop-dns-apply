    [ "$(uci -q get podkop.settings.dns_server)" = "$DA_SERVER" ] &&
    [ "$(uci -q get podkop.settings.bootstrap_dns_server)" = "$DA_BOOT_SERVER" ] &&
    [ "$(uci -q get podkop.settings.bootstrap_dns_type || printf udp)" = "$DA_BOOT_TYPE" ] &&
