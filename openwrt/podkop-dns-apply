    jq -e '.version==2 and (.sections|type=="array" and length>0) and
      all(.sections[];.section|if type!="string" then false else length>0 and
        (explode|all(.==95 or (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122))) end) and
      ([.sections[].section]|length== (unique|length))' "$DA_ROOT/metadata.json" >/dev/null || return 1
