        jq -se --slurpfile expected "$saved" --slurpfile config "$runtime" 'length==1 and ($expected|length)==1 and (.[0] as $api|all($config[0].outbounds[]|select(.type=="selector");.tag as $tag|$api.proxies[$tag].now==$expected[0].proxies[$tag].now))' "$response" >/dev/null
    fi
}
dns_apply_all_choices() {
    local mode="$1" number kind path
    while IFS='|' read -r number kind path; do
        [ "$kind" = json ] || continue
        if [ "$number" = 1 ] || [ "${path%/worker.json}" != "$path" ]; then
            dns_apply_choices "$mode" "$path" "$DA_WORK/choices.$number" || return 1
        fi
    done < "$DA_WORK/files"
}
dns_apply_config_hash() {
    jq -ceS . "$1" | sha256sum | awk '{print $1}'
}
dns_apply_record_loaded() {
