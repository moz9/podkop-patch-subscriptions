        [ "$kind" = json ] || continue
        if [ "$number" = 1 ] || [ "${path%/worker.json}" != "$path" ]; then
            identity="$(dns_apply_process_identity "$path")" && hash="$(dns_apply_config_hash "$path")" || return 1
            printf '%s|%s|%s\n' "$path" "$identity" "$hash" >> "$DA_WORK/loaded.new" || return 1
