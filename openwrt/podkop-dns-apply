        jq -se --slurpfile config "$runtime" 'length==1 and (.[0]|type=="object" and (.proxies|type)=="object" and
          (. as $saved|all($config[0].outbounds[]|select(.type=="selector");.tag as $tag|($saved.proxies[$tag].now|type)=="string")))' "$saved" >/dev/null || return 1
