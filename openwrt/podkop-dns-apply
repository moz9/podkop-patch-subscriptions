        jq -ceS . "$DA_CONFIG" > "$DA_WORK/frontend.expected" &&
        jq -ceS . "$DA_ROOT/frontend.json" > "$DA_WORK/frontend.actual" &&
        cmp -s "$DA_WORK/frontend.expected" "$DA_WORK/frontend.actual" || return 1
    fi
    : > "$DA_WORK/files"
    dns_apply_add_file "$DA_CONFIG" json && dns_apply_add_file "$DA_ROOT/logical.json" json &&
    dns_apply_add_file "$DA_ROOT/frontend.json" json || return 1
    if dns_apply_single_mode; then
        # Single mode has no worker graph; dormant split files are rollback
        # assets, not deployed inputs. Require both aliases to match main.
        jq -ceS . "$DA_CONFIG" > "$DA_WORK/single.expected" &&
        jq -ceS . "$DA_ROOT/logical.json" > "$DA_WORK/single.logical" &&
        jq -ceS . "$DA_ROOT/frontend.json" > "$DA_WORK/single.frontend" &&
        cmp -s "$DA_WORK/single.expected" "$DA_WORK/single.logical" &&
        cmp -s "$DA_WORK/single.expected" "$DA_WORK/single.frontend" || return 1
        : > "$DA_WORK/sections"
        dns_apply_add_file "$DA_ROOT/runtime-mode" metadata || return 1
    else
        jq -r '.sections[].section' "$DA_ROOT/metadata.json" > "$DA_WORK/sections" || return 1
    fi
    while IFS= read -r section; do
        [ ! -L "$DA_ROOT/workers/$section" ] || return 1
        dns_apply_add_file "$DA_ROOT/workers/$section/worker.json" json || return 1
    done < "$DA_WORK/sections"
    dns_apply_continuity_validate || return 1
    dns_apply_add_file "$DA_SNAPSHOT" snapshot && dns_apply_add_file "$DA_ROOT/context.sha256" context &&
    dns_apply_add_file "$DA_ROOT/metadata.json" metadata && dns_apply_add_file "$DA_UCI" uci || return 1
}
dns_apply_atomic() {
