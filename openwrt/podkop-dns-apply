              .config=$config | .policy=(if $basis==null then $policy else .policy end) |
              .sections |= map(. as $s | .context=([$rows[]|select(.section==$s.section)|.context][0])) |
              .continuity=({kind:"dns-only",freshServiceEvidence:false,predecessor:$origin}
                + if $basis==null then {} else {policyBasis:$basis} end)
