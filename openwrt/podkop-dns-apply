              curl -fsS --noproxy '*' --connect-timeout 2 --max-time 5 --max-filesize 524288 --header "@$headers" --header 'Content-Type: application/json' -X PUT --data-binary "@$body" -o "$response" "http://$controller/proxies/$encoded" 2>/dev/null) || return 1
        done < "$DA_WORK/selector-tags"
    fi
    (unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy NO_PROXY no_proxy;
      curl -fsS --noproxy '*' --connect-timeout 2 --max-time 5 --max-filesize 524288 --header "@$headers" -o "$response" "http://$controller/proxies" 2>/dev/null) || return 1
