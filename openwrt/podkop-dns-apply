#!/bin/sh
# Explicit PE-only DNS transaction. Never regenerates subscription membership.
dns_apply_reply() {
    jq -cn --arg error "${1:-}" --argjson restored "${2:-false}" --argjson changed "${DA_CHANGED:-false}" \
      '{success:($error==""),error:(if $error=="" then null else $error end),restored:$restored,changed:$changed}'
}
dns_apply_hash() {
    if [ "${DA_SAVED:-0}" = 1 ] && [ "$1" = "${DA_CONFIG:-}" ]; then
        command -v podkop_section_runtime_hash >/dev/null 2>&1 && podkop_section_runtime_hash "$1"
    else subscription_services_snapshot_hash "$1"; fi
}

# Read committed values without loading /tmp/.uci (including LuCI drafts).
dns_apply_saved_get() {
    uci -q get "/proc/self/fd/3.settings.$1" 3< "${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}"
}
dns_apply_saved_requested() {
    [ "$(dns_apply_saved_get dns_type)" = "$DA_TYPE" ] &&
    [ "$(dns_apply_saved_get dns_server)" = "$DA_SERVER" ] &&
    [ "$(dns_apply_saved_get bootstrap_dns_type || printf udp)" = "$DA_BOOT_TYPE" ] &&
    [ "$(dns_apply_saved_get bootstrap_dns_server)" = "$DA_BOOT_SERVER" ] &&
    [ "$(dns_apply_saved_get dns_failover_active_slot || printf primary)" = primary ]
}
dns_apply_pending_hash() {
    local file="${PODKOP_DNS_APPLY_SUBSCRIPTION_PENDING:-/tmp/podkop-subscription-reload.pending}"
    [ ! -L "$file" ] || return 1
    if [ -e "$file" ]; then dns_apply_hash "$file"; else printf 'absent\n'; fi
}
dns_apply_pending_unchanged() {
    [ "${DA_SAVED:-0}" != 1 ] || {
        uci -q changes podkop > "$DA_WORK/uci-pending.current" &&
        cmp -s "$DA_WORK/uci-pending" "$DA_WORK/uci-pending.current" &&
        [ "$(dns_apply_pending_hash)" = "$(cat "$DA_WORK/subscription-pending.sha")" ] &&
        [ "$(sha256sum "$DA_UCI" | awk '{print $1}')" = "$(cat "$DA_WORK/committed-uci.sha")" ]
    }
}

# An absolute filename is intentional: UCI loads it with has_delta=false.
# Merely using -c/-P would still search /tmp/.uci and could include drafts.
# CLI tuple parsing also splits dots inside parent directories. The proc FD
# alias has no dots and opens exactly this read-only file, with no delta load.
dns_reserve_export() { uci -q export /proc/self/fd/3 3< "$1"; }
dns_reserve_fields() {
    local rows
    rows="$(awk '
      function unquote(s) { gsub(/["\047]/,"",s); return s }
      $1=="config" { inside=(unquote($3)=="settings"); if (inside) count++ }
      inside && $1=="option" {
        key=unquote($2)
        if (key=="secondary_dns_enabled" || key=="secondary_dns_type" || key=="secondary_dns_server" ||
            key=="secondary_bootstrap_dns_type" || key=="secondary_bootstrap_dns_server" ||
            key=="dns_failover_enabled" || key=="dns_failover_active_slot") {
          line=$0; sub(/^[ \t]*option[ \t]+[^ \t]+[ \t]+/,"",line)
          print key "|" unquote(line)
        }
      }
      END { if (count!=1) exit 1 }
    ' "$1")" || return 1
    printf '%s\n' "$rows" | jq -Rn '
      [inputs|split("|")|{key:.[0],value:.[1]}]|from_entries|
      {enabled:(.secondary_dns_enabled=="1"),dnsType:(.secondary_dns_type//""),dnsServer:(.secondary_dns_server//""),
       bootstrapDnsType:(.secondary_bootstrap_dns_type//"udp"),bootstrapDnsServer:(.secondary_bootstrap_dns_server//""),
       autoFailoverEnabled:(.dns_failover_enabled=="1"),activeSlot:(.dns_failover_active_slot//"primary")}'
}
dns_reserve_strip() {
    awk '
      function clean(s) { gsub(/["\047]/,"",s); return s }
      $1=="config" { inside=(clean($3)=="settings") }
      inside && ($1=="option" || $1=="list") && clean($2) ~ /^secondary_(dns_enabled|dns_type|dns_server|bootstrap_dns_type|bootstrap_dns_server)$/ { next }
      { print }
    ' "$1"
}
dns_reserve_patch() {
    awk -v p="$2" -v s="$3" -v bp="$4" -v b="$5" '
      function clean(s) { gsub(/["\047]/,"",s); return s }
      function append() {
        printf "\toption secondary_dns_enabled \0471\047\n"
        printf "\toption secondary_dns_type \047%s\047\n",p
        printf "\toption secondary_dns_server \047%s\047\n",s
        printf "\toption secondary_bootstrap_dns_type \047%s\047\n",bp
        printf "\toption secondary_bootstrap_dns_server \047%s\047\n",b
      }
      $1=="config" { if (inside) append(); inside=(clean($3)=="settings"); if (inside) count++ }
      inside && ($1=="option" || $1=="list") && clean($2) ~ /^secondary_(dns_enabled|dns_type|dns_server|bootstrap_dns_type|bootstrap_dns_server)$/ { next }
      { print }
      END { if (inside) append(); if (count!=1) exit 1 }
    ' "$1" > "$6"
}
dns_reserve_pending_safe() {
    # Unrelated drafts are permitted and never committed. Deleting/retyping
    # settings or an overlapping reserve draft would undo/override this save.
    # Primary DNS/active-slot/failover drafts are context conflicts too: the
    # recommendation must be independent of the saved active primary, not a
    # not-yet-applied resolver selected in another open editor.
    ! printf '%s\n' "$1" | grep -Eq '^[+@^~|!-]*podkop\.settings(=|$|\.(secondary_(dns_enabled|dns_type|dns_server|bootstrap_dns_type|bootstrap_dns_server)|dns_type|dns_server|bootstrap_dns_type|bootstrap_dns_server|dns_failover_enabled|dns_failover_active_slot)(=|[+-]?=|$))'
}
dns_reserve_save() {
    local file="${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}" base="${DB_PERSIST:-/etc/podkop/dns-benchmark}/reserve-save"
    local work before after pending current free_kb needed_kb candidate readback
    DNS_RESERVE_ERROR=reserve_commit_failed
    [ -s "$file" ] && [ ! -L "$file" ] && [ ! -L "$base" ] || { DNS_RESERVE_ERROR=unsafe_reserve_config; return 1; }
    pending="$(uci -q changes podkop)" || { DNS_RESERVE_ERROR=reserve_pending_unavailable; return 1; }
    dns_reserve_pending_safe "$pending" || { DNS_RESERVE_ERROR=reserve_pending_conflict; return 1; }
    mkdir -p "$base" && chmod 700 "$base" || return 1
    needed_kb="$(du -k "$file" | awk '{print $1}')"; free_kb="$(df -Pk "$base" | awk 'NR==2{print $4}')"
    case "$needed_kb:$free_kb" in *[!0-9:]*|:*) DNS_RESERVE_ERROR=insufficient_backup_space; return 1;; esac
    # Before/after, two exports, two constrained comparisons, parser input and
    # the atomic candidate can coexist. Keep additional filesystem headroom.
    [ -n "$free_kb" ] && [ "$free_kb" -ge $((needed_kb*8+128)) ] || { DNS_RESERVE_ERROR=insufficient_backup_space; return 1; }
    work="$(mktemp -d "$base/transaction.XXXXXX")" || return 1
    cp -p "$file" "$work/before" && dns_reserve_export "$file" > "$work/before.export" || return 1
    before="$(sha256sum "$work/before" | awk '{print $1}')"
    readback="$(dns_reserve_fields "$work/before.export")" || return 1
    [ "$(printf '%s' "$readback" | jq -r '.activeSlot')" = primary ] || { DNS_RESERVE_ERROR=reserve_is_active; return 1; }
    dns_reserve_patch "$work/before" "$1" "$2" "$3" "$4" "$work/after" || { DNS_RESERVE_ERROR=unsupported_reserve_config; return 1; }
    # Validate parsing and independently constrain every other saved option,
    # including other sections and lists. Original unrelated bytes survive.
    cp "$work/after" "$work/podkop" && dns_reserve_export "$work/podkop" > "$work/after.export" || return 1
    dns_reserve_strip "$work/before.export" > "$work/unrelated.before"
    dns_reserve_strip "$work/after.export" > "$work/unrelated.after"
    cmp -s "$work/unrelated.before" "$work/unrelated.after" || { DNS_RESERVE_ERROR=reserve_delta_invalid; return 1; }
    readback="$(dns_reserve_fields "$work/after.export")" || return 1
    printf '%s' "$readback" | jq -e --arg p "$1" --arg s "$2" --arg bp "$3" --arg b "$4" '.enabled==true and .dnsType==$p and .dnsServer==$s and .bootstrapDnsType==$bp and .bootstrapDnsServer==$b' >/dev/null || { DNS_RESERVE_ERROR=reserve_readback_failed; return 1; }
    candidate="$(mktemp "${file%/*}/.podkop-reserve.XXXXXX")" || return 1
    if ! cp -p "$file" "$candidate" || ! cat "$work/after" > "$candidate"; then rm -f "$candidate"; return 1; fi
    after="$(sha256sum "$candidate" | awk '{print $1}')"
    printf '%s\n' "$before" > "$work/before.sha"; printf '%s\n' "$after" > "$work/after.sha"
    # Fingerprinting may inspect controllers and take time. Do it first, then
    # perform the pending/config CAS guards immediately before the rename.
    if ! db_reserve_commit_context; then rm -f "$candidate"; DNS_RESERVE_ERROR=configuration_changed; return 1; fi
    current="$(uci -q changes podkop)" || { rm -f "$candidate"; DNS_RESERVE_ERROR=reserve_pending_unavailable; return 1; }
    if [ "$pending" != "$current" ] || [ "$before" != "$(sha256sum "$file" | awk '{print $1}')" ]; then
        rm -f "$candidate"; DNS_RESERVE_ERROR=configuration_changed; return 1
    fi
    mv "$candidate" "$file" || { rm -f "$candidate"; return 1; }
    if [ "$(sha256sum "$file" | awk '{print $1}')" != "$after" ]; then
        # A concurrent external writer owns any unexpected contents. Never
        # roll it back blindly; the root-only before image remains available.
        DNS_RESERVE_ERROR=reserve_readback_failed; return 1
    fi
    printf '%s\n' "${work##*/}" > "$base/latest.tmp.$$" && mv "$base/latest.tmp.$$" "$base/latest" || true
    DNS_RESERVE_ERROR=''
}
dns_apply_patch_json() {
    jq --slurpfile pair "$2" '
      if ([.dns.servers[]?|select(.tag=="dns-server")]|length)!=1 or
         ([.dns.servers[]?|select(.tag=="bootstrap-dns-server")]|length)!=1
      then error("unsupported DNS tags") else
      .dns.servers |= map(. as $old | [$pair[0][]|select(.tag==$old.tag)][0] as $new |
        if $new==null then . else
        del(.type,.server,.server_port,.path,.tls,.domain_resolver)+$new end) end
    ' "$1" > "$3" || return 1
    # Independently constrain the delta; tags, detours and other fields survive.
    jq -ceS '(.dns.servers[]|select(.tag=="dns-server" or .tag=="bootstrap-dns-server")) |= del(.type,.server,.server_port,.path,.tls,.domain_resolver)' "$1" > "$3.old" &&
    jq -ceS '(.dns.servers[]|select(.tag=="dns-server" or .tag=="bootstrap-dns-server")) |= del(.type,.server,.server_port,.path,.tls,.domain_resolver)' "$3" > "$3.new" &&
    cmp -s "$3.old" "$3.new"
}
dns_apply_load() {
    PODKOP_LIBRARY_ONLY=1
    PODKOP_DNS_OPTIMIZER_LIBRARY_ONLY=1
    . "${PODKOP_DNS_APPLY_CORE:-/usr/bin/podkop}" || return 1
    . "${PODKOP_DNS_APPLY_OPTIMIZER:-/usr/bin/podkop-dns-optimizer}" || return 1
    if ! command -v podkop_section_context_hash >/dev/null 2>&1; then
        [ -r "${PODKOP_DNS_APPLY_SECTION_HOOKS:-/usr/lib/podkop/section-hooks.sh}" ] || return 1
        . "${PODKOP_DNS_APPLY_SECTION_HOOKS:-/usr/lib/podkop/section-hooks.sh}" || return 1
    fi
}
dns_apply_pair() {
    local main boot
    main="$(dns_catalog_endpoint "$1" "$2" main)" && boot="$(dns_catalog_endpoint "$3" "$4" bootstrap)" || return 1
    printf '%s' "$boot" | jq -er '.host' | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || return 1
    jq -cn --arg p "$1" --arg bp "$3" --argjson main "$main" --argjson boot "$boot" '
      def ascii_host:
        if type!="string" then false else length>0 and
          (explode|all(.==45 or .==46 or (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122))) end;
      def server($p;$e;$tag):
        if ($e.host|ascii_host|not) or
           ($e.port|type)!="number" or $e.port<1 or $e.port>65535 or ($e.port|floor)!=$e.port
        then error("invalid endpoint") else
        {tag:$tag,type:({udp:"udp",tcp:"tcp",doh:"https",dot:"tls"}[$p]),server:$e.host,server_port:$e.port} +
        (if $p=="doh" then {path:($e.path//"/dns-query")} else {} end) +
        (if $e.server_name then {tls:{enabled:true,server_name:$e.server_name}} else {} end) end;
      if (["udp","tcp","doh","dot"]|index($p))==null or (["udp","tcp","doh","dot"]|index($bp))==null
      then error("invalid protocol") else
      [server($p;$main;"dns-server")+{domain_resolver:"bootstrap-dns-server"},server($bp;$boot;"bootstrap-dns-server")] end' > "$DA_WORK/pair.json"
}
dns_apply_add_file() {
    local path="$1" kind="$2" number
    [ -s "$path" ] && [ ! -L "$path" ] || return 1
    case "$path" in *'|'*|*'
'*) return 1;; esac
    number="$(wc -l < "$DA_WORK/files")"; number=$((number+1))
    printf '%s|%s|%s\n' "$number" "$kind" "$path" >> "$DA_WORK/files"
    cp -p "$path" "$DA_WORK/before.$number" || return 1
    dns_apply_hash "$path" > "$DA_WORK/before.$number.sha" || return 1
    if [ "$kind" = json ]; then
        dns_apply_patch_json "$path" "$DA_WORK/pair.json" "$DA_WORK/after.$number" || return 1
        sing-box check -c "$DA_WORK/after.$number" >/dev/null 2>&1 || return 1
    else cp -p "$path" "$DA_WORK/after.$number" || return 1; fi
}
dns_apply_single_mode() {
    [ ! -L "$DA_ROOT/runtime-mode" ] &&
    [ "$(cat "$DA_ROOT/runtime-mode" 2>/dev/null)" = single ] &&
    jq -e '.version==3 and .mode=="single" and (.sections|type=="array") and
      all(.sections[];.section|if type!="string" then false else length>0 and
        (explode|all(.==95 or (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122))) end) and
      ([.sections[].section]|length==(unique|length))' "$DA_ROOT/metadata.json" >/dev/null
}
dns_apply_runtime_reload() {
    "${PODKOP_DNS_APPLY_MAIN_INIT:-/etc/init.d/sing-box}" reload || return 1
    dns_apply_single_mode && return 0
    "${PODKOP_SECTION_INIT:-/etc/init.d/podkop-section-worker}" reload
}
dns_apply_runtime_ready() {
    "${PODKOP_DNS_APPLY_MAIN_INIT:-/etc/init.d/sing-box}" status >/dev/null 2>&1 || return 1
    if dns_apply_single_mode; then
        # The manager proves the main PID, its listeners/API and absence of
        # worker processes. A stopped worker service is expected in single.
        PODKOP_SECTION_ROOT="$DA_ROOT" PODKOP_SECTION_FRONTEND_CONFIG="$DA_CONFIG" \
            "${PODKOP_SECTION_MANAGER:-/usr/bin/podkop-section-runtime}" wait-ready >/dev/null 2>&1
    else
        "${PODKOP_SECTION_INIT:-/etc/init.d/podkop-section-worker}" status >/dev/null 2>&1
    fi
}
# A scoped section apply authenticates one deployed graph without asserting that
# every saved subscription control was applied. Carry that limited policy basis
# through DNS-only successors, never a generic stale-policy exemption.
dns_apply_scoped_policy_origin() {
    jq -ce '
      .policy as $policy |
      (if .continuity.mode=="section-only" then
         {kind:"section-only",section:.continuity.section,policy:$policy}
       elif .continuity.kind=="dns-only" and .continuity.freshServiceEvidence==false
         and .continuity.policyBasis.kind=="section-only"
         and .continuity.policyBasis.policy==$policy then .continuity.policyBasis
       else empty end) |
      select(.section|type=="string" and length>0 and
        all(explode[]; .==95 or (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122)))' "$1"
}

dns_apply_scoped_required_section() {
    local section="$1" required
    validate_subscription_urltest_section "$section" || return 0
    required="$(subscription_required_services_json "$section")" || { DA_SCOPED_REQUIRED_FAILED=1; return 0; }
    [ "$required" != '[]' ] || return 0
    printf '%s' "$required" | jq -ce --arg section "$section" '
      select(type=="array" and length>0 and length==(unique|length) and
        all(.[]; .=="gemini" or .=="chatgpt" or .=="exit_country" or .=="google_country")) |
      {section:$section,requiredServices:sort}' >> "$DA_SCOPED_REQUIRED_FILE" || DA_SCOPED_REQUIRED_FAILED=1
}

dns_apply_scoped_policy_validate() (
    local manifest="$1" root origin context changes names
    [ "${DA_SAVED:-0}" != 1 ] || exit 1
    origin="$(dns_apply_scoped_policy_origin "$manifest")" || exit 1
    names="$(podkop_section_names)" || exit 1
    printf '%s' "$names" | jq -e --arg section "$(printf '%s' "$origin" | jq -r .section)" 'index($section)!=null' >/dev/null || exit 1
    root="${PODKOP_SECTION_ROOT:-/etc/podkop/section-runtime}"
    [ ! -L "$root" ] && [ -s "$root/context.sha256" ] && [ ! -L "$root/context.sha256" ] || exit 1
    context="$(cat "$root/context.sha256")" || exit 1
    case "$context" in v2:*) [ "${#context}" = 67 ] || exit 1;; *) exit 1;; esac
    [ "$context" = "$(podkop_section_context_hash)" ] || exit 1
    changes="$(uci -q changes podkop)" || exit 1
    [ -z "$changes" ] || exit 1
    DA_SCOPED_REQUIRED_FILE="$(mktemp "$DA_WORK/scoped-required.XXXXXX")" || exit 1
    trap 'rm -f "$DA_SCOPED_REQUIRED_FILE"' EXIT INT TERM HUP
    DA_SCOPED_REQUIRED_FAILED=0
    config_foreach dns_apply_scoped_required_section section
    [ "$DA_SCOPED_REQUIRED_FAILED" = 0 ] || exit 1
    jq -e --slurpfile current "$DA_SCOPED_REQUIRED_FILE" '
      all(.sections[]; .requiredServices|type=="array" and length>0 and length==(unique|length)) and
      ([.sections[]|{section,requiredServices:(.requiredServices|sort)}]|sort_by(.section))
        == ($current|sort_by(.section))' "$manifest" >/dev/null
)


dns_apply_continuity_validate() {
    # DNS continuation retains one exact admitted runtime, not today's pending
    # catalog selection. No supported/filter/TTL gate and no evidence writes.
    local dir manifest config_path config_sha policy_sha generation section context ids row evidence expected path name hash local_names
    dir="$(subscription_services_snapshot_dir)"; manifest="$dir/snapshot.json"
    [ -s "$manifest" ] && [ ! -L "$manifest" ] && [ ! -L "$dir" ] || return 1
    jq -e --argjson single "$(dns_apply_single_mode && printf true || printf false)" '
      def hex($n): if type!="string" then false else length==$n and
        (explode|all((.>=48 and .<=57) or (.>=97 and .<=102))) end;
      def section_name: if type!="string" then false else length>0 and
        (explode|all(.==95 or (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122))) end;
      .version==1 and (.config|hex(64)) and (.policy|hex(64)) and
      (.sections|type=="array" and (length>0 or $single)) and (.rules|type=="array") and
      ([.sections[].section]|length==(unique|length)) and
      all(.sections[]; (.section|section_name) and (.context|hex(64)) and (.service|hex(64)) and
        (.admittedIds|type=="array" and length>0 and length==(unique|length) and all(.[];hex(32))) and
        (.admittedLinks|type=="array") and
        ([.admittedLinks[].id]|sort)==(.admittedIds|sort) and all(.admittedLinks[];.sha|hex(64))) and
      ([.rules[].name]|length==(unique|length)) and all(.rules[];.sha|hex(64))
    ' "$manifest" >/dev/null || return 1
    if [ "${DA_SAVED:-0}" = 1 ]; then config_path="$DA_CONFIG"
    else config_get config_path settings config_path; fi
    config_sha="$(dns_apply_hash "$config_path")" || return 1
    jq -e --arg config "$config_sha" '.config==$config' "$manifest" >/dev/null || return 1
    if [ "${DA_SAVED:-0}" != 1 ]; then
        policy_sha="$(subscription_services_snapshot_policy_hash)" || return 1
        if ! jq -e --arg policy "$policy_sha" '.policy==$policy' "$manifest" >/dev/null; then
            dns_apply_scoped_policy_validate "$manifest" || return 1
        fi
    fi
    jq -r '.sections[].section' "$manifest" > "$DA_WORK/continuity-sections" || return 1
    while IFS= read -r section; do
        # A saved-DNS successor preserves the immutable admitted graph and
        # manifest, not mutable re-tests performed since that admission.
        [ "${DA_SAVED:-0}" != 1 ] || continue
        if [ "${DA_SAVED:-0}" != 1 ]; then
            context="$(subscription_services_context "$section")" || return 1
            jq -e --arg section "$section" --arg context "$context" '.sections[]|select(.section==$section)|.context==$context' "$manifest" >/dev/null || return 1
        fi
        ids="$(jq -c --arg section "$section" '.sections[]|select(.section==$section)|.admittedIds' "$manifest")" || return 1
        evidence="$(subscription_services_cache_path "$section")"
        [ -s "$evidence" ] && [ ! -L "$evidence" ] || return 1
        row="$(jq -cS --argjson ids "$ids" '[.results[]?|select(.id as $id|$ids|index($id)!=null)]|sort_by(.id)' "$evidence")" || return 1
        [ "$(printf '%s' "$row" | jq -c 'map(.id)|sort')" = "$(printf '%s' "$ids" | jq -c 'sort')" ] || return 1
        hash="$(printf '%s\n' "$row" | sha256sum | awk '{print $1}')"
        expected="$(jq -r --arg section "$section" '.sections[]|select(.section==$section)|.service' "$manifest")" || return 1
        [ "$hash" = "$expected" ] || return 1
    done < "$DA_WORK/continuity-sections"
    generation="$(jq -r '.generation' "$manifest")" || return 1
    case "$generation" in generation.*) case "${generation#generation.}" in ''|*[!A-Za-z0-9]*) return 1;; esac;; *) return 1;; esac
    [ -d "$dir/$generation" ] && [ ! -L "$dir/$generation" ] && [ ! -L "$TMP_RULESET_FOLDER" ] || return 1
    jq -r '[.route.rule_set[]?|select(.type=="local")|.path]|unique[]' "$config_path" > "$DA_WORK/continuity-paths" || return 1
    : > "$DA_WORK/continuity-names"
    while IFS= read -r path; do
        name="${path#"$TMP_RULESET_FOLDER/"}"
        case "$name" in ''|.|..|*[!A-Za-z0-9_.-]*) return 1;; esac
        case "$name" in *.json|*.srs) :;; *) return 1;; esac
        [ "$path" = "$TMP_RULESET_FOLDER/$name" ] || return 1
        expected="$(jq -er --arg name "$name" '.rules[]|select(.name==$name)|.sha' "$manifest")" || return 1
        [ "$(dns_apply_hash "$path")" = "$expected" ] &&
        [ "$(dns_apply_hash "$dir/$generation/$name")" = "$expected" ] || return 1
        jq -cn --arg name "$name" '$name' >> "$DA_WORK/continuity-names" || return 1
    done < "$DA_WORK/continuity-paths"
    local_names="$(jq -cs 'sort' "$DA_WORK/continuity-names")" || return 1
    [ "$local_names" = "$(jq -c '.rules|map(.name)|sort' "$manifest")" ] || return 1
    sing-box check -c "$config_path" >/dev/null 2>&1
}
dns_apply_collect() {
    local section
    DA_ROOT="${PODKOP_SECTION_ROOT:-/etc/podkop/section-runtime}"
    if [ "${DA_SAVED:-0}" = 1 ]; then DA_CONFIG="$(dns_apply_saved_get config_path)" || return 1
    else DA_CONFIG="$(uci -q get podkop.settings.config_path)" || return 1; fi
    DA_SNAPSHOT="$(subscription_services_snapshot_dir)/snapshot.json"
    DA_UCI="${PODKOP_DNS_APPLY_UCI_FILE:-/etc/config/podkop}"
    [ ! -L "$DA_ROOT" ] && [ ! -L "$DA_ROOT/workers" ] || return 1
    if [ "${DA_SAVED:-0}" = 1 ]; then
        dns_apply_saved_requested || return 1
        uci -q changes podkop > "$DA_WORK/uci-pending" && dns_apply_pending_hash > "$DA_WORK/subscription-pending.sha" || return 1
        sha256sum "$DA_UCI" | awk '{print $1}' > "$DA_WORK/committed-uci.sha" || return 1
        printf '1\n' > "$DA_WORK/saved-mode"
    else
        [ -z "$(uci -q changes podkop)" ] || return 1
        [ "$(cat "$DA_ROOT/context.sha256")" = "$(podkop_section_context_hash)" ] || return 1
    fi
    if jq -e '.version==3' "$DA_ROOT/metadata.json" >/dev/null; then
        dns_apply_single_mode || return 1
