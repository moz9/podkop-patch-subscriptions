        done < "$DA_WORK/files"
        if [ "$current" = 0 ] && dns_apply_successor && dns_apply_activate && dns_apply_live_ready && dns_apply_pending_unchanged; then
            if dns_apply_record_current && printf '%s\n' "${DA_WORK##*/}" > "$backup_base/latest.new.$$" && mv "$backup_base/latest.new.$$" "$backup_base/latest"; then
                DA_MUTATED=0; dns_apply_clear_pending; dns_apply_reply; return 0
            fi
        fi
    fi
    if dns_apply_restore; then DA_MUTATED=0; dns_apply_clear_pending; dns_apply_reply apply_failed_rolled_back true;
    else DA_MUTATED=0; dns_apply_record_current || true; dns_apply_reply rollback_failed false; fi
    return 1
}
dns_apply_worker() {
    # This worker is launched in its own process. Legacy OpenWrt/Podkop
    # libraries do not support the benchmark caller's errexit/nounset mode
    # (e.g. optional IPKG_INSTROOT); transaction functions check failures.
    # Keep the parent's strict mode intact and relax only this owned worker.
    set +eu
    umask 077
    DA_MUTATED=0; DA_CHANGED=false; DA_OWN_LOCK=0; DA_TEMP=0; DA_WORK=''; DA_SAVED=0
    trap 'dns_apply_cleanup' EXIT
    trap 'dns_apply_signal' INT TERM HUP
    dns_apply_load || { dns_apply_reply library_unavailable; exit 1; }
    local result=0
    dns_apply_run "$@" || result=$?
    exit "$result"
}
# Background callers use the brace worker directly: a second subshell creates
# an intermediary PID which can die on TERM while the real transaction runs.
dns_apply_main() ( dns_apply_worker "$@"; )
[ "${PODKOP_DNS_APPLY_LIBRARY_ONLY:-0}" != 1 ] || return 0
dns_apply_main "$@"
