            jq -e --arg tag "$tag" --arg wanted "$wanted" 'any(.outbounds[];.tag==$tag and (.outbounds|index($wanted)!=null))' "$runtime" >/dev/null || return 1
            encoded="$(jq -nr --arg tag "$tag" '$tag|@uri')" || return 1
