+PODKOP_MUTATION_LOCK_HELD=0

 updated_at() {
     date -Iseconds 2> /dev/null || date
 }

+podkop_mutation_lock_pid_alive() {
+    local pid="$1"
+
+    case "$pid" in
+        ''|*[!0-9]*|0) return 1 ;;
+    esac
+    [ -d "/proc/$pid" ]
+}
+
+podkop_mutation_legacy_lock_busy() {
+    local holder
+
+    [ -e "$PODKOP_MUTATION_LEGACY_LOCK_FILE" ] || return 1
+    holder="$(awk 'NR == 1 {print $1}' "$PODKOP_MUTATION_LEGACY_LOCK_FILE" 2> /dev/null)"
+    [ -n "$holder" ] || return 0
+    if podkop_mutation_lock_pid_alive "$holder"; then
+        return 0
+    fi
+    rm -f "$PODKOP_MUTATION_LEGACY_LOCK_FILE" 2> /dev/null || return 0
+    return 1
+}
+
+podkop_mutation_lock_acquire() {
+    local action="$1"
+    local holder
+
+    [ "$PODKOP_MUTATION_LOCK_HELD" = "1" ] && return 0
+    podkop_mutation_legacy_lock_busy && return 1
+    if ! mkdir "$PODKOP_MUTATION_LOCK_DIR" 2> /dev/null; then
+        holder="$(awk 'NR == 1 {print $1}' "$PODKOP_MUTATION_LOCK_DIR/owner" 2> /dev/null)"
+        if [ -z "$holder" ] || podkop_mutation_lock_pid_alive "$holder"; then
+            return 1
+        fi
+        rm -f "$PODKOP_MUTATION_LOCK_DIR/owner"
+        rmdir "$PODKOP_MUTATION_LOCK_DIR" 2> /dev/null || return 1
+        mkdir "$PODKOP_MUTATION_LOCK_DIR" 2> /dev/null || return 1
+    fi
+    if ! printf '%s %s %s\n' "$$" "$action" "$(date +%s 2> /dev/null || date)" > "$PODKOP_MUTATION_LOCK_DIR/owner"; then
+        rm -f "$PODKOP_MUTATION_LOCK_DIR/owner"
+        rmdir "$PODKOP_MUTATION_LOCK_DIR" 2> /dev/null || true
+        return 1
+    fi
+    PODKOP_MUTATION_LOCK_HELD=1
+    if podkop_mutation_legacy_lock_busy; then
+        podkop_mutation_lock_release
+        return 1
+    fi
+    if ! (set -C; printf '%s %s %s\n' "$$" "$action" "$(date +%s 2> /dev/null || date)" > "$PODKOP_MUTATION_LEGACY_LOCK_FILE") 2> /dev/null; then
+        podkop_mutation_lock_release
+        return 1
+    fi
+}
+
+podkop_mutation_lock_release() {
+    local holder legacy_holder
+
+    [ "$PODKOP_MUTATION_LOCK_HELD" = "1" ] || return 0
+    holder="$(awk 'NR == 1 {print $1}' "$PODKOP_MUTATION_LOCK_DIR/owner" 2> /dev/null)"
+    if [ "$holder" = "$$" ]; then
+        rm -f "$PODKOP_MUTATION_LOCK_DIR/owner"
+        rmdir "$PODKOP_MUTATION_LOCK_DIR" 2> /dev/null || true
+    fi
+    legacy_holder="$(awk 'NR == 1 {print $1}' "$PODKOP_MUTATION_LEGACY_LOCK_FILE" 2> /dev/null)"
+    [ "$legacy_holder" != "$$" ] || rm -f "$PODKOP_MUTATION_LEGACY_LOCK_FILE"
+    PODKOP_MUTATION_LOCK_HELD=0
+}
+
+cleanup_optimizer_mutation() {
+    podkop_mutation_lock_release
+    rm -rf "$LOCK_DIR"
+}
