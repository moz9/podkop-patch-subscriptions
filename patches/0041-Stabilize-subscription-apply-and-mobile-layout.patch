+        ! mv "$restore_tmp" "$PODKOP_CONFIG" 2> /dev/null; then
+        rm -f "$restore_tmp"
+        restore_ok=0
+    fi
+
+    cache_was_present="$(cat "$SUBSCRIPTION_APPLY_V2_TMP/cache.present" 2> /dev/null || echo 0)"
+    case "$SUBSCRIPTION_CACHE_DIR" in
+    "" | "/")
+        restore_ok=0
+        ;;
+    *)
