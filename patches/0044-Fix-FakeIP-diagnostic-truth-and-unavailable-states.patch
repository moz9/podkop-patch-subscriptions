diff --git a/fe-app-podkop/src/podkop/tabs/diagnostic/tests/runFakeIPCheck.test.ts b/fe-app-podkop/src/podkop/tabs/diagnostic/tests/runFakeIPCheck.test.ts
new file mode 100644
index 0000000..7da6570
--- /dev/null
+++ b/fe-app-podkop/src/podkop/tabs/diagnostic/tests/runFakeIPCheck.test.ts
@@ -0,0 +1,189 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { runFakeIPCheck } from '../checks/runFakeIPCheck';
+
+const { podkopShellMethods, remoteFakeIPMethods, updateCheckStore } =
+  vi.hoisted(() => ({
+    podkopShellMethods: { checkFakeIP: vi.fn() },
+    remoteFakeIPMethods: {
+      getFakeIpCheck: vi.fn(),
+      getIpCheck: vi.fn(),
+    },
+    updateCheckStore: vi.fn(),
+  }));
+
+vi.mock('../checks/updateCheckStore', () => ({ updateCheckStore }));
+vi.mock('../../../methods', () => ({
+  PodkopShellMethods: podkopShellMethods,
+  RemoteFakeIPMethods: remoteFakeIPMethods,
+}));
+vi.mock('../../../services', () => ({}));
+
+function getFakeIPCheck() {
+  const calls = updateCheckStore.mock.calls;
+  const check = calls.at(-1)?.[0];
+
+  if (!check) throw new Error('FakeIP diagnostic result is missing');
+  return check;
+}
+
+function mockRouterFakeIP(fakeip: boolean) {
+  podkopShellMethods.checkFakeIP.mockResolvedValue({
+    success: true,
+    data: { fakeip, IP: '203.0.113.10' },
+  });
+}
+
+function mockBrowserFakeIP(fakeip: boolean, IP = '203.0.113.10') {
+  remoteFakeIPMethods.getFakeIpCheck.mockResolvedValue({
+    success: true,
+    data: { fakeip, IP },
+  });
+}
+
+function mockBrowserIP(IP = '198.51.100.20') {
+  remoteFakeIPMethods.getIpCheck.mockResolvedValue({
+    success: true,
+    data: { fakeip: false, IP },
+  });
+}
+
+describe('runFakeIPCheck', () => {
+  beforeEach(() => {
+    podkopShellMethods.checkFakeIP.mockReset();
+    remoteFakeIPMethods.getFakeIpCheck.mockReset();
+    remoteFakeIPMethods.getIpCheck.mockReset();
+    updateCheckStore.mockReset();
+  });
+
+  it('reports success only when every FakeIP check succeeds', async () => {
+    mockRouterFakeIP(true);
+    mockBrowserFakeIP(true);
+    mockBrowserIP();
+
+    await runFakeIPCheck();
+
+    expect(getFakeIPCheck().state).toBe('success');
+  });
+
+  it('starts all independent probes without waiting for an earlier probe', async () => {
+    let releaseRouterProbe: (() => void) | undefined;
+    podkopShellMethods.checkFakeIP.mockReturnValue(
+      new Promise((resolve) => {
+        releaseRouterProbe = () =>
+          resolve({
+            success: true,
+            data: { fakeip: true, IP: '203.0.113.10' },
+          });
+      }),
+    );
+    mockBrowserFakeIP(true);
+    mockBrowserIP();
+
+    const checkPromise = runFakeIPCheck();
+    await Promise.resolve();
+
+    expect(remoteFakeIPMethods.getFakeIpCheck).toHaveBeenCalledOnce();
+    expect(remoteFakeIPMethods.getIpCheck).toHaveBeenCalledOnce();
+
+    releaseRouterProbe?.();
+    await checkPromise;
+  });
+
+  it('reports a warning when the router passes but the browser probe is unavailable', async () => {
+    mockRouterFakeIP(true);
+    remoteFakeIPMethods.getFakeIpCheck.mockResolvedValue({
+      success: false,
+      message: 'request timed out with private details',
+    });
+    remoteFakeIPMethods.getIpCheck.mockResolvedValue({
+      success: false,
+      message: 'request timed out with private details',
+    });
+
+    await runFakeIPCheck();
+
+    const check = getFakeIPCheck();
+    expect(check.state).toBe('warning');
+    expect(check.items[1]).toEqual({
+      state: 'warning',
+      key: 'Browser FakeIP probe is unavailable',
+      value: '',
+    });
+    expect(JSON.stringify(check)).not.toContain('private details');
+  });
+
+  it('explains a valid fakeip=false response without treating it as a transport failure', async () => {
+    mockRouterFakeIP(true);
+    mockBrowserFakeIP(false);
+    mockBrowserIP('203.0.113.10');
+
+    await runFakeIPCheck();
+
+    const check = getFakeIPCheck();
+    expect(check.state).toBe('warning');
+    expect(check.items[1]).toEqual({
+      state: 'warning',
+      key: 'Browser uses another DNS (normal over remote access or with Secure DNS enabled)',
+      value: '',
+    });
+  });
+
+  it('does not report a routing failure when the comparison IP probe is unavailable', async () => {
+    mockRouterFakeIP(true);
+    mockBrowserFakeIP(true);
+    remoteFakeIPMethods.getIpCheck.mockResolvedValue({
+      success: false,
+      message: 'request timed out with private details',
+    });
+
+    await runFakeIPCheck();
+
+    const check = getFakeIPCheck();
+    expect(check.state).toBe('warning');
+    expect(check.items[2]).toEqual({
+      state: 'warning',
+      key: 'Proxy routing probe is unavailable',
+      value: '',
+    });
+    expect(JSON.stringify(check)).not.toContain('private details');
+  });
+
+  it('does not claim DNS bypass when the router response is invalid', async () => {
+    podkopShellMethods.checkFakeIP.mockResolvedValue({
+      success: true,
+      data: null,
+    });
+    mockBrowserFakeIP(true);
+    mockBrowserIP();
+
+    await expect(runFakeIPCheck()).resolves.toBeUndefined();
+
+    expect(getFakeIPCheck().items[0]).toEqual({
+      state: 'warning',
+      key: 'Router FakeIP probe is unavailable',
+      value: '',
+    });
+  });
+
+  it('distinguishes a valid empty router DNS result from an unavailable probe', async () => {
+    podkopShellMethods.checkFakeIP.mockResolvedValue({
+      success: true,
+      data: {
+        fakeip: false,
+        IP: '',
+        dnsAvailable: false,
+        dnsAddress: '',
+      },
+    });
+    mockBrowserFakeIP(true);
+    mockBrowserIP();
+
+    await runFakeIPCheck();
+
+    expect(getFakeIPCheck().items[0]).toEqual({
+      state: 'warning',
+      key: 'Router DNS did not return an answer',
+      value: '',
+    });
+  });
+});
