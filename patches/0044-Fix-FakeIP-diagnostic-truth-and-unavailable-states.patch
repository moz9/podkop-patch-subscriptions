 import { updateCheckStore } from './updateCheckStore';
 import { getMeta } from '../helpers/getMeta';

+function hasFakeIPStatus(value: unknown): value is { fakeip: boolean } {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    typeof (value as { fakeip?: unknown }).fakeip === 'boolean'
+  );
+}
+
+function getComparableIP(value: unknown): string {
+  if (typeof value !== 'object' || value === null) return '';
+  const IP = (value as { IP?: unknown }).IP;
+  return typeof IP === 'string' ? IP.trim() : '';
+}
+
+function getDnsAvailability(value: unknown): boolean | undefined {
+  if (typeof value !== 'object' || value === null) return undefined;
+  const dnsAvailable = (value as { dnsAvailable?: unknown }).dnsAvailable;
+  return typeof dnsAvailable === 'boolean' ? dnsAvailable : undefined;
+}
+
 export async function runFakeIPCheck() {
   const { order, title, code } = DIAGNOSTICS_CHECKS_MAP.FAKEIP;

