+google_play_transport_endpoints() {
+    cat <<'EOF'
+https://dl.google.com/dl/android/maven2/master-index.xml
+https://redirector.gvt1.com/edgedl/android/studio/metadata/distributions.json
+EOF
+}
+
+transport_status_is_expected() {
+    local actual="$1"
+    local expected_statuses="$2"
+    local expected
+
+    for expected in $expected_statuses; do
+        [ "$actual" != "$expected" ] || return 0
+    done
+    return 1
+}
+
+run_https_transport_canary() {
+    local url="$1"
+    local expected_statuses="$2"
+    local output attempt bytes http_status
+
+    output="$(mktemp)"
+    attempt=1
+    while [ "$attempt" -le 2 ]; do
+        : > "$output"
+        if http_status="$(run_with_timeout 15 curl -sSL \
+            --connect-timeout 5 --max-time 12 --range 0-4095 \
+            --write-out '%{http_code}' -o "$output" "$url" 2> /dev/null)"; then
+            bytes="$(wc -c < "$output" | tr -d ' ')"
+            case "$bytes" in
+                ''|*[!0-9]*) bytes=0 ;;
+            esac
+            if [ "$bytes" -ge 64 ] && transport_status_is_expected "$http_status" "$expected_statuses"; then
+                rm -f "$output"
+                return 0
+            fi
+        fi
+        [ "$attempt" -ge 2 ] || sleep 1
+        attempt=$((attempt + 1))
+    done
+    rm -f "$output"
+    return 1
+}
+
+run_google_play_transport_canary() {
+    run_https_transport_canary "$1" "200 206"
+}
+
+validate_google_play_transport() {
+    local endpoint
+
+    command -v curl > /dev/null 2>&1 || return 1
+    while IFS= read -r endpoint; do
+        [ -n "$endpoint" ] || continue
+        run_google_play_transport_canary "$endpoint" || return 1
+    done <<EOF
+$(google_play_transport_endpoints)
+EOF
+}
+
+chatgpt_transport_endpoints() {
+    cat <<'EOF'
+https://chatgpt.com/.well-known/http-message-signatures-directory|200 206|required
+https://api.openai.com/v1/models|401|advisory
+EOF
+}
+
+validate_chatgpt_transport() {
+    local endpoint expected_statuses policy
+
+    command -v curl > /dev/null 2>&1 || return 1
+    while IFS='|' read -r endpoint expected_statuses policy; do
+        [ -n "$endpoint" ] || continue
+        if ! run_https_transport_canary "$endpoint" "$expected_statuses"; then
+            [ "$policy" != "required" ] || return 1
+        fi
+    done <<EOF
+$(chatgpt_transport_endpoints)
+EOF
+}
+
