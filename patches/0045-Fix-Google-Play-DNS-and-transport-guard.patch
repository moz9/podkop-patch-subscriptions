             '{success:true,slot:$slot,protocol:$protocol,successes:$successes,total:$total}'
         return 0
     fi
-    jq -cn --arg slot "$slot" --arg protocol "$protocol" --argjson successes "$successes" --argjson total "$total" \
-        '{success:false,slot:$slot,protocol:$protocol,successes:$successes,total:$total,error:"dns_unavailable"}'
+    error="dns_unavailable"
