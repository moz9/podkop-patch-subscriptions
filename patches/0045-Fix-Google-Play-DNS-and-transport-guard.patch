+dns_answer_ipv4_is_usable() {
+    local resolver="$1"
+    local address="$2"
+    local old_ifs first second third
+
+    is_ipv4 "$address" || return 1
+    old_ifs="$IFS"
+    IFS='.'
+    set -- $address
+    IFS="$old_ifs"
+    first="$1"
+    second="$2"
+    third="$3"
+
+    # FakeIP is intentionally non-public, but only Podkop's local resolvers may return it.
+    if [ "$resolver" = "127.0.0.1" ] || [ "$resolver" = "127.0.0.42" ]; then
+        if [ "$first" -eq 198 ] && { [ "$second" -eq 18 ] || [ "$second" -eq 19 ]; }; then
+            return 0
+        fi
+    fi
+
+    case "$first" in
+        0|10|127) return 1 ;;
+    esac
+    if [ "$first" -eq 100 ] && [ "$second" -ge 64 ] && [ "$second" -le 127 ]; then
+        return 1
+    fi
+    if [ "$first" -eq 169 ] && [ "$second" -eq 254 ]; then
+        return 1
+    fi
+    if [ "$first" -eq 172 ] && [ "$second" -ge 16 ] && [ "$second" -le 31 ]; then
+        return 1
+    fi
+    if [ "$first" -eq 192 ]; then
+        case "$second.$third" in
+            0.0|0.2|88.99|168.*) return 1 ;;
+        esac
+    fi
+    if [ "$first" -eq 198 ]; then
+        case "$second.$third" in
+            18.*|19.*|51.100) return 1 ;;
+        esac
+    fi
+    if [ "$first" -eq 203 ] && [ "$second" -eq 0 ] && [ "$third" -eq 113 ]; then
+        return 1
+    fi
+    [ "$first" -lt 224 ] || return 1
+    return 0
+}
+
+dns_output_has_usable_a() {
+    local resolver="$1"
+    local addresses address
+
+    addresses="$(awk '
+        $0 !~ /^;/ && $(NF - 1) == "A" && $NF ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print $NF }
+    ')"
+    [ -n "$addresses" ] || return 1
+    for address in $addresses; do
+        dns_answer_ipv4_is_usable "$resolver" "$address" && return 0
+    done
+    return 1
+}
+
